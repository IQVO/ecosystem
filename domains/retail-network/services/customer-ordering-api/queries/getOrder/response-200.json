{
  "type": "object",
  "description": "The customer order without the ship-to address.",
  "required": [
    "orderId",
    "shopperId",
    "status",
    "destinationPostalPrefix",
    "placedAt",
    "lines",
    "groups"
  ],
  "properties": {
    "orderId": {
      "type": "string"
    },
    "shopperId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Derived from the group states over the groups that are not CANCELLED (ADR 0002 A1, A23). LOST and RETURNED are terminal: every such group is LOST or RETURNED (LOST when any is lost) and none was delivered; a mix of delivered and lost or returned groups, all closed, is PARTIALLY_DELIVERED.",
      "enum": [
        "PLACED",
        "IN_FULFILLMENT",
        "PARTIALLY_SHIPPED",
        "SHIPPED",
        "PARTIALLY_DELIVERED",
        "DELIVERED",
        "LOST",
        "RETURNED",
        "CANCELLED"
      ]
    },
    "destinationPostalPrefix": {
      "type": "string"
    },
    "placedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time",
      "description": "Present once the order is CANCELLED."
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lineNo",
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "catalogItemId": {
            "type": "string",
            "maxLength": 64
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "groupNo",
          "promiseId",
          "tier",
          "shipBy",
          "deliverByEarliest",
          "deliverByLatest",
          "lineNos",
          "status"
        ],
        "properties": {
          "groupNo": {
            "type": "integer"
          },
          "promiseId": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "SAME_DAY",
              "NEXT_DAY",
              "TWO_DAY",
              "STANDARD"
            ]
          },
          "shipBy": {
            "type": "string",
            "format": "date-time"
          },
          "deliverByEarliest": {
            "type": "string",
            "format": "date-time"
          },
          "deliverByLatest": {
            "type": "string",
            "format": "date-time"
          },
          "lineNos": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "status": {
            "type": "string",
            "description": "PROMISED (no node locked), LOCKED (FulfillmentLocked), SHIPPED (FulfillmentShipped), DELIVERED (every package delivered), CANCELLATION_REQUESTED (CustomerOrderCancelled published, order-sourcing has not answered), CANCELLED (FulfillmentCancelled or an unkeepable promise), LOST (PackageLost for a package of the group) and RETURNED (PackageReturned), both terminal.",
            "enum": [
              "PROMISED",
              "LOCKED",
              "SHIPPED",
              "DELIVERED",
              "LOST",
              "RETURNED",
              "CANCELLATION_REQUESTED",
              "CANCELLED"
            ]
          },
          "revisionNo": {
            "type": "integer",
            "description": "Latest applied PromiseRevised revision; absent until the first revision."
          },
          "cancelReason": {
            "type": "string",
            "description": "The free-text reason of the cancellation request, or the reason a policy cancelled the group."
          },
          "cancelRequestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelRefusedReason": {
            "type": "string",
            "description": "order-sourcing refused the cancellation (FulfillmentCancelRefused); the vendor ships and the shopper path is a return."
          }
        }
      }
    }
  },
  "isSchema": true
}