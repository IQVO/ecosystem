{
  "type": "object",
  "required": [
    "from",
    "to",
    "days",
    "freshness"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date"
    },
    "to": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "day",
          "orders_placed",
          "orders_cancelled",
          "consolidated_tier_orders",
          "pickup_point_orders",
          "split_shipment_orders",
          "split_shipment_share",
          "shopper_notices_decided",
          "shopper_notices_by_kind",
          "shopper_notices_other"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "orders_placed": {
            "type": "integer",
            "minimum": 0
          },
          "orders_cancelled": {
            "type": "integer",
            "minimum": 0,
            "description": "Distinct orders with a cancellation request that day (a request, not a final cancellation)."
          },
          "consolidated_tier_orders": {
            "type": "integer",
            "minimum": 0
          },
          "pickup_point_orders": {
            "type": "integer",
            "minimum": 0
          },
          "split_shipment_orders": {
            "type": "integer",
            "minimum": 0
          },
          "split_shipment_share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "nullable": true,
            "description": "split_shipment_orders / orders_placed; null when no order was placed that day."
          },
          "shopper_notices_decided": {
            "type": "integer",
            "minimum": 0
          },
          "shopper_notices_by_kind": {
            "type": "array",
            "maxItems": 5,
            "description": "At most 5 notice families, most frequent first, ties by family.",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "count"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "description": "A notice family code of ADR 0017 (DELAY_EXPECTED, ETA_WINDOW_ASSIGNED, DELIVERY_POINT_ADVISORY, GROUP_SHIPPED, GROUP_DELIVERED, GROUP_LOST, GROUP_RETURNED) or UNRECOGNISED."
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "shopper_notices_other": {
            "type": "integer",
            "minimum": 0,
            "description": "Notices of the families not listed in shopper_notices_by_kind."
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "required": [
        "as_of",
        "lag_seconds"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "lag_seconds": {
          "type": "number",
          "minimum": 0,
          "nullable": true
        }
      }
    }
  },
  "isSchema": true
}