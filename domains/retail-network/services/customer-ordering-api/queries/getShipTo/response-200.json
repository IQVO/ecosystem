        },
        "phone": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    {
      "type": "object",
      "description": "The destination of a pickup order, as GET /orders/{orderId}/ship-to answers it (ADR 0016): the kind and the point, and NO address fields - the restricted route carries no PII at all for these orders. An absent destinationKind (the ShipTo shape) means SHIP_TO, the destination of every order placed before pickup points existed.",
      "required": [
        "destinationKind",
        "pickupPointId"
      ],
      "properties": {
        "destinationKind": {
          "type": "string",
          "enum": [
            "PICKUP_POINT"
          ]
        },
        "pickupPointId": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  ],
  "isSchema": true
