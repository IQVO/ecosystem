{
  "type": "object",
  "required": [
    "shopperId",
    "email",
    "status",
    "registeredAt",
    "savedAddresses"
  ],
  "properties": {
    "shopperId": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE"
      ]
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time"
    },
    "savedAddresses": {
      "type": "array",
      "maxItems": 20,
      "description": "The shopper's saved addresses, oldest first; possibly empty.",
      "items": {
        "type": "object",
        "description": "A saved address: the ShipTo the shopper sent plus the addressId the service minted (derived from the add's Idempotency-Key). Synthetic PII, returned only on the shopper routes.",
        "required": [
          "addressId",
          "name",
          "line1",
          "city",
          "region",
          "postalCode",
          "countryCode"
        ],
        "properties": {
          "addressId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "line1": {
            "type": "string",
            "maxLength": 100
          },
          "line2": {
            "type": "string",
            "maxLength": 100
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "region": {
            "type": "string",
            "maxLength": 100
          },
          "postalCode": {
            "type": "string",
            "maxLength": 20
          },
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "phone": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    }
  },
  "isSchema": true
}