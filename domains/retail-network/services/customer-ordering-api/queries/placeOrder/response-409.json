{
  "allOf": [
    {
      "type": "object",
      "description": "RFC 9457 problem details. type is /problems/<slug>.",
      "required": [
        "type",
        "title",
        "status"
      ],
      "properties": {
        "type": {
          "type": "string",
          "format": "uri-reference",
          "example": "/problems/cancel-after-lock"
        },
        "title": {
          "type": "string",
          "example": "Cancellation after lock"
        },
        "status": {
          "type": "integer",
          "example": 409
        },
        "detail": {
          "type": "string",
          "example": "Every shipment group is locked to a node; cancellation is now a return."
        },
        "instance": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "requotedOffers": {
          "type": "array",
          "description": "Present for offer-not-quotable; the new offers to show before placing (CheckoutPromising). One per feasible tier of each failed group.",
          "items": {
            "type": "object",
            "required": [
              "groupNo",
              "offerId",
              "tier",
              "deliverByEarliest",
              "deliverByLatest",
              "expiresAt"
            ],
            "properties": {
              "groupNo": {
                "type": "integer",
                "minimum": 1
              },
              "offerId": {
                "type": "string"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "SAME_DAY",
                  "NEXT_DAY",
                  "TWO_DAY",
                  "STANDARD"
                ]
              },
              "deliverByEarliest": {
                "type": "string",
                "format": "date-time"
              },
              "deliverByLatest": {
                "type": "string",
                "format": "date-time"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ],
  "isSchema": true
}