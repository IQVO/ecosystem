{
  "type": "object",
  "required": [
    "authorizationId",
    "orderId",
    "groupNo",
    "reason",
    "disposition",
    "method",
    "state",
    "lines",
    "trackingNumbers",
    "authorizedAt",
    "expiresAt",
    "version",
    "pricesAbsent"
  ],
  "properties": {
    "authorizationId": {
      "type": "string",
      "example": "ret-0f3a91e2"
    },
    "orderId": {
      "type": "string",
      "example": "ord-51a0c9"
    },
    "groupNo": {
      "type": "integer",
      "example": 2
    },
    "reason": {
      "type": "string",
      "enum": [
        "DEFECTIVE",
        "NOT_AS_DESCRIBED",
        "WRONG_ITEM",
        "NOT_NEEDED",
        "OTHER"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "KEEP",
        "NEAREST_RETURNS_CENTER",
        "ORIGIN_NODE"
      ],
      "description": "Decided by this context at authorization; the caller never chooses it."
    },
    "method": {
      "type": "string",
      "enum": [
        "DROP_OFF",
        "PICKUP"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "AUTHORIZED",
        "IN_TRANSIT",
        "RECEIVED",
        "CLOSED_KEEP",
        "CANCELLED",
        "PICKUP_FAILED"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lineNo",
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "example": 1
          },
          "catalogItemId": {
            "type": "string",
            "example": "sku-100"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "The quantity placed on that order line (eaches).",
            "example": 2
          },
          "unitPriceCents": {
            "type": "integer",
            "description": "Optional; the caller-declared price, echoed back. Never published on any event.",
            "example": 20000
          },
          "ownerRef": {
            "type": "string",
            "description": "Optional; whose stock the line took (the sourcing release's ownerRef), when known.",
            "example": "sel-42"
          }
        }
      }
    },
    "destinationNodeId": {
      "type": "string",
      "description": "Optional; omitted for KEEP (no destination) and when no node is known.",
      "example": "node-rc-1"
    },
    "originNodeId": {
      "type": "string",
      "description": "Optional; the node that fulfilled the group, when a sourcing fact named it.",
      "example": "node-fc-1"
    },
    "pickupWindowStart": {
      "type": "string",
      "format": "date-time",
      "description": "Optional; present only for PICKUP."
    },
    "pickupWindowEnd": {
      "type": "string",
      "format": "date-time",
      "description": "Optional; present only for PICKUP."
    },
    "trackingNumbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The linked reverse-label tracking numbers, in issue order; at most five.",
      "example": [
        "trk-rev-9"
      ]
    },
    "authorizedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "authorizedAt + 30 days."
    },
    "closedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Optional; set by every terminal state."
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "description": "The aggregate version after the last change."
    },
    "pricesAbsent": {
      "type": "boolean",
      "description": "True when at least one line had no unit price, so KEEP could never be chosen."
    }
  },
  "isSchema": true
}