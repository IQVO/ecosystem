{
  "type": "object",
  "required": [
    "from",
    "to",
    "days",
    "reasonPareto",
    "freshness"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date"
    },
    "to": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "day",
          "returnsAuthorized",
          "returnsReceived",
          "timeToReceiveSamples",
          "timeToReceiveP50Seconds",
          "timeToReceiveP95Seconds"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "returnsAuthorized": {
            "type": "integer",
            "minimum": 0,
            "description": "Authorizations whose authorizedAt falls on the day (both \"opened\" and \"approved\")."
          },
          "returnsReceived": {
            "type": "integer",
            "minimum": 0,
            "description": "Receipts (ReturnCompleted) whose receivedAt falls on the day."
          },
          "timeToReceiveSamples": {
            "type": "integer",
            "minimum": 0,
            "description": "The day's receipts whose authorization is also projected; the population of the two percentiles."
          },
          "timeToReceiveP50Seconds": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "description": "Continuous p50 of receivedAt - authorizedAt in seconds; null without a sample."
          },
          "timeToReceiveP95Seconds": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "description": "Continuous p95 of receivedAt - authorizedAt in seconds; null without a sample."
          }
        }
      }
    },
    "reasonPareto": {
      "type": "array",
      "maxItems": 5,
      "description": "The range's authorizations grouped by reason code, most frequent first (ties by reason), at most 5 entries.",
      "items": {
        "type": "object",
        "required": [
          "reason",
          "returns",
          "share",
          "cumulativeShare"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "description": "The enum reason code of the authorization (never free text)."
          },
          "returns": {
            "type": "integer",
            "minimum": 1
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "returns over ALL authorizations of the range."
          },
          "cumulativeShare": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The running sum of the shares in Pareto order."
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "required": [
        "asOf",
        "lagSeconds"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "lagSeconds": {
          "type": "number",
          "minimum": 0,
          "nullable": true
        }
      }
    }
  },
  "isSchema": true
}