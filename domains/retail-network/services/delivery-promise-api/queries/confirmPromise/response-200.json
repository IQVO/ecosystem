{
  "type": "object",
  "required": [
    "promiseId",
    "offerId",
    "state",
    "destinationPostalPrefix",
    "lines",
    "terms",
    "witnessPath",
    "holdExpiresAt",
    "revisions",
    "version"
  ],
  "properties": {
    "promiseId": {
      "type": "string"
    },
    "offerId": {
      "type": "string"
    },
    "orderId": {
      "type": "string",
      "description": "Set when the order is placed (CONFIRMED)."
    },
    "groupNo": {
      "type": "integer",
      "minimum": 1,
      "description": "Set when the order is placed (CONFIRMED)."
    },
    "state": {
      "type": "string",
      "enum": [
        "PROVISIONAL",
        "CONFIRMED",
        "AT_RISK",
        "KEPT",
        "BROKEN",
        "RELEASED",
        "CANCELLED"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A line of a delivery offer or a promise, with the owner whose stock at the witness node covers it (ADR 0017). One owner covers the whole line; the units of several owners never add up.",
        "required": [
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "Unique within the group."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "ownerRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "description": "The seller (sellerId) whose listing covers the line, chosen by the OwnerChoice rule. Optional and additive; omitted when the line is operator-owned."
          }
        }
      }
    },
    "terms": {
      "type": "object",
      "required": [
        "tier",
        "shipBy",
        "deliverByEarliest",
        "deliverByLatest",
        "basis",
        "policyVersion"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "description": "Service tier (promise.Tier).",
          "enum": [
            "SAME_DAY",
            "NEXT_DAY",
            "TWO_DAY",
            "STANDARD"
          ]
        },
        "shipBy": {
          "type": "string",
          "format": "date-time",
          "description": "Pickup cutoff at the witness node."
        },
        "deliverByEarliest": {
          "type": "string",
          "format": "date-time"
        },
        "deliverByLatest": {
          "type": "string",
          "format": "date-time"
        },
        "timeZone": {
          "type": "string",
          "maxLength": 64,
          "example": "America/Chicago",
          "description": "IANA time zone of the delivery station serving the destination, the local calendar deliverByEarliest and deliverByLatest belong to. Always set on a new promise; omitted only for a promise stored before it was carried (ADR 0011), in which case read the window in UTC."
        },
        "basis": {
          "type": "string",
          "description": "Promise basis: SCHEDULED from the timetable, MEASURED when a leg's measured transit pushed the arrival later (ADR 0014), NOMINAL from lane times (STANDARD only).",
          "enum": [
            "SCHEDULED",
            "MEASURED",
            "NOMINAL"
          ]
        },
        "policyVersion": {
          "type": "string"
        }
      }
    },
    "witnessPath": {
      "type": "object",
      "description": "The node, pickup departure, departure legs and delivery wave that prove feasibility. A NOMINAL path (STANDARD only) carries no departure or wave ids: pickupDepartureId and deliveryWaveId are omitted and legs is empty (E8).",
      "required": [
        "nodeId",
        "legs"
      ],
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "pickupDepartureId": {
          "type": "string"
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "departureId"
          }
        },
        "deliveryWaveId": {
          "type": "string"
        }
      }
    },
    "holdExpiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "revisionNo",
          "previousTerms",
          "reason",
          "revisedAt"
        ],
        "properties": {
          "revisionNo": {
            "type": "integer",
            "minimum": 1
          },
          "previousTerms": "[Circular]",
          "reason": {
            "type": "string"
          },
          "revisedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "judgement": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "KEPT",
            "BROKEN"
          ]
        },
        "deliveredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Present when the package was delivered; omitted for cause LOST or RETURNED."
        },
        "lateByMinutes": {
          "type": "integer",
          "description": "Present when BROKEN."
        },
        "cause": {
          "type": "string",
          "enum": [
            "LATE",
            "LOST",
            "RETURNED"
          ],
          "description": "Present when BROKEN."
        }
      }
    },
    "destinationPostalPrefix": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Optimistic-concurrency version of the aggregate."
    },
    "cancelReason": {
      "type": "string",
      "description": "Present when CANCELLED."
    },
    "releaseReason": {
      "type": "string",
      "description": "Present when RELEASED."
    },
    "atRiskReason": {
      "type": "string",
      "description": "Present while AT_RISK. One of NODE_UNSOURCEABLE, PACKAGE_EXCEPTION, INDUCTION_DEFERRED, DEPARTURE_CANCELLED, WAVE_CANCELLED, BOOKING_FAILED, BOOKING_MOVED or PREDICTED_LATE (a departure of the witness path is past its expected arrival with no arrival seen). A PREDICTED_LATE promise stays AT_RISK until it is judged, even if the load arrives later."
    }
  },
  "isSchema": true
}