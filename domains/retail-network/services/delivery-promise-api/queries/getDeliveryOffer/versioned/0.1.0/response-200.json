{
  "type": "object",
  "required": [
    "offerId",
    "state",
    "groupNo",
    "destinationPostalPrefix",
    "tier",
    "lines",
    "window",
    "witnessPath",
    "basis",
    "policyVersion",
    "quotedAt",
    "expiresAt"
  ],
  "properties": {
    "offerId": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "QUOTED",
        "EXPIRED",
        "CONSUMED"
      ]
    },
    "destinationPostalPrefix": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "description": "Service tier (promise.Tier).",
      "enum": [
        "SAME_DAY",
        "NEXT_DAY",
        "TWO_DAY",
        "STANDARD"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "window": {
      "type": "object",
      "required": [
        "earliest",
        "latest"
      ],
      "properties": {
        "earliest": {
          "type": "string",
          "format": "date-time"
        },
        "latest": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "witnessPath": {
      "type": "object",
      "description": "The node, pickup departure, departure legs and delivery wave that prove feasibility. A NOMINAL path (STANDARD only) carries no departure or wave ids: pickupDepartureId and deliveryWaveId are omitted and legs is empty (E8).",
      "required": [
        "nodeId",
        "legs"
      ],
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "pickupDepartureId": {
          "type": "string"
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "departureId"
          }
        },
        "deliveryWaveId": {
          "type": "string"
        }
      }
    },
    "quotedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "min(quotedAt + offerTtl, the latest instant the witness pickup cutoff can still be met)."
    },
    "groupNo": {
      "type": "integer",
      "minimum": 1,
      "description": "Quote-relative shipment group number (1 for a single-node cart)."
    },
    "basis": {
      "type": "string",
      "description": "Promise basis; NOMINAL only for STANDARD.",
      "enum": [
        "SCHEDULED",
        "NOMINAL"
      ]
    },
    "policyVersion": {
      "type": "string",
      "description": "The promise policy version the quote used (G8)."
    }
  },
  "isSchema": true
}