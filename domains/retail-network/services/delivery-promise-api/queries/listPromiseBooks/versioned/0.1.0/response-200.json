{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bookId",
          "nodeId",
          "pickupDepartureId",
          "cutoffAt",
          "state",
          "capacity",
          "version"
        ],
        "properties": {
          "bookId": {
            "type": "string",
            "description": "nodeId + ':' + pickupDepartureId"
          },
          "nodeId": {
            "type": "string"
          },
          "pickupDepartureId": {
            "type": "string"
          },
          "cutoffAt": {
            "type": "string",
            "format": "date-time",
            "description": "The pickup departure's cutoff (from DepartureView)."
          },
          "state": {
            "type": "string",
            "enum": [
              "OPEN",
              "CLOSED"
            ]
          },
          "capacity": {
            "type": "object",
            "required": [
              "share",
              "provisional",
              "confirmed"
            ],
            "properties": {
              "share": {
                "type": "integer",
                "minimum": 0,
                "description": "Orders the promise side may hold on this cutoff (G9)."
              },
              "provisional": {
                "type": "integer",
                "minimum": 0
              },
              "confirmed": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "isSchema": true
}