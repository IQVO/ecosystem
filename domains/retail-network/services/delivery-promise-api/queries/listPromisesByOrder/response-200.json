{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "promiseId",
          "offerId",
          "state",
          "destinationPostalPrefix",
          "lines",
          "terms",
          "witnessPath",
          "holdExpiresAt",
          "revisions",
          "version"
        ],
        "properties": {
          "promiseId": {
            "type": "string"
          },
          "offerId": {
            "type": "string"
          },
          "orderId": {
            "type": "string",
            "description": "Set when the order is placed (CONFIRMED)."
          },
          "groupNo": {
            "type": "integer",
            "minimum": 1,
            "description": "Set when the order is placed (CONFIRMED)."
          },
          "state": {
            "type": "string",
            "enum": [
              "PROVISIONAL",
              "CONFIRMED",
              "AT_RISK",
              "KEPT",
              "BROKEN",
              "RELEASED",
              "CANCELLED"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "catalogItemId",
                "quantity"
              ],
              "properties": {
                "catalogItemId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "terms": {
            "type": "object",
            "required": [
              "tier",
              "shipBy",
              "deliverByEarliest",
              "deliverByLatest",
              "basis",
              "policyVersion"
            ],
            "properties": {
              "tier": {
                "type": "string",
                "description": "Service tier (promise.Tier).",
                "enum": [
                  "SAME_DAY",
                  "NEXT_DAY",
                  "TWO_DAY",
                  "STANDARD"
                ]
              },
              "shipBy": {
                "type": "string",
                "format": "date-time",
                "description": "Pickup cutoff at the witness node."
              },
              "deliverByEarliest": {
                "type": "string",
                "format": "date-time"
              },
              "deliverByLatest": {
                "type": "string",
                "format": "date-time"
              },
              "timeZone": {
                "type": "string",
                "maxLength": 64,
                "example": "America/Chicago",
                "description": "IANA time zone of the delivery station serving the destination, the local calendar deliverByEarliest and deliverByLatest belong to. Always set on a new promise; omitted only for a promise stored before it was carried (ADR 0011), in which case read the window in UTC."
              },
              "basis": {
                "type": "string",
                "description": "Promise basis; NOMINAL only for STANDARD.",
                "enum": [
                  "SCHEDULED",
                  "NOMINAL"
                ]
              },
              "policyVersion": {
                "type": "string"
              }
            }
          },
          "witnessPath": {
            "type": "object",
            "description": "The node, pickup departure, departure legs and delivery wave that prove feasibility. A NOMINAL path (STANDARD only) carries no departure or wave ids: pickupDepartureId and deliveryWaveId are omitted and legs is empty (E8).",
            "required": [
              "nodeId",
              "legs"
            ],
            "properties": {
              "nodeId": {
                "type": "string"
              },
              "pickupDepartureId": {
                "type": "string"
              },
              "legs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "departureId"
                }
              },
              "deliveryWaveId": {
                "type": "string"
              }
            }
          },
          "holdExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "revisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "revisionNo",
                "previousTerms",
                "reason",
                "revisedAt"
              ],
              "properties": {
                "revisionNo": {
                  "type": "integer",
                  "minimum": 1
                },
                "previousTerms": "[Circular]",
                "reason": {
                  "type": "string"
                },
                "revisedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "judgement": {
            "type": "object",
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "KEPT",
                  "BROKEN"
                ]
              },
              "deliveredAt": {
                "type": "string",
                "format": "date-time",
                "description": "Present when the package was delivered; omitted for cause LOST or RETURNED."
              },
              "lateByMinutes": {
                "type": "integer",
                "description": "Present when BROKEN."
              },
              "cause": {
                "type": "string",
                "enum": [
                  "LATE",
                  "LOST",
                  "RETURNED"
                ],
                "description": "Present when BROKEN."
              }
            }
          },
          "destinationPostalPrefix": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Optimistic-concurrency version of the aggregate."
          },
          "cancelReason": {
            "type": "string",
            "description": "Present when CANCELLED."
          },
          "releaseReason": {
            "type": "string",
            "description": "Present when RELEASED."
          },
          "atRiskReason": {
            "type": "string",
            "description": "Present while AT_RISK."
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor of the next page; absent on the last page."
    }
  },
  "isSchema": true
}