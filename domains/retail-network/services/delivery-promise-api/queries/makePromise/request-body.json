{
  "type": "object",
  "required": [
    "offerId",
    "lines"
  ],
  "properties": {
    "offerId": {
      "type": "string",
      "description": "The offer the shopper saw."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "description": "The shipment group's lines; all shippable from the offer's witness node. They must equal the offer's lines.",
      "items": {
        "type": "object",
        "required": [
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}