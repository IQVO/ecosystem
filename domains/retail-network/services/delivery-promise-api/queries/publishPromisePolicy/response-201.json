{
  "type": "object",
  "required": [
    "policyVersion",
    "version",
    "offerTtlMinutes",
    "holdTtlMinutes",
    "packagesPerOrder",
    "capacitySharePercent",
    "transitWindowDays",
    "transitServiceLevelPercent",
    "minTransitObservations",
    "orderDeadlines",
    "publishedAt"
  ],
  "properties": {
    "policyVersion": {
      "type": "string",
      "description": "'v' + version.",
      "example": "v3"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "offerTtlMinutes": {
      "type": "integer"
    },
    "holdTtlMinutes": {
      "type": "integer"
    },
    "packagesPerOrder": {
      "type": "integer"
    },
    "capacitySharePercent": {
      "type": "integer"
    },
    "transitWindowDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "description": "Days of observed load transits the measured-transit read model keeps (ADR 0014)."
    },
    "transitServiceLevelPercent": {
      "type": "integer",
      "minimum": 50,
      "maximum": 99,
      "description": "Service-level percentile quoted against a lane's measured transit (ADR 0014)."
    },
    "minTransitObservations": {
      "type": "integer",
      "minimum": 5,
      "maximum": 1000,
      "description": "Observations a lane needs inside the window before its measured transit can push a promise later than the timetable (ADR 0014)."
    },
    "orderDeadlines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tier",
          "localTime"
        ],
        "properties": {
          "tier": {
            "type": "string",
            "description": "Service tier (promise.Tier).",
            "enum": [
              "SAME_DAY",
              "NEXT_DAY",
              "TWO_DAY",
              "STANDARD"
            ]
          },
          "regionId": {
            "type": "string",
            "description": "The destination region; absent means every region."
          },
          "localTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Order deadline HH:mm in the destination delivery station's time zone."
          }
        }
      }
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "isSchema": true
}