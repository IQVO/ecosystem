{
  "type": "object",
  "required": [
    "destinationPostalPrefix",
    "lines"
  ],
  "properties": {
    "destinationPostalPrefix": {
      "type": "string",
      "description": "Destination postal prefix (never a full address).",
      "example": "787"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "description": "One line on a product page, the cart's lines at checkout.",
      "items": {
        "type": "object",
        "required": [
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "tiers": {
      "type": "array",
      "description": "Tiers to quote; all four when omitted.",
      "items": {
        "type": "string",
        "description": "Service tier (promise.Tier).",
        "enum": [
          "SAME_DAY",
          "NEXT_DAY",
          "TWO_DAY",
          "STANDARD"
        ]
      }
    }
  }
}