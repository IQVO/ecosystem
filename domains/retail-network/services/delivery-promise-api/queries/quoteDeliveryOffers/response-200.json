{
  "type": "object",
  "required": [
    "offers",
    "unavailable"
  ],
  "properties": {
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "offerId",
          "state",
          "groupNo",
          "destinationPostalPrefix",
          "tier",
          "lines",
          "window",
          "witnessPath",
          "basis",
          "policyVersion",
          "quotedAt",
          "expiresAt"
        ],
        "properties": {
          "offerId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUOTED",
              "EXPIRED",
              "CONSUMED"
            ]
          },
          "destinationPostalPrefix": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "description": "Service tier (promise.Tier).",
            "enum": [
              "SAME_DAY",
              "NEXT_DAY",
              "TWO_DAY",
              "STANDARD"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "catalogItemId",
                "quantity"
              ],
              "properties": {
                "catalogItemId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "description": "Unique within the group."
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            }
          },
          "window": {
            "type": "object",
            "description": "The delivery window as two instants (RFC 3339 UTC) and the local calendar they belong to. A delivery date is a day of the destination's calendar: convert earliest and latest into timeZone before taking their date (e.g. 2026-10-31T14:00:00Z..2026-11-01T02:00:00Z in America/Chicago is the single day 2026-10-31).",
            "required": [
              "earliest",
              "latest"
            ],
            "properties": {
              "earliest": {
                "type": "string",
                "format": "date-time"
              },
              "latest": {
                "type": "string",
                "format": "date-time"
              },
              "timeZone": {
                "type": "string",
                "maxLength": 64,
                "example": "America/Chicago",
                "description": "IANA time zone of the delivery station serving the destination. Always set on a new offer; omitted only for an offer stored before it was carried (ADR 0011), in which case read the window in UTC."
              }
            }
          },
          "witnessPath": {
            "type": "object",
            "description": "The node, pickup departure, departure legs and delivery wave that prove feasibility. A NOMINAL path (STANDARD only) carries no departure or wave ids: pickupDepartureId and deliveryWaveId are omitted and legs is empty (E8).",
            "required": [
              "nodeId",
              "legs"
            ],
            "properties": {
              "nodeId": {
                "type": "string"
              },
              "pickupDepartureId": {
                "type": "string"
              },
              "legs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "departureId"
                }
              },
              "deliveryWaveId": {
                "type": "string"
              }
            }
          },
          "quotedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "min(quotedAt + offerTtl, the latest instant the witness pickup cutoff can still be met)."
          },
          "groupNo": {
            "type": "integer",
            "minimum": 1,
            "description": "Quote-relative shipment group number (1 for a single-node cart)."
          },
          "basis": {
            "type": "string",
            "description": "Promise basis; NOMINAL only for STANDARD.",
            "enum": [
              "SCHEDULED",
              "NOMINAL"
            ]
          },
          "policyVersion": {
            "type": "string",
            "description": "The promise policy version the quote used (G8)."
          }
        }
      },
      "description": "One offer per (group, tier) with a feasible path, ordered by groupNo then tier."
    },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tier",
          "constraint"
        ],
        "properties": {
          "tier": "[Circular]",
          "constraint": {
            "type": "string",
            "description": "Why a tier has no offer. PAST_ORDER_DEADLINE: the tier's order deadline in the destination region has passed (G19).",
            "enum": [
              "DESTINATION_NOT_SERVED",
              "ITEM_QUANTITY_NOT_AVAILABLE",
              "DELIVERY_SLA_UNAVAILABLE",
              "NODE_CAPACITY_EXHAUSTED",
              "PAST_ORDER_DEADLINE"
            ]
          },
          "groupNo": {
            "type": "integer",
            "minimum": 1,
            "description": "The quote-relative shipment group the constraint applies to; omitted when it applies to the whole quote (DESTINATION_NOT_SERVED, ITEM_QUANTITY_NOT_AVAILABLE)."
          }
        }
      }
    }
  },
  "isSchema": true
}