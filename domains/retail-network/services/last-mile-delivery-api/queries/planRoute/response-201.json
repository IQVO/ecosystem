{
  "type": "object",
  "required": [
    "routeId",
    "waveId",
    "dspId",
    "stationNodeId",
    "state",
    "stopCount",
    "stops",
    "attempts"
  ],
  "properties": {
    "routeId": {
      "type": "string"
    },
    "waveId": {
      "type": "string"
    },
    "dspId": {
      "type": "string"
    },
    "stationNodeId": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "PLANNED",
        "OUT_FOR_DELIVERY",
        "COMPLETED"
      ]
    },
    "stopCount": {
      "type": "integer",
      "minimum": 1
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stopNo",
          "trackingNumbers"
        ],
        "properties": {
          "stopNo": {
            "type": "integer",
            "minimum": 1
          },
          "trackingNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "type": "string",
            "enum": [
              "DELIVERED",
              "FAILED"
            ],
            "description": "Derived from the per-package attempts (Gap Register G17): omitted until every package of the stop has an attempt, then DELIVERED when all were delivered, else FAILED."
          }
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "routeId",
          "trackingNumber",
          "outcome",
          "at"
        ],
        "properties": {
          "routeId": {
            "type": "string"
          },
          "trackingNumber": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "DELIVERED",
              "FAILED"
            ]
          },
          "failureReason": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "isSchema": true
}