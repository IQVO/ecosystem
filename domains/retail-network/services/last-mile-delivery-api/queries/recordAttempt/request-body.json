{
  "type": "object",
  "required": [
    "trackingNumber",
    "outcome",
    "at"
  ],
  "properties": {
    "trackingNumber": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "DELIVERED",
        "FAILED"
      ]
    },
    "failureReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Required when outcome is FAILED and forbidden when DELIVERED; free text, the model defines no vocabulary."
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}