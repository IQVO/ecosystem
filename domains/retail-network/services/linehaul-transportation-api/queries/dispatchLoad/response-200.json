{
  "type": "object",
  "required": [
    "loadId",
    "departureId",
    "departureKind",
    "originNodeId",
    "destinationNodeId",
    "capacityPackages",
    "packageCount",
    "trackingNumbers",
    "state"
  ],
  "properties": {
    "loadId": {
      "type": "string"
    },
    "departureId": {
      "type": "string"
    },
    "departureKind": {
      "type": "string",
      "enum": [
        "PICKUP",
        "LINEHAUL",
        "AIR"
      ]
    },
    "originNodeId": {
      "type": "string"
    },
    "destinationNodeId": {
      "type": "string"
    },
    "capacityPackages": {
      "type": "integer",
      "minimum": 0,
      "description": "Snapshot of the departure capacity at OpenLoad (ErrLoadOverCapacity)."
    },
    "packageCount": {
      "type": "integer",
      "minimum": 0
    },
    "trackingNumbers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED",
        "DEPARTED",
        "ARRIVED"
      ]
    },
    "departedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Present once the load departed."
    },
    "arrivedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Present once the load arrived."
    }
  },
  "isSchema": true
}