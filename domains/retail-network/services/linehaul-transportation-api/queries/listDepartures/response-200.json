{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "departureId",
          "laneId",
          "kind",
          "originNodeId",
          "destinationNodeId",
          "cutoffAt",
          "departsAt",
          "arrivesAt",
          "capacityPackages",
          "bookedPackages",
          "remainingPackages",
          "state"
        ],
        "properties": {
          "departureId": {
            "type": "string"
          },
          "laneId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PICKUP",
              "LINEHAUL",
              "AIR"
            ]
          },
          "originNodeId": {
            "type": "string"
          },
          "destinationNodeId": {
            "type": "string"
          },
          "cutoffAt": {
            "type": "string",
            "format": "date-time",
            "description": "No booking after this instant (ErrDepartureClosed)."
          },
          "departsAt": {
            "type": "string",
            "format": "date-time"
          },
          "arrivesAt": {
            "type": "string",
            "format": "date-time"
          },
          "capacityPackages": {
            "type": "integer",
            "minimum": 0
          },
          "bookedPackages": {
            "type": "integer",
            "minimum": 0,
            "description": "Never above capacityPackages (ErrDepartureFull)."
          },
          "remainingPackages": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "string",
            "enum": [
              "SCHEDULED",
              "CLOSED",
              "DEPARTED",
              "ARRIVED",
              "CANCELLED"
            ]
          },
          "cancelReason": {
            "type": "string",
            "description": "Present when the state is CANCELLED."
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time",
            "description": "Present when the state is CANCELLED."
          },
          "departedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Present once the state reached DEPARTED."
          },
          "arrivedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Present once the state reached ARRIVED."
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor of the next page; absent on the last page."
    }
  },
  "isSchema": true
}