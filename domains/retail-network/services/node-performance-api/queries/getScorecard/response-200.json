{
  "type": "object",
  "required": [
    "nodeId",
    "scorecards"
  ],
  "properties": {
    "nodeId": {
      "type": "string",
      "example": "N-0042"
    },
    "scorecards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "scorecardId",
          "nodeId",
          "window",
          "state",
          "grade",
          "metrics"
        ],
        "properties": {
          "scorecardId": {
            "type": "string",
            "description": "nodeId + ':' + window.",
            "example": "N-0042:30d"
          },
          "nodeId": {
            "type": "string",
            "example": "N-0042"
          },
          "window": {
            "type": "string",
            "description": "The rolling window, 7 or 30 days.",
            "enum": [
              "7d",
              "30d"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "PROVISIONAL",
              "GRADED"
            ]
          },
          "grade": {
            "type": "string",
            "description": "A, B, C or D; PROVISIONAL below the observation minimum.",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "PROVISIONAL"
            ]
          },
          "metrics": {
            "type": "object",
            "description": "The metrics of the window (ADR 0002, A5-A10). A metric whose denominator is empty reports its best value.",
            "required": [
              "onTimeHandoverRate",
              "lateAckRate",
              "rejectRate",
              "expiryRate",
              "promiseKeptRate",
              "feedFreshnessP95Minutes",
              "observations"
            ],
            "properties": {
              "onTimeHandoverRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Packages handed over on or before requiredShipBy, over packages handed over. Higher is better."
              },
              "lateAckRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Purchase orders acknowledged in the last 10% of their ack window or expired, over purchase orders acknowledged or expired. Lower is better."
              },
              "rejectRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Purchase orders rejected over purchase orders acknowledged or expired. Lower is better."
              },
              "expiryRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Purchase orders expired over purchase orders acknowledged or expired. Lower is better."
              },
              "promiseKeptRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Promises kept over promises kept plus promises broken by a node-attributable cause. Higher is better."
              },
              "feedFreshnessP95Minutes": {
                "type": "integer",
                "minimum": 0,
                "description": "95th percentile (nearest rank) of the whole minutes between consecutive applied inventory feeds of the node. Lower is better."
              },
              "observations": {
                "type": "integer",
                "minimum": 0,
                "description": "Observations counted in the window."
              }
            }
          },
          "computedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the last recompute ran; omitted before the first one."
          }
        }
      }
    }
  },
  "example": {
    "nodeId": "N-0042",
    "scorecards": [
      {
        "scorecardId": "N-0042:7d",
        "nodeId": "N-0042",
        "window": "7d",
        "state": "GRADED",
        "grade": "C",
        "metrics": {
          "onTimeHandoverRate": 0.93,
          "lateAckRate": 0.04,
          "rejectRate": 0.02,
          "expiryRate": 0.01,
          "promiseKeptRate": 0.92,
          "feedFreshnessP95Minutes": 55,
          "observations": 412
        },
        "computedAt": "2026-10-22T14:03:00Z"
      },
      {
        "scorecardId": "N-0042:30d",
        "nodeId": "N-0042",
        "window": "30d",
        "state": "GRADED",
        "grade": "B",
        "metrics": {
          "onTimeHandoverRate": 0.962,
          "lateAckRate": 0.021,
          "rejectRate": 0.012,
          "expiryRate": 0.004,
          "promiseKeptRate": 0.951,
          "feedFreshnessP95Minutes": 38,
          "observations": 1874
        },
        "computedAt": "2026-10-22T14:03:00Z"
      }
    ]
  },
  "isSchema": true
}