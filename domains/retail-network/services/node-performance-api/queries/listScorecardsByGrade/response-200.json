{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scorecardId",
          "nodeId",
          "window",
          "state",
          "grade",
          "metrics"
        ],
        "properties": {
          "scorecardId": {
            "type": "string",
            "description": "nodeId + ':' + window.",
            "example": "N-0042:30d"
          },
          "nodeId": {
            "type": "string",
            "example": "N-0042"
          },
          "window": {
            "type": "string",
            "description": "The rolling window, 7 or 30 days.",
            "enum": [
              "7d",
              "30d"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "PROVISIONAL",
              "GRADED"
            ]
          },
          "grade": {
            "type": "string",
            "description": "A, B, C or D; PROVISIONAL below the observation minimum.",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "PROVISIONAL"
            ]
          },
          "metrics": {
            "type": "object",
            "description": "The metrics of the window (ADR 0002, A5-A10). A metric whose denominator is empty reports its best value.",
            "required": [
              "onTimeHandoverRate",
              "lateAckRate",
              "rejectRate",
              "expiryRate",
              "promiseKeptRate",
              "feedFreshnessP95Minutes",
              "observations"
            ],
            "properties": {
              "onTimeHandoverRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Packages handed over on or before requiredShipBy, over packages handed over. Higher is better."
              },
              "lateAckRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Purchase orders acknowledged in the last 10% of their ack window or expired, over purchase orders acknowledged or expired. Lower is better."
              },
              "rejectRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Purchase orders rejected over purchase orders acknowledged or expired. Lower is better."
              },
              "expiryRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Purchase orders expired over purchase orders acknowledged or expired. Lower is better."
              },
              "promiseKeptRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Promises kept over promises kept plus promises broken by a node-attributable cause. Higher is better."
              },
              "feedFreshnessP95Minutes": {
                "type": "integer",
                "minimum": 0,
                "description": "95th percentile (nearest rank) of the whole minutes between consecutive applied inventory feeds of the node. Lower is better."
              },
              "observations": {
                "type": "integer",
                "minimum": 0,
                "description": "Observations counted in the window."
              }
            }
          },
          "computedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the last recompute ran; omitted before the first one."
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "The `after` value of the next page; omitted on the last page."
    }
  },
  "isSchema": true
}