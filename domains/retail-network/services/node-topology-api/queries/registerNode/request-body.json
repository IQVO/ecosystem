{
  "type": "object",
  "required": [
    "nodeType",
    "operator",
    "regionId",
    "timezone",
    "location"
  ],
  "properties": {
    "nodeType": {
      "type": "string",
      "enum": [
        "FULFILLMENT_CENTER",
        "INBOUND_CROSS_DOCK",
        "RETURNS_CENTER",
        "SORTATION_CENTER",
        "DELIVERY_STATION",
        "AIR_HUB"
      ]
    },
    "subtype": {
      "type": "string",
      "description": "Only for FULFILLMENT_CENTER.",
      "enum": [
        "SORTABLE",
        "NON_SORTABLE",
        "XL",
        "SOFT_LINES",
        "SUB_SAME_DAY",
        "FRESH",
        "MICRO"
      ]
    },
    "operator": {
      "type": "string",
      "enum": [
        "NETWORK",
        "VENDOR"
      ]
    },
    "vendorRef": {
      "type": "object",
      "required": [
        "vendorId",
        "vendorNodeCode"
      ],
      "properties": {
        "vendorId": {
          "type": "string"
        },
        "vendorNodeCode": {
          "type": "string",
          "description": "The vendor's own code for the node, unique per vendor."
        }
      }
    },
    "regionId": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "description": "IANA time zone.",
      "example": "America/Sao_Paulo"
    },
    "location": {
      "type": "object",
      "required": [
        "postalCode",
        "countryCode"
      ],
      "properties": {
        "postalCode": {
          "type": "string"
        },
        "countryCode": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2.",
          "example": "BR"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      }
    }
  }
}