{
  "type": "object",
  "required": [
    "listingId",
    "catalogItemId",
    "nodeId",
    "state",
    "availability"
  ],
  "properties": {
    "listingId": {
      "type": "string"
    },
    "catalogItemId": {
      "type": "string"
    },
    "nodeId": {
      "type": "string"
    },
    "ownerRef": {
      "type": "string",
      "description": "The owning seller; omitted for an operator-owned listing."
    },
    "state": {
      "type": "string",
      "enum": [
        "LIVE",
        "SUPPRESSED"
      ]
    },
    "suppressionReason": {
      "type": "string",
      "description": "NODE_NOT_SELLABLE while the node is not ACTIVE; DISCONTINUED once the item is discontinued (final).",
      "enum": [
        "NODE_NOT_SELLABLE",
        "DISCONTINUED"
      ]
    },
    "availability": {
      "type": "object",
      "required": [
        "availableQty",
        "basis"
      ],
      "properties": {
        "availableQty": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "description": "Why the node gave the number; kept as the vendor declared it, never re-derived.",
          "enum": [
            "PHYSICAL",
            "THROUGHPUT_CONSTRAINED",
            "UNKNOWN"
          ]
        },
        "asOf": {
          "type": "string",
          "format": "date-time",
          "description": "Strictly increasing per listing; omitted before the first feed."
        },
        "feedId": {
          "type": "string",
          "description": "The feed that carried the number; omitted before the first feed."
        }
      }
    }
  },
  "isSchema": true
}