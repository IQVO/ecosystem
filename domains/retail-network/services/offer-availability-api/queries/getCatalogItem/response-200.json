{
  "type": "object",
  "required": [
    "catalogItemId",
    "title",
    "lengthMm",
    "widthMm",
    "heightMm",
    "weightG",
    "hazmat",
    "fragile",
    "state"
  ],
  "properties": {
    "catalogItemId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "lengthMm": {
      "type": "integer"
    },
    "widthMm": {
      "type": "integer"
    },
    "heightMm": {
      "type": "integer"
    },
    "weightG": {
      "type": "integer"
    },
    "hazmat": {
      "type": "boolean"
    },
    "fragile": {
      "type": "boolean"
    },
    "state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DISCONTINUED"
      ]
    },
    "identifiers": {
      "type": "object",
      "description": "Optional identifiers of the item.",
      "properties": {
        "gtin": {
          "type": "string",
          "pattern": "^[0-9]{8}$|^[0-9]{12,14}$",
          "description": "GS1 GTIN (8, 12, 13 or 14 digits) with a valid mod-10 check digit; variable measure GTINs (indicator digit 9) are refused. Answered normalised to 14 digits. One GTIN identifies one item or pack level.",
          "example": "06141410000120"
        }
      }
    },
    "packaging": {
      "type": "array",
      "description": "Every pack level ever declared, lowest level first (retired ones have active false). Omitted when the item has none.",
      "items": {
        "type": "object",
        "required": [
          "level",
          "gtin",
          "unitsPerPack",
          "active"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "EACH",
              "INNER",
              "CASE",
              "PALLET"
            ]
          },
          "gtin": {
            "type": "string",
            "description": "The 14-digit GTIN of the level.",
            "example": "06141410000298"
          },
          "childGtin": {
            "type": "string",
            "example": "06141410000120"
          },
          "unitsPerPack": {
            "type": "integer",
            "description": "Eaches in one pack.",
            "example": 6
          },
          "dimsMm": {
            "type": "object",
            "required": [
              "lengthMm",
              "widthMm",
              "heightMm"
            ],
            "properties": {
              "lengthMm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "widthMm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "heightMm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          },
          "grossWeightG": {
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "isSchema": true
}