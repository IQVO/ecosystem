{
  "type": "object",
  "required": [
    "feedId",
    "nodeId",
    "fullUpdate",
    "asOf",
    "state",
    "lineCount",
    "appliedCount",
    "staleCount",
    "zeroedCount"
  ],
  "properties": {
    "feedId": {
      "type": "string"
    },
    "nodeId": {
      "type": "string"
    },
    "fullUpdate": {
      "type": "boolean"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "APPLIED",
        "FAILED",
        "SUPERSEDED"
      ]
    },
    "lineCount": {
      "type": "integer",
      "description": "Lines as received."
    },
    "appliedCount": {
      "type": "integer",
      "description": "Lines that replaced a listing's availability."
    },
    "staleCount": {
      "type": "integer",
      "description": "Lines skipped because their asOf was not after the listing's asOf."
    },
    "zeroedCount": {
      "type": "integer",
      "description": "Listings set to 0 by FullFeedZeroing."
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "appliedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the feed reached APPLIED; omitted otherwise."
    },
    "failureCode": {
      "type": "string",
      "description": "The Err identifier of a FAILED feed, for example ErrListingNotOnNode; omitted otherwise."
    }
  },
  "isSchema": true
}