{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "listingId",
          "catalogItemId",
          "nodeId",
          "state",
          "availability"
        ],
        "properties": {
          "listingId": {
            "type": "string"
          },
          "catalogItemId": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "ownerRef": {
            "type": "string",
            "description": "The owning seller; omitted for an operator-owned listing."
          },
          "state": {
            "type": "string",
            "enum": [
              "LIVE",
              "SUPPRESSED"
            ]
          },
          "suppressionReason": {
            "type": "string",
            "description": "The highest active cause, by precedence DISCONTINUED > NODE_NOT_SELLABLE > OWNER_SUSPENDED: DISCONTINUED once the item is discontinued (final); NODE_NOT_SELLABLE while the node is not ACTIVE; OWNER_SUSPENDED while the seller that owns the listing (ownerRef) is suspended (ADR 0013).",
            "enum": [
              "NODE_NOT_SELLABLE",
              "DISCONTINUED",
              "OWNER_SUSPENDED"
            ]
          },
          "availability": {
            "type": "object",
            "required": [
              "availableQty",
              "basis"
            ],
            "properties": {
              "availableQty": {
                "type": "integer",
                "minimum": 0
              },
              "basis": {
                "type": "string",
                "description": "Why the node gave the number; kept as the vendor declared it, never re-derived.",
                "enum": [
                  "PHYSICAL",
                  "THROUGHPUT_CONSTRAINED",
                  "UNKNOWN"
                ]
              },
              "asOf": {
                "type": "string",
                "format": "date-time",
                "description": "Strictly increasing per listing; omitted before the first feed."
              },
              "feedId": {
                "type": "string",
                "description": "The feed that carried the number; omitted before the first feed."
              }
            }
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Present when more listings follow; pass it as `cursor`."
    }
  },
  "isSchema": true
}