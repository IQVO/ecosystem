{
  "type": "object",
  "required": [
    "from",
    "to",
    "days"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date"
    },
    "to": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "day",
          "groupsReleased",
          "inRegionShare",
          "unknownRegionCount",
          "meanLegs",
          "reassignmentRate",
          "unsourceableCount",
          "splitShipment"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "groupsReleased": {
            "type": "integer",
            "minimum": 0,
            "description": "The releases (sourcing decisions) of the day."
          },
          "inRegionShare": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "nullable": true,
            "description": "Releases in the destination's region / releases with both regions known; null when none is known."
          },
          "unknownRegionCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Releases whose node or destination region is unknown."
          },
          "meanLegs": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "description": "The mean departures after the pickup per release; null without a release."
          },
          "reassignmentRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "nullable": true,
            "description": "Releases with releaseNo > 1 / groupsReleased; null without a release."
          },
          "unsourceableCount": {
            "type": "integer",
            "minimum": 0,
            "description": "FulfillmentUnsourceable events of the day."
          },
          "splitShipment": {
            "type": "object",
            "description": "The split-shipment rate of one day (ADR 0018). A decision is a sourced order, on the UTC day of its first sourcing decision; its shipment groups are the distinct shipments of the current releases of its assignments, a follower of a merged release sharing its carrier's shipment. All zero and splitShare null on a day without such an order.",
            "required": [
              "decisions",
              "splitDecisions",
              "splitShare",
              "groupsPerDecision"
            ],
            "properties": {
              "decisions": {
                "type": "integer",
                "minimum": 0,
                "description": "The sourced orders of the day."
              },
              "splitDecisions": {
                "type": "integer",
                "minimum": 0,
                "description": "The decisions with 2 or more shipment groups (the sum of the buckets 2, 3 and 4+)."
              },
              "splitShare": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "nullable": true,
                "description": "splitDecisions / decisions; null without a decision."
              },
              "groupsPerDecision": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "description": "The shipment groups per decision, always the four buckets 1, 2, 3 and 4+ in this order; the counts sum to decisions.",
                "items": {
                  "type": "object",
                  "required": [
                    "bucket",
                    "decisions"
                  ],
                  "properties": {
                    "bucket": {
                      "type": "string",
                      "enum": [
                        "1",
                        "2",
                        "3",
                        "4+"
                      ],
                      "description": "The number of shipment groups; 4+ holds 4 or more."
                    },
                    "decisions": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "The decisions in this bucket."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "isSchema": true
}