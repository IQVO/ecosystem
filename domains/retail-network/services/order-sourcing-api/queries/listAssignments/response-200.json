{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assignmentId",
          "orderId",
          "groupNo",
          "destinationPostalPrefix",
          "state",
          "assignmentVersion",
          "promise",
          "lines",
          "releases",
          "excludedNodes",
          "trackingNumbers"
        ],
        "properties": {
          "assignmentId": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "groupNo": {
            "type": "integer",
            "minimum": 1
          },
          "destinationPostalPrefix": {
            "type": "string",
            "description": "The postal prefix of the destination (from CustomerOrderPlaced); never an address."
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RELEASED",
              "LOCKED",
              "SHIPPED",
              "DELIVERED",
              "UNSOURCEABLE",
              "CANCELLED"
            ]
          },
          "assignmentVersion": {
            "type": "integer",
            "minimum": 1
          },
          "promise": {
            "type": "object",
            "required": [
              "promiseId",
              "tier",
              "deliverByLatest",
              "witnessNodeId",
              "revisionNo"
            ],
            "properties": {
              "promiseId": {
                "type": "string"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "SAME_DAY",
                  "NEXT_DAY",
                  "TWO_DAY",
                  "STANDARD",
                  "CONSOLIDATED"
                ]
              },
              "deliverByEarliest": {
                "type": "string",
                "format": "date-time",
                "description": "The start of the promised delivery window (a CONSOLIDATED day starts it). Absent when unknown."
              },
              "deliverByLatest": {
                "type": "string",
                "format": "date-time"
              },
              "witnessNodeId": {
                "type": "string",
                "description": "The node of the promise's witness path; the assigned node may differ."
              },
              "revisionNo": {
                "type": "integer",
                "minimum": 0,
                "description": "The promise revision applied (0 until delivery-promise revises it, gap G13). Node exclusions reset when it changes."
              }
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "lineNo",
                "catalogItemId",
                "quantity"
              ],
              "properties": {
                "lineNo": {
                  "type": "integer",
                  "minimum": 1
                },
                "catalogItemId": {
                  "type": "string"
                },
                "listingId": {
                  "type": "string",
                  "description": "The listing of the released node; absent while QUEUED."
                },
                "ownerRef": {
                  "type": "string",
                  "description": "The seller (sellerId) whose stock the released line takes, chosen by the OwnerChoice rule at the released node (ADR 0012). Absent while QUEUED and when the line is operator-owned."
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "candidate": {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "nodeId",
                  "pickupDepartureId",
                  "legs",
                  "deliveryWaveId",
                  "eta",
                  "cost",
                  "pickupCutoffAt"
                ],
                "properties": {
                  "nodeId": {
                    "type": "string"
                  },
                  "pickupDepartureId": {
                    "type": "string"
                  },
                  "pickupCutoffAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The pickup departure's cutoff at this node; the requiredShipBy of a release."
                  },
                  "legs": {
                    "type": "array",
                    "description": "Departure ids after the pickup, in travel order.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "deliveryWaveId": {
                    "type": "string"
                  },
                  "eta": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "cost": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "AssignmentCost in cost points (ADR 0002, A12); the legacy ordinal tie-break score (ADR 0011)."
                  },
                  "estimatedCostCents": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The money-denominated AssignmentCost estimate of the path in planner-declared cents: the per-unit lane costs of every leg plus the final wave's per-stop cost (ADR 0011). Optional: absent when the estimate is incomplete (a lane or the wave had no declared cost)."
                  },
                  "policyVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The sourcing policy version the search read (ADR 0014). Optional, absent when no policy version was published."
                  },
                  "effectiveCostCents": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The estimate's cents plus the policy's cross-region surcharge (ADR 0014). Optional, absent unless a surcharge changed the cost, that is when it differs from the estimate's cents; present even when the estimate is incomplete (a surcharge applies to an incomplete estimate too)."
                  }
                }
              }
            ],
            "description": "The current best candidate; absent when none meets deliverByLatest (UNSOURCEABLE) or the assignment is CANCELLED."
          },
          "releaseAt": {
            "type": "string",
            "format": "date-time",
            "description": "VirtualQueue release point (best candidate's pickup cutoff - node handling time - vendor ack budget); present while QUEUED."
          },
          "releases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "releaseNo",
                "nodeId",
                "releasedAt",
                "requiredShipBy",
                "outcome"
              ],
              "properties": {
                "releaseNo": {
                  "type": "integer",
                  "minimum": 1
                },
                "nodeId": {
                  "type": "string"
                },
                "releasedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "requiredShipBy": {
                  "type": "string",
                  "format": "date-time"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "ACCEPTED",
                    "REJECTED",
                    "EXPIRED",
                    "WITHDRAWN",
                    "PENDING"
                  ]
                },
                "reasonCode": {
                  "type": "string",
                  "description": "Present when the node rejected (the vendor's reason code)."
                }
              }
            }
          },
          "excludedNodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "nodeId",
                "reason"
              ],
              "properties": {
                "nodeId": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "lockedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lockReason": {
            "type": "string"
          },
          "pickupDepartureId": {
            "type": "string",
            "description": "The pickup departure of the locked path; follows BookingMoved."
          },
          "trackingNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shippedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deliveredAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelReason": {
            "type": "string"
          },
          "consolidatedInto": {
            "type": "string",
            "description": "The carrier of the merged release this assignment follows (ADR 0015). Absent unless the assignment is a follower."
          },
          "consolidatedWith": {
            "type": "array",
            "description": "The followers of the merged release this assignment carries (ADR 0015). Absent unless the assignment is a carrier.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor of the next page; absent on the last page."
    }
  },
  "isSchema": true
}