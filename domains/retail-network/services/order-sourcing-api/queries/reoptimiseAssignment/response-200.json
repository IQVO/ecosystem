{
  "type": "object",
  "required": [
    "assignmentId",
    "orderId",
    "groupNo",
    "destinationPostalPrefix",
    "state",
    "assignmentVersion",
    "promise",
    "lines",
    "releases",
    "excludedNodes",
    "trackingNumbers"
  ],
  "properties": {
    "assignmentId": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "groupNo": {
      "type": "integer",
      "minimum": 1
    },
    "destinationPostalPrefix": {
      "type": "string",
      "description": "The postal prefix of the destination (from CustomerOrderPlaced); never an address."
    },
    "state": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RELEASED",
        "LOCKED",
        "SHIPPED",
        "DELIVERED",
        "UNSOURCEABLE",
        "CANCELLED"
      ]
    },
    "assignmentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "promise": {
      "type": "object",
      "required": [
        "promiseId",
        "tier",
        "deliverByLatest",
        "witnessNodeId",
        "revisionNo"
      ],
      "properties": {
        "promiseId": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "SAME_DAY",
            "NEXT_DAY",
            "TWO_DAY",
            "STANDARD"
          ]
        },
        "deliverByLatest": {
          "type": "string",
          "format": "date-time"
        },
        "witnessNodeId": {
          "type": "string",
          "description": "The node of the promise's witness path; the assigned node may differ."
        },
        "revisionNo": {
          "type": "integer",
          "minimum": 0,
          "description": "The promise revision applied (0 until delivery-promise revises it, gap G13). Node exclusions reset when it changes."
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "minimum": 1
          },
          "catalogItemId": {
            "type": "string"
          },
          "listingId": {
            "type": "string",
            "description": "The listing of the released node; absent while QUEUED."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "candidate": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "nodeId",
            "pickupDepartureId",
            "legs",
            "deliveryWaveId",
            "eta",
            "cost",
            "pickupCutoffAt"
          ],
          "properties": {
            "nodeId": {
              "type": "string"
            },
            "pickupDepartureId": {
              "type": "string"
            },
            "pickupCutoffAt": {
              "type": "string",
              "format": "date-time",
              "description": "The pickup departure's cutoff at this node; the requiredShipBy of a release."
            },
            "legs": {
              "type": "array",
              "description": "Departure ids after the pickup, in travel order.",
              "items": {
                "type": "string"
              }
            },
            "deliveryWaveId": {
              "type": "string"
            },
            "eta": {
              "type": "string",
              "format": "date-time"
            },
            "cost": {
              "type": "integer",
              "minimum": 0,
              "description": "AssignmentCost in cost points (ADR 0002, A12)."
            }
          }
        }
      ],
      "description": "The current best candidate; absent when none meets deliverByLatest (UNSOURCEABLE) or the assignment is CANCELLED."
    },
    "releaseAt": {
      "type": "string",
      "format": "date-time",
      "description": "VirtualQueue release point (best candidate's pickup cutoff - node handling time - vendor ack budget); present while QUEUED."
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "releaseNo",
          "nodeId",
          "releasedAt",
          "requiredShipBy",
          "outcome"
        ],
        "properties": {
          "releaseNo": {
            "type": "integer",
            "minimum": 1
          },
          "nodeId": {
            "type": "string"
          },
          "releasedAt": {
            "type": "string",
            "format": "date-time"
          },
          "requiredShipBy": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "REJECTED",
              "EXPIRED",
              "PENDING"
            ]
          },
          "reasonCode": {
            "type": "string",
            "description": "Present when the node rejected (the vendor's reason code)."
          }
        }
      }
    },
    "excludedNodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "reason"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "lockedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lockReason": {
      "type": "string"
    },
    "pickupDepartureId": {
      "type": "string",
      "description": "The pickup departure of the locked path; follows BookingMoved."
    },
    "trackingNumbers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shippedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deliveredAt": {
      "type": "string",
      "format": "date-time"
    },
    "cancelReason": {
      "type": "string"
    }
  },
  "isSchema": true
}