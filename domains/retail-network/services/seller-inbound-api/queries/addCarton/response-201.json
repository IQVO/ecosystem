{
  "type": "object",
  "required": [
    "shipmentId",
    "carton",
    "ssccIssued",
    "label"
  ],
  "properties": {
    "shipmentId": {
      "type": "string",
      "example": "shp-0f3a91"
    },
    "carton": {
      "type": "object",
      "required": [
        "sscc",
        "kind",
        "contents",
        "grossWeightG",
        "dimsMm",
        "sealed"
      ],
      "properties": {
        "sscc": {
          "type": "string",
          "pattern": "^[0-9]{18}$",
          "description": "18 digits with a GS1 mod-10 check digit.",
          "example": "006141420000000011"
        },
        "parentSscc": {
          "type": "string",
          "pattern": "^[0-9]{18}$",
          "description": "18 digits with a GS1 mod-10 check digit.",
          "example": "006141420000000028"
        },
        "kind": {
          "type": "string",
          "enum": [
            "HOMOGENEOUS_CASE",
            "MIXED"
          ],
          "example": "HOMOGENEOUS_CASE"
        },
        "contents": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "What a carton holds of one item, in eaches.",
            "required": [
              "catalogItemId",
              "gtin",
              "qtyEaches"
            ],
            "properties": {
              "catalogItemId": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "example": "item-004512"
              },
              "gtin": {
                "type": "string",
                "pattern": "^[0-9]{14}$",
                "description": "14 digits with a GS1 mod-10 check digit.",
                "example": "00614141000036"
              },
              "qtyEaches": {
                "type": "integer",
                "minimum": 1,
                "example": 12
              },
              "lot": {
                "type": "string",
                "maxLength": 20,
                "example": "L7"
              },
              "expiry": {
                "type": "string",
                "format": "date",
                "example": "2027-10-24"
              }
            }
          }
        },
        "grossWeightG": {
          "type": "integer",
          "example": 5200
        },
        "dimsMm": {
          "type": "object",
          "description": "Outer dimensions in millimetres.",
          "required": [
            "l",
            "w",
            "h"
          ],
          "properties": {
            "l": {
              "type": "integer",
              "minimum": 1,
              "example": 400
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "example": 300
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "example": 200
            }
          }
        },
        "sealed": {
          "type": "boolean",
          "example": false,
          "description": "True once the shipment is labelled: the manifest is frozen."
        },
        "receiptStatus": {
          "type": "string",
          "enum": [
            "RECEIVED",
            "MISSING",
            "UNEXPECTED",
            "DAMAGED"
          ],
          "example": "RECEIVED",
          "description": "Set once the vendor reported its receipt."
        }
      }
    },
    "ssccIssued": {
      "type": "boolean",
      "example": true,
      "description": "True when the network issued the SSCC."
    },
    "label": {
      "type": "object",
      "description": "The data a printer needs for one carton label.",
      "required": [
        "labelRef",
        "sscc",
        "gs1128",
        "humanReadable",
        "kind",
        "contents",
        "contentSummary",
        "totalEaches",
        "destinationNodeId"
      ],
      "properties": {
        "labelRef": {
          "type": "string",
          "example": "LBL-006141420000000011"
        },
        "sscc": {
          "type": "string",
          "pattern": "^[0-9]{18}$",
          "description": "18 digits with a GS1 mod-10 check digit.",
          "example": "006141420000000011"
        },
        "gs1128": {
          "type": "string",
          "example": "(00)006141420000000011",
          "description": "The GS1-128 element string for AI 00: `(00)<sscc>`."
        },
        "humanReadable": {
          "type": "string",
          "example": "(00) 0 0614 1420 0000 0001 1"
        },
        "parentSscc": {
          "type": "string",
          "pattern": "^[0-9]{18}$",
          "description": "18 digits with a GS1 mod-10 check digit.",
          "example": "006141420000000028"
        },
        "kind": {
          "type": "string",
          "enum": [
            "HOMOGENEOUS_CASE",
            "MIXED"
          ],
          "example": "HOMOGENEOUS_CASE"
        },
        "contents": {
          "type": "array",
          "items": "[Circular]"
        },
        "contentSummary": {
          "type": "string",
          "example": "12 eaches: item-004512 x12"
        },
        "totalEaches": {
          "type": "integer",
          "example": 12
        },
        "destinationNodeId": {
          "type": "string",
          "example": "node-0f3a91"
        }
      }
    }
  },
  "isSchema": true
}