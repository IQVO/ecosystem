{
  "type": "object",
  "required": [
    "planId",
    "sellerId",
    "destinationNodeId",
    "packingOption",
    "state",
    "lines",
    "createdAt"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "example": "pln-0f3a91"
    },
    "sellerId": {
      "type": "string",
      "example": "seller-77"
    },
    "destinationNodeId": {
      "type": "string",
      "example": "node-0f3a91"
    },
    "packingOption": {
      "type": "string",
      "enum": [
        "INDIVIDUAL",
        "CASE_PACKED"
      ],
      "example": "CASE_PACKED",
      "description": "`CASE_PACKED` cartons hold one item at the case GTIN's units per pack; `INDIVIDUAL` cartons are packed by the seller as it sees fit."
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CONFIRMED",
        "CANCELLED"
      ],
      "example": "DRAFT"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One line of an inbound plan, in eaches.",
        "required": [
          "catalogItemId",
          "gtin",
          "qtyEaches"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "example": "item-004512"
          },
          "gtin": {
            "type": "string",
            "pattern": "^[0-9]{14}$",
            "description": "14 digits with a GS1 mod-10 check digit.",
            "example": "00614141000036"
          },
          "qtyEaches": {
            "type": "integer",
            "minimum": 1,
            "example": 24,
            "description": "Eaches, never cases."
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-24T13:00:00Z"
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-24T13:00:00Z"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-24T13:00:00Z"
    }
  },
  "isSchema": true
}