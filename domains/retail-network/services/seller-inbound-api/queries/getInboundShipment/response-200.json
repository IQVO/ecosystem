{
  "type": "object",
  "required": [
    "shipmentId",
    "planId",
    "sellerId",
    "nodeId",
    "state",
    "cartons",
    "createdAt"
  ],
  "properties": {
    "shipmentId": {
      "type": "string",
      "example": "shp-0f3a91"
    },
    "planId": {
      "type": "string",
      "example": "pln-0f3a91"
    },
    "sellerId": {
      "type": "string",
      "example": "seller-77"
    },
    "nodeId": {
      "type": "string",
      "example": "node-0f3a91"
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "LABELLED",
        "SHIPPED",
        "RECEIVING",
        "CLOSED",
        "CLOSED_WITH_DISCREPANCY"
      ],
      "example": "DRAFT"
    },
    "cartons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sscc",
          "kind",
          "contents",
          "grossWeightG",
          "dimsMm",
          "sealed"
        ],
        "properties": {
          "sscc": {
            "type": "string",
            "pattern": "^[0-9]{18}$",
            "description": "18 digits with a GS1 mod-10 check digit.",
            "example": "006141420000000011"
          },
          "parentSscc": {
            "type": "string",
            "pattern": "^[0-9]{18}$",
            "description": "18 digits with a GS1 mod-10 check digit.",
            "example": "006141420000000028"
          },
          "kind": {
            "type": "string",
            "enum": [
              "HOMOGENEOUS_CASE",
              "MIXED"
            ],
            "example": "HOMOGENEOUS_CASE"
          },
          "contents": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "What a carton holds of one item, in eaches.",
              "required": [
                "catalogItemId",
                "gtin",
                "qtyEaches"
              ],
              "properties": {
                "catalogItemId": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "example": "item-004512"
                },
                "gtin": {
                  "type": "string",
                  "pattern": "^[0-9]{14}$",
                  "description": "14 digits with a GS1 mod-10 check digit.",
                  "example": "00614141000036"
                },
                "qtyEaches": {
                  "type": "integer",
                  "minimum": 1,
                  "example": 12
                },
                "lot": {
                  "type": "string",
                  "maxLength": 20,
                  "example": "L7"
                },
                "expiry": {
                  "type": "string",
                  "format": "date",
                  "example": "2027-10-24"
                }
              }
            }
          },
          "grossWeightG": {
            "type": "integer",
            "example": 5200
          },
          "dimsMm": {
            "type": "object",
            "description": "Outer dimensions in millimetres.",
            "required": [
              "l",
              "w",
              "h"
            ],
            "properties": {
              "l": {
                "type": "integer",
                "minimum": 1,
                "example": 400
              },
              "w": {
                "type": "integer",
                "minimum": 1,
                "example": 300
              },
              "h": {
                "type": "integer",
                "minimum": 1,
                "example": 200
              }
            }
          },
          "sealed": {
            "type": "boolean",
            "example": false,
            "description": "True once the shipment is labelled: the manifest is frozen."
          },
          "receiptStatus": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "MISSING",
              "UNEXPECTED",
              "DAMAGED"
            ],
            "example": "RECEIVED",
            "description": "Set once the vendor reported its receipt."
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-24T13:00:00Z"
    },
    "labelledAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-24T13:00:00Z"
    },
    "shippedAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-24T13:00:00Z"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-24T13:00:00Z"
    }
  },
  "isSchema": true
}