{
  "type": "object",
  "required": [
    "planId",
    "sellerId",
    "catalogItemId",
    "coverDays",
    "windowDays",
    "basis",
    "state",
    "suggestions",
    "createdAt"
  ],
  "properties": {
    "planId": {
      "type": "string"
    },
    "sellerId": {
      "type": "string"
    },
    "catalogItemId": {
      "type": "string"
    },
    "coverDays": {
      "type": "integer"
    },
    "windowDays": {
      "type": "integer",
      "description": "The observation window the demand figures cover."
    },
    "basis": {
      "type": "string",
      "description": "The formula version the plan was computed under."
    },
    "state": {
      "type": "string",
      "enum": [
        "SUGGESTED",
        "ACCEPTED",
        "SUPERSEDED"
      ]
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeId",
          "regionId",
          "suggestedUnits",
          "regionDemandUnits",
          "nodeAvailabilityUnits",
          "coverDays"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "regionId": {
            "type": "string"
          },
          "suggestedUnits": {
            "type": "integer",
            "minimum": 0
          },
          "regionDemandUnits": {
            "type": "integer",
            "minimum": 0
          },
          "nodeAvailabilityUnits": {
            "type": "integer",
            "minimum": 0
          },
          "coverDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    },
    "supersededAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "isSchema": true
}