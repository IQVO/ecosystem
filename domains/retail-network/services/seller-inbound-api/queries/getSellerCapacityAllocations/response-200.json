{
  "type": "object",
  "description": "The seller's inbound capacity reservations of one calendar month (ADR 0015).",
  "required": [
    "sellerId",
    "month",
    "items"
  ],
  "properties": {
    "sellerId": {
      "type": "string",
      "example": "seller-77"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "example": "2026-11"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One row of the reservation table (ADR 0015) - the dm3 a seller's DRAFT and CONFIRMED plans of the month promise to one node.",
        "required": [
          "nodeId",
          "reservedDm3",
          "updatedAt"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "example": "node-0f3a91"
          },
          "reservedDm3": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "example": 490
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "isSchema": true
}