{
  "type": "object",
  "required": [
    "sellerId",
    "name"
  ],
  "properties": {
    "sellerId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "example": "seller-77"
    },
    "name": {
      "type": "string",
      "maxLength": 200,
      "example": "Acme Goods"
    }
  }
}