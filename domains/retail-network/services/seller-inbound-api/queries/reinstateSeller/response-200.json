{
  "type": "object",
  "required": [
    "sellerId",
    "name",
    "state",
    "onboardedAt"
  ],
  "properties": {
    "sellerId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "example": "seller-77"
    },
    "name": {
      "type": "string",
      "example": "Acme Goods"
    },
    "state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED"
      ],
      "example": "ACTIVE"
    },
    "onboardedAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-24T13:00:00Z"
    },
    "suspendedAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-24T13:00:00Z"
    },
    "suspendReason": {
      "type": "string",
      "example": "repeated label violations"
    }
  },
  "isSchema": true
}