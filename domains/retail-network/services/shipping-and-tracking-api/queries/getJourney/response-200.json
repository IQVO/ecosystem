{
  "type": "object",
  "required": [
    "trackingNumber",
    "state",
    "poNumber",
    "assignmentId",
    "orderId",
    "tier",
    "scans"
  ],
  "properties": {
    "trackingNumber": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "LABELLED",
        "HANDED_OVER",
        "IN_TRANSIT",
        "AT_STATION",
        "OUT_FOR_DELIVERY",
        "DELIVERED",
        "RETURNED",
        "LOST",
        "VOIDED"
      ]
    },
    "poNumber": {
      "type": "string"
    },
    "assignmentId": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "SAME_DAY",
        "NEXT_DAY",
        "TWO_DAY",
        "STANDARD"
      ]
    },
    "handedOverAt": {
      "type": "string",
      "format": "date-time"
    },
    "deliveredAt": {
      "type": "string",
      "format": "date-time"
    },
    "scans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scanId",
          "nodeId",
          "scanType",
          "at",
          "applied"
        ],
        "properties": {
          "scanId": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "scanType": {
            "type": "string",
            "description": "Kind of observation (ADR 0002 A5). Each type has fixed edges: SHIPMENT_CONFIRMED (LABELLED stays), PICKUP_DEPARTURE (LABELLED to HANDED_OVER), DEPARTURE (HANDED_OVER or IN_TRANSIT to IN_TRANSIT), TRANSIT_ARRIVAL (HANDED_OVER or IN_TRANSIT to IN_TRANSIT), STATION_ARRIVAL (HANDED_OVER or IN_TRANSIT to AT_STATION), OUT_FOR_DELIVERY (AT_STATION to OUT_FOR_DELIVERY), DELIVERED (OUT_FOR_DELIVERY to DELIVERED), DELIVERY_FAILED (OUT_FOR_DELIVERY to AT_STATION).",
            "enum": [
              "SHIPMENT_CONFIRMED",
              "PICKUP_DEPARTURE",
              "DEPARTURE",
              "TRANSIT_ARRIVAL",
              "STATION_ARRIVAL",
              "OUT_FOR_DELIVERY",
              "DELIVERED",
              "DELIVERY_FAILED"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "applied": {
            "type": "boolean",
            "description": "False for a scan stored out of order or without an edge from the state it met."
          }
        }
      }
    }
  },
  "isSchema": true
}