{
  "type": "object",
  "description": "Label metadata. Never contains the ship-to address. labelRef, trackingNumber and carrier are what vendor-connectivity returns to the vendor.",
  "required": [
    "labelRef",
    "trackingNumber",
    "carrier",
    "poNumber",
    "packageNo",
    "assignmentId",
    "orderId",
    "tier",
    "status",
    "issuedAt"
  ],
  "properties": {
    "labelRef": {
      "type": "string"
    },
    "trackingNumber": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "poNumber": {
      "type": "string"
    },
    "packageNo": {
      "type": "integer"
    },
    "assignmentId": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "SAME_DAY",
        "NEXT_DAY",
        "TWO_DAY",
        "STANDARD"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ISSUED",
        "VOIDED"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "voidReason": {
      "type": "string"
    },
    "voidedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "isSchema": true
}