{
  "type": "object",
  "description": "The pallet-and-carton tree of one inbound shipment: shipment > pallet > carton > item.\nCartons that are not on a pallet are top-level; a pallet SSCC is the `parentSscc` of its cartons.\n",
  "required": [
    "shipmentId",
    "nodeId",
    "shippedAt",
    "status",
    "pallets",
    "cartons"
  ],
  "properties": {
    "shipmentId": {
      "type": "string",
      "example": "SHP-1001"
    },
    "sellerId": {
      "type": "string",
      "description": "The owner of the goods (`ownerRef` of the stock).",
      "example": "S-100"
    },
    "nodeId": {
      "type": "string",
      "example": "n-1"
    },
    "shippedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "SHIPPED",
        "CLOSED",
        "CLOSED_WITH_DISCREPANCY"
      ]
    },
    "pallets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sscc",
          "cartons"
        ],
        "properties": {
          "sscc": {
            "type": "string",
            "description": "18-digit SSCC of the pallet.",
            "example": "006141410000000036"
          },
          "cartons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sscc",
                "kind",
                "contents"
              ],
              "properties": {
                "sscc": {
                  "type": "string",
                  "description": "18-digit SSCC (AI 00) with a valid check digit.",
                  "example": "006141410000000012"
                },
                "parentSscc": {
                  "type": "string",
                  "description": "The SSCC of the pallet the carton is on; absent for a carton that is not on a pallet."
                },
                "kind": {
                  "type": "string",
                  "description": "HOMOGENEOUS_CASE (one GTIN) or MIXED (a logistic unit with no pack GTIN).",
                  "example": "HOMOGENEOUS_CASE"
                },
                "contents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "gtin",
                      "qtyEaches"
                    ],
                    "properties": {
                      "gtin": {
                        "type": "string",
                        "description": "14-digit GTIN with a valid check digit.",
                        "example": "00614141000036"
                      },
                      "sku": {
                        "type": "string",
                        "description": "The seller's SKU, when known."
                      },
                      "qtyEaches": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Quantity in eaches."
                      },
                      "lot": {
                        "type": "string",
                        "maxLength": 20
                      },
                      "expiry": {
                        "type": "string",
                        "format": "date"
                      }
                    }
                  }
                },
                "grossWeightG": {
                  "type": "integer",
                  "minimum": 0
                },
                "dimsMm": {
                  "type": "object",
                  "required": [
                    "l",
                    "w",
                    "h"
                  ],
                  "properties": {
                    "l": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "w": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "h": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cartons": {
      "type": "array",
      "items": "[Circular]"
    }
  },
  "isSchema": true
}