{
  "type": "object",
  "required": [
    "nodeId",
    "windows"
  ],
  "description": "node-performance's scorecards of the node, one entry per rolling window (7d feeds alerts; 30d is the grade consumers use).",
  "properties": {
    "nodeId": {
      "type": "string"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "window",
          "grade",
          "observations",
          "computedAt"
        ],
        "properties": {
          "window": {
            "type": "string",
            "description": "Rolling window (7-day or 30-day).",
            "example": "7d"
          },
          "grade": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "PROVISIONAL"
            ]
          },
          "onTimeHandoverRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lateAckRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rejectRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "expiryRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "promiseKeptRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "feedFreshnessP95Minutes": {
            "type": "number",
            "minimum": 0
          },
          "observations": {
            "type": "integer",
            "minimum": 0
          },
          "computedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "isSchema": true
}