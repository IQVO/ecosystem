{
  "type": "object",
  "required": [
    "transactionId",
    "vendorId",
    "kind",
    "status",
    "receivedAt"
  ],
  "properties": {
    "transactionId": {
      "type": "string"
    },
    "vendorId": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ACKNOWLEDGEMENT",
        "INVENTORY",
        "NODE_REGISTRATION",
        "NODE_PROFILE",
        "SHIPMENT_CONFIRMATION",
        "INBOUND_RECEIPT"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PROCESSING",
        "SUCCESS",
        "FAILURE"
      ]
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "processedAt": {
      "type": "string",
      "format": "date-time"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code. For a downstream refusal, the owning context's `Err...` identifier.",
            "example": "ErrStaleProfileRevision"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "JSON path of the offending request field, when known.",
            "example": "$.profileRevision"
          }
        }
      },
      "description": "Always present on a processed transaction (empty on `SUCCESS`)."
    },
    "nodeId": {
      "type": "string",
      "description": "Set on a `SUCCESS` `NODE_REGISTRATION` transaction: the id node-topology gave the node (G30)."
    },
    "poNumber": {
      "type": "string",
      "description": "Set on `ACKNOWLEDGEMENT` and `SHIPMENT_CONFIRMATION` transactions: the purchase order they concern."
    }
  },
  "isSchema": true
}