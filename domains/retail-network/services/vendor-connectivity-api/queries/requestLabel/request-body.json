{
  "type": "object",
  "required": [
    "vendorId",
    "poNumber",
    "packages"
  ],
  "properties": {
    "vendorId": {
      "type": "string"
    },
    "poNumber": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "packageNo"
        ],
        "properties": {
          "packageNo": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "description": "The packages to label, each `packageNo` once."
    }
  }
}