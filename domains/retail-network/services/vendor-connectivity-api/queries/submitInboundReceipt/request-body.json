{
  "type": "object",
  "required": [
    "vendorId",
    "shipmentId",
    "nodeId",
    "receivedAt",
    "cartons"
  ],
  "properties": {
    "vendorId": {
      "type": "string"
    },
    "shipmentId": {
      "type": "string"
    },
    "nodeId": {
      "type": "string",
      "description": "The destination node of the shipment."
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cartons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "sscc",
          "status"
        ],
        "properties": {
          "sscc": {
            "type": "string",
            "description": "18-digit SSCC with a valid check digit.",
            "example": "006141410000000012"
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "MISSING",
              "UNEXPECTED",
              "DAMAGED"
            ]
          },
          "items": {
            "type": "array",
            "description": "Per-GTIN counts. Empty for a `MISSING` carton.",
            "items": {
              "type": "object",
              "required": [
                "gtin",
                "qtyEaches"
              ],
              "properties": {
                "gtin": {
                  "type": "string",
                  "description": "GTIN (8, 12, 13 or 14 digits, valid check digit); stored as 14 digits.",
                  "example": "00614141000036"
                },
                "qtyEaches": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Eaches counted."
                }
              }
            }
          },
          "complianceCodes": {
            "type": "array",
            "description": "UPPER_SNAKE compliance findings, for example `LABEL_UNREADABLE`.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            }
          }
        }
      }
    }
  }
}