{
  "type": "object",
  "required": [
    "sessionId",
    "state",
    "cartId",
    "cartVersion",
    "shopperId",
    "shipToAddressId",
    "lines",
    "groups",
    "priceQuoteId",
    "currency",
    "totalMinor",
    "quoteExpiresAt",
    "authorizationId",
    "orderId",
    "failureCode",
    "version"
  ],
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "OPEN",
        "AUTHORIZING",
        "DECLINED",
        "PLACING",
        "REQUOTE_REQUIRED",
        "COMPLETED",
        "EXPIRED",
        "FAILED"
      ]
    },
    "cartId": {
      "type": "string"
    },
    "cartVersion": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    },
    "shopperId": {
      "type": "string"
    },
    "shipToAddressId": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lineNo",
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "minimum": 1
          },
          "catalogItemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "groupNo",
          "offerId",
          "tier",
          "lineNos",
          "amountMinor"
        ],
        "properties": {
          "groupNo": {
            "type": "integer",
            "minimum": 1
          },
          "offerId": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "description": "Delivery service tier. CONSOLIDATED is delivery-promise's opt-in tier of a customer-chosen delivery day; a session carries it only when the shopper selected such an offer in the cart.",
            "enum": [
              "SAME_DAY",
              "NEXT_DAY",
              "TWO_DAY",
              "STANDARD",
              "CONSOLIDATED"
            ]
          },
          "lineNos": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "consolidationEligible": {
            "type": "boolean",
            "description": "Present only for the tier CONSOLIDATED, as the cart's selected offer carried it (delivery-promise ADR 0024): true when the chosen delivery day leaves the network at least one local day to merge the order with others. Omitted for every other tier and when the offer carried none. Information only; it is not sent to customer-ordering."
          },
          "capacityBand": {
            "type": "string",
            "description": "The capacity pressure delivery-promise read on the selected offer's window when it quoted it. A signal only: it changes no offer, window, order or amount.",
            "enum": [
              "AMPLE",
              "TIGHT",
              "SCARCE"
            ]
          }
        }
      }
    },
    "priceQuoteId": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "totalMinor": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
    },
    "quoteExpiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "authorizationId": {
      "type": "string",
      "nullable": true,
      "description": "Always present; null until an authorization is recorded."
    },
    "orderId": {
      "type": "string",
      "nullable": true,
      "description": "Always present; null until the network's place-order step succeeds (COMPLETED)."
    },
    "requotedOffers": {
      "type": "array",
      "description": "Present only in REQUOTE_REQUIRED (omitted otherwise); the BFF writes them into the cart as a new quote.",
      "items": {
        "type": "object",
        "required": [
          "offerId",
          "groupNo",
          "tier",
          "deliverByEarliest",
          "deliverByLatest",
          "expiresAt"
        ],
        "properties": {
          "offerId": {
            "type": "string"
          },
          "groupNo": {
            "type": "integer",
            "minimum": 1
          },
          "tier": "[Circular]",
          "deliverByEarliest": {
            "type": "string",
            "format": "date",
            "description": "Calendar day of the destination: the requoted window's earliest instant read in the offer's time zone (UTC when the network names none, ADR 0008)."
          },
          "deliverByLatest": {
            "type": "string",
            "format": "date",
            "description": "Calendar day of the destination: the requoted window's latest instant read in the offer's time zone (UTC when the network names none, ADR 0008)."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "failureCode": {
      "type": "string",
      "nullable": true,
      "description": "Always present; null unless FAILED."
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    }
  },
  "isSchema": true
}