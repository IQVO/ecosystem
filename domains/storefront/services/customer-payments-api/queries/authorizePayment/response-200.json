{
  "type": "object",
  "required": [
    "authorizationId",
    "checkoutSessionId",
    "orderId",
    "state",
    "currency",
    "totalMinor",
    "allocations",
    "providerAuthorizationId"
  ],
  "properties": {
    "authorizationId": {
      "type": "string"
    },
    "checkoutSessionId": {
      "type": "string"
    },
    "orderId": {
      "type": "string",
      "nullable": true,
      "description": "Bound on CheckoutCompleted (BindOrderOnCheckoutCompleted)."
    },
    "state": {
      "type": "string",
      "enum": [
        "AUTHORIZED",
        "PARTIALLY_CAPTURED",
        "CAPTURED",
        "RELEASED",
        "VOIDED",
        "EXPIRED",
        "DECLINED"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "totalMinor": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
    },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "groupNo",
          "amountMinor",
          "state",
          "trackingNumber",
          "trackingNumbers"
        ],
        "properties": {
          "groupNo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000000
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "CAPTURED",
              "RELEASED"
            ]
          },
          "trackingNumber": {
            "type": "string",
            "nullable": true,
            "description": "Tracking number set at capture; null until then."
          },
          "trackingNumbers": {
            "type": "array",
            "description": "Tracking numbers of the group's packages; empty until captured.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "providerAuthorizationId": {
      "type": "string",
      "nullable": true,
      "description": "Null on a DECLINED authorization."
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Absent when the authorization has no expiry (DECLINED)."
    },
    "declineReason": {
      "type": "string",
      "description": "The provider's decline code; present only on a DECLINED authorization."
    }
  },
  "isSchema": true
}