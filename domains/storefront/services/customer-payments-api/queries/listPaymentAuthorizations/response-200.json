{
  "type": "object",
  "description": "One page of authorizations. nextCursor is absent on the last page.",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "authorizationId",
          "checkoutSessionId",
          "state",
          "currency",
          "totalMinor",
          "allocations"
        ],
        "properties": {
          "authorizationId": {
            "type": "string"
          },
          "checkoutSessionId": {
            "type": "string"
          },
          "orderId": {
            "type": "string",
            "nullable": true,
            "description": "Bound on CheckoutCompleted (BindOrderOnCheckoutCompleted)."
          },
          "state": {
            "type": "string",
            "enum": [
              "AUTHORIZED",
              "PARTIALLY_CAPTURED",
              "CAPTURED",
              "VOIDED",
              "EXPIRED",
              "DECLINED"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "totalMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "allocations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "groupNo",
                "amountMinor",
                "state"
              ],
              "properties": {
                "groupNo": {
                  "type": "integer",
                  "minimum": 1
                },
                "amountMinor": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "PENDING",
                    "CAPTURED",
                    "RELEASED"
                  ]
                }
              }
            }
          },
          "providerAuthorizationId": {
            "type": "string",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor of the next page; pass it back as the cursor query parameter."
    }
  },
  "isSchema": true
}