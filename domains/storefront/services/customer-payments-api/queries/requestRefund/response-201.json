{
  "type": "object",
  "required": [
    "refundId",
    "authorizationId",
    "orderId",
    "amountMinor",
    "reason",
    "state",
    "attempts"
  ],
  "properties": {
    "refundId": {
      "type": "string"
    },
    "authorizationId": {
      "type": "string",
      "description": "The authorization the money returns through."
    },
    "orderId": {
      "type": "string"
    },
    "groupNo": {
      "type": "integer",
      "minimum": 1,
      "description": "Absent for an order-level refund."
    },
    "amountMinor": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "enum": [
        "LOST",
        "RETURNED_TO_SENDER",
        "MANUAL"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "REQUESTED",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Provider attempts so far (a FAILED refund is retried up to 5)."
    },
    "failureCode": {
      "type": "string",
      "description": "The provider's failure code; present on a FAILED refund."
    },
    "providerRefundId": {
      "type": "string",
      "description": "The provider's refund id; present on a SUCCEEDED refund."
    }
  },
  "isSchema": true
}