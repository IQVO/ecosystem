{
  "type": "object",
  "required": [
    "catalogItemId",
    "listPrice"
  ],
  "properties": {
    "catalogItemId": {
      "type": "string"
    },
    "listPrice": {
      "type": "object",
      "required": [
        "amountMinor",
        "currency"
      ],
      "properties": {
        "amountMinor": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}