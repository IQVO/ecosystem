{
  "type": "object",
  "required": [
    "scheduleId",
    "version",
    "tiers",
    "state"
  ],
  "properties": {
    "scheduleId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "CURRENT",
        "SUPERSEDED"
      ]
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tier",
          "charge"
        ],
        "properties": {
          "tier": {
            "type": "string",
            "enum": [
              "SAME_DAY",
              "NEXT_DAY",
              "TWO_DAY",
              "STANDARD"
            ]
          },
          "charge": {
            "type": "object",
            "required": [
              "amountMinor",
              "currency"
            ],
            "properties": {
              "amountMinor": {
                "type": "integer",
                "format": "int64",
                "minimum": 0,
                "maximum": 1000000000
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "freeOver": "[Circular]"
        }
      }
    }
  },
  "isSchema": true
}