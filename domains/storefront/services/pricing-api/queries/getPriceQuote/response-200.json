{
  "type": "object",
  "required": [
    "quoteId",
    "cartId",
    "state",
    "currency",
    "lines",
    "groups",
    "taxMinor",
    "totalMinor",
    "versions",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "quoteId": {
      "type": "string"
    },
    "cartId": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "ISSUED",
        "EXPIRED"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "catalogItemId",
          "quantity",
          "unitPrice",
          "lineTotal"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "object",
            "required": [
              "amountMinor",
              "currency"
            ],
            "properties": {
              "amountMinor": {
                "type": "integer",
                "format": "int64",
                "minimum": 0,
                "maximum": 1000000000
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "lineTotal": "[Circular]"
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "groupNo",
          "tier",
          "deliveryCharge"
        ],
        "properties": {
          "groupNo": {
            "type": "integer",
            "minimum": 1
          },
          "tier": {
            "type": "string",
            "enum": [
              "SAME_DAY",
              "NEXT_DAY",
              "TWO_DAY",
              "STANDARD"
            ]
          },
          "deliveryCharge": "[Circular]"
        }
      }
    },
    "taxMinor": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
    },
    "totalMinor": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
    },
    "versions": {
      "type": "object",
      "description": "Versions used, keyed \"chargeSchedule\", \"taxTable\" and \"price:<catalogItemId>\" per line.",
      "additionalProperties": {
        "type": "integer",
        "format": "int64"
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "isSchema": true
}