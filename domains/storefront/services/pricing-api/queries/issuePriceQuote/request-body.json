{
  "type": "object",
  "required": [
    "cartId",
    "destinationPostalPrefix",
    "lines",
    "groups"
  ],
  "properties": {
    "cartId": {
      "type": "string"
    },
    "destinationPostalPrefix": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "groupNo",
          "offerId",
          "tier",
          "lineNos"
        ],
        "properties": {
          "groupNo": {
            "type": "integer",
            "minimum": 1
          },
          "offerId": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "SAME_DAY",
              "NEXT_DAY",
              "TWO_DAY",
              "STANDARD"
            ]
          },
          "lineNos": {
            "type": "array",
            "minItems": 1,
            "description": "1-based positions of the request lines shipped in this group.",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}