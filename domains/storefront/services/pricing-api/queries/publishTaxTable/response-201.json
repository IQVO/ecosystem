{
  "type": "object",
  "required": [
    "taxTableId",
    "version",
    "bands",
    "state"
  ],
  "properties": {
    "taxTableId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "CURRENT",
        "SUPERSEDED"
      ]
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "postalPrefixFrom",
          "postalPrefixTo",
          "rateBasisPoints"
        ],
        "properties": {
          "postalPrefixFrom": {
            "type": "string",
            "pattern": "^[A-Z0-9]{3}$"
          },
          "postalPrefixTo": {
            "type": "string",
            "pattern": "^[A-Z0-9]{3}$",
            "description": "Not before postalPrefixFrom."
          },
          "rateBasisPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    }
  },
  "isSchema": true
}