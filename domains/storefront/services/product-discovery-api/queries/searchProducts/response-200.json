{
  "type": "object",
  "required": [
    "items",
    "facets"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "catalogItemId",
          "title",
          "inStock",
          "purchasable"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "effectivePrice": {
            "type": "object",
            "required": [
              "amountMinor",
              "currency"
            ],
            "properties": {
              "amountMinor": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "primaryMedia": {
            "type": "object",
            "required": [
              "mediaId",
              "url",
              "altText",
              "role"
            ],
            "properties": {
              "mediaId": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "altText": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "PRIMARY",
                  "GALLERY"
                ]
              }
            }
          },
          "categoryId": {
            "type": "string"
          },
          "categoryPath": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inStock": {
            "type": "boolean"
          },
          "purchasable": {
            "type": "boolean"
          }
        }
      }
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "values"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "category, price-band or in-stock."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "count"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "categorySuggestions": {
      "type": "array",
      "description": "Suggested categories for product-type queries.",
      "items": {
        "type": "object",
        "required": [
          "categoryId",
          "name"
        ],
        "properties": {
          "categoryId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque keyset cursor; pass it as `cursor` for the next page. Absent on the last page."
    }
  },
  "isSchema": true
}