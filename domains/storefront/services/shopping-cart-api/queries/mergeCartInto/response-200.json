{
  "type": "object",
  "required": [
    "cartId",
    "state",
    "lines",
    "version"
  ],
  "properties": {
    "cartId": {
      "type": "string"
    },
    "shopperId": {
      "type": "string",
      "nullable": true
    },
    "state": {
      "type": "string",
      "enum": [
        "OPEN",
        "CHECKED_OUT",
        "ABANDONED",
        "MERGED"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "catalogItemId",
          "quantity"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    },
    "destinationPostalPrefix": {
      "type": "string",
      "nullable": true
    },
    "deliveryQuote": {
      "type": "object",
      "required": [
        "groups",
        "unavailableTiers",
        "quotedAt"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "groupNo",
              "lineNos",
              "offers"
            ],
            "properties": {
              "groupNo": {
                "type": "integer",
                "minimum": 1
              },
              "lineNos": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "offers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "offerId",
                    "groupNo",
                    "tier",
                    "deliverByEarliest",
                    "deliverByLatest",
                    "expiresAt"
                  ],
                  "properties": {
                    "offerId": {
                      "type": "string"
                    },
                    "groupNo": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "tier": {
                      "type": "string",
                      "enum": [
                        "SAME_DAY",
                        "NEXT_DAY",
                        "TWO_DAY",
                        "STANDARD"
                      ]
                    },
                    "deliverByEarliest": {
                      "type": "string",
                      "format": "date",
                      "description": "First day of the offer's delivery window, a day of the destination's local calendar (the delivery station's time zone delivery-promise names on the window; UTC when it names none)."
                    },
                    "deliverByLatest": {
                      "type": "string",
                      "format": "date",
                      "description": "Last day of the offer's delivery window, a day of the destination's local calendar (the delivery station's time zone delivery-promise names on the window; UTC when it names none)."
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "unavailableTiers": {
          "type": "array",
          "items": "[Circular]"
        },
        "unavailable": {
          "type": "array",
          "description": "The unavailable tiers with the constraint delivery-promise reported.",
          "items": {
            "type": "object",
            "required": [
              "tier",
              "constraint"
            ],
            "properties": {
              "tier": "[Circular]",
              "constraint": {
                "type": "string"
              },
              "groupNo": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "quotedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "groupNo",
          "offerId"
        ],
        "properties": {
          "groupNo": {
            "type": "integer",
            "minimum": 1
          },
          "offerId": {
            "type": "string"
          }
        }
      }
    },
    "estimate": {
      "type": "object",
      "required": [
        "currency",
        "itemsMinor",
        "deliveryMinor",
        "taxMinor",
        "totalMinor",
        "estimateComplete"
      ],
      "description": "The labelled, non-binding total shown in the cart; the binding total is the checkout session's PriceQuote.",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "itemsMinor": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "deliveryMinor": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "taxMinor": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "totalMinor": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "estimateComplete": {
          "type": "boolean",
          "description": "False while the destination is unset, a line has no effective price, or the schedule or tax band is unknown: the figures then cover only what is known (item subtotal first)."
        }
      }
    },
    "checkoutReadiness": {
      "type": "object",
      "required": [
        "ready",
        "allGroupsSelected",
        "noOfferExpired"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "allGroupsSelected": {
          "type": "boolean"
        },
        "noOfferExpired": {
          "type": "boolean"
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "isSchema": true
}