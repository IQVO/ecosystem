{
  "type": "object",
  "required": [
    "fleet_id",
    "map_id",
    "map_version",
    "handoff_points",
    "robots",
    "capacity"
  ],
  "properties": {
    "fleet_id": {
      "type": "string"
    },
    "map_id": {
      "type": "string"
    },
    "map_version": {
      "type": "string"
    },
    "handoff_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "robots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "manufacturer",
          "serial_number",
          "connection",
          "state",
          "battery_percent",
          "charging",
          "available",
          "error_types",
          "last_seen_at"
        ],
        "properties": {
          "manufacturer": {
            "type": "string"
          },
          "serial_number": {
            "type": "string"
          },
          "connection": {
            "type": "string",
            "enum": [
              "ONLINE",
              "OFFLINE",
              "CONNECTION_BROKEN"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "IDLE",
              "EXECUTE",
              "SUSPENDED",
              "HELD",
              "STOPPED"
            ]
          },
          "battery_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "charging": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean",
            "description": "Idle",
            "on the map": null,
            "nothing in flight and at or above the charge threshold.": null
          },
          "node_id": {
            "type": "string",
            "description": "The map node the robot stands on."
          },
          "mission_id": {
            "type": "string",
            "description": "The leg or internal mission the robot executes."
          },
          "error_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "factsheet": {
            "type": "object",
            "required": [
              "series_name",
              "max_speed",
              "max_load_mass"
            ],
            "properties": {
              "series_name": {
                "type": "string"
              },
              "max_speed": {
                "type": "number"
              },
              "max_load_mass": {
                "type": "number"
              }
            }
          }
        }
      },
      "description": "Without factsheets."
    },
    "capacity": {
      "type": "object",
      "required": [
        "robots_total",
        "robots_online",
        "robots_available",
        "robots_charging",
        "robots_held",
        "legs_queued",
        "legs_active"
      ],
      "properties": {
        "robots_total": {
          "type": "integer",
          "minimum": 0
        },
        "robots_online": {
          "type": "integer",
          "minimum": 0
        },
        "robots_available": {
          "type": "integer",
          "minimum": 0
        },
        "robots_charging": {
          "type": "integer",
          "minimum": 0
        },
        "robots_held": {
          "type": "integer",
          "minimum": 0
        },
        "legs_queued": {
          "type": "integer",
          "minimum": 0
        },
        "legs_active": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "isSchema": true
}