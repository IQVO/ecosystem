{
  "type": "object",
  "required": [
    "manufacturer",
    "serial_number",
    "connection",
    "state",
    "battery_percent",
    "charging",
    "available",
    "error_types",
    "last_seen_at"
  ],
  "properties": {
    "manufacturer": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "connection": {
      "type": "string",
      "enum": [
        "ONLINE",
        "OFFLINE",
        "CONNECTION_BROKEN"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "IDLE",
        "EXECUTE",
        "SUSPENDED",
        "HELD",
        "STOPPED"
      ]
    },
    "battery_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "charging": {
      "type": "boolean"
    },
    "available": {
      "type": "boolean",
      "description": "Idle",
      "on the map": null,
      "nothing in flight and at or above the charge threshold.": null
    },
    "node_id": {
      "type": "string",
      "description": "The map node the robot stands on."
    },
    "mission_id": {
      "type": "string",
      "description": "The leg or internal mission the robot executes."
    },
    "error_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "factsheet": {
      "type": "object",
      "required": [
        "series_name",
        "max_speed",
        "max_load_mass"
      ],
      "properties": {
        "series_name": {
          "type": "string"
        },
        "max_speed": {
          "type": "number"
        },
        "max_load_mass": {
          "type": "number"
        }
      }
    }
  },
  "isSchema": true
}