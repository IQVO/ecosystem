{
  "type": "object",
  "required": [
    "asrs_id",
    "aisles",
    "ports",
    "recommended_input_port_id",
    "capacity"
  ],
  "properties": {
    "asrs_id": {
      "type": "string"
    },
    "aisles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "aisle",
          "unit_id",
          "state",
          "busy",
          "open_jobs",
          "positions_total",
          "positions_free"
        ],
        "properties": {
          "aisle": {
            "type": "integer",
            "minimum": 1
          },
          "unit_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "IDLE",
              "EXECUTE",
              "HELD"
            ]
          },
          "busy": {
            "type": "boolean",
            "description": "A job is with the PLC for this unit."
          },
          "open_jobs": {
            "type": "integer",
            "minimum": 0
          },
          "positions_total": {
            "type": "integer",
            "minimum": 1
          },
          "positions_free": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "port_id",
          "aisle",
          "kind",
          "presented_container_id"
        ],
        "properties": {
          "port_id": {
            "type": "string"
          },
          "aisle": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "INPUT",
              "OUTPUT"
            ]
          },
          "presented_container_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The container waiting on an output port."
          }
        }
      }
    },
    "recommended_input_port_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The input port of the least-loaded available aisle."
    },
    "capacity": {
      "type": "object",
      "required": [
        "units_total",
        "units_available",
        "positions_total",
        "positions_free",
        "open_jobs"
      ],
      "properties": {
        "units_total": {
          "type": "integer"
        },
        "units_available": {
          "type": "integer"
        },
        "positions_total": {
          "type": "integer"
        },
        "positions_free": {
          "type": "integer"
        },
        "open_jobs": {
          "type": "integer"
        }
      }
    }
  },
  "isSchema": true
}