{
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "sourceType",
      "version",
      "severity",
      "queue",
      "slaMinutes",
      "declaredAt"
    ],
    "properties": {
      "sourceType": {
        "type": "string",
        "description": "The full CloudEvents type of the governed source fact."
      },
      "version": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "description": "Append-only: 1 for the first declaration, +1 per accepted change."
      },
      "severity": {
        "type": "string",
        "description": "The triage outcome, from the policy or an operator.",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH",
          "CRITICAL"
        ]
      },
      "queue": {
        "type": "string"
      },
      "slaMinutes": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "autoResolve": {
        "type": "object",
        "nullable": true,
        "description": "Null when the source type has no auto-resolve rule.",
        "allOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "onType",
              "withinMinutes"
            ],
            "properties": {
              "onType": {
                "type": "string",
                "description": "The full CloudEvents type of the correlated fact that closes the case (e.g. OrderRepromised)."
              },
              "withinMinutes": {
                "type": "integer",
                "format": "int64",
                "minimum": 1,
                "description": "The correlated fact counts only within this many minutes of the case's last occurrence."
              }
            }
          }
        ]
      },
      "declaredAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "isSchema": true
}