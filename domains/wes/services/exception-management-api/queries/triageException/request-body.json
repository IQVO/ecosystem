{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "severity",
    "queue"
  ],
  "properties": {
    "severity": {
      "type": "string",
      "description": "The triage outcome, from the policy or an operator.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "queue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S",
      "description": "The problem-solve queue the case is routed to."
    }
  }
}