{
  "type": "object",
  "required": [
    "transport_request_id",
    "container_id",
    "source",
    "destination",
    "purpose",
    "priority",
    "due_by",
    "status",
    "legs_total",
    "legs_done"
  ],
  "properties": {
    "transport_request_id": {
      "type": "string"
    },
    "transport_order_id": {
      "type": "string",
      "description": "Absent when the request was rejected."
    },
    "container_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "PICK",
        "PUTAWAY",
        "REPLENISH",
        "OUTBOUND",
        "RETURN"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "NORMAL",
        "URGENT"
      ]
    },
    "due_by": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "CANCEL_REQUESTED",
        "COMPLETED",
        "FAILED",
        "REJECTED"
      ]
    },
    "reason": {
      "type": "string",
      "description": "`CLARIFICATION`, `SUBSYSTEM_FAULT`, `CANCELLED` or `TIMEOUT` when FAILED; the rejection reason when REJECTED.",
      "enum": [
        "CLARIFICATION",
        "SUBSYSTEM_FAULT",
        "CANCELLED",
        "TIMEOUT",
        "UNKNOWN_CONTAINER",
        "CONTAINER_BUSY",
        "DESTINATION_UNREACHABLE",
        "SUBSYSTEM_UNAVAILABLE"
      ]
    },
    "container_location": {
      "type": "string",
      "description": "The container's last confirmed location: a location code or station id; absent while on a robot or unknown."
    },
    "legs_total": {
      "type": "integer",
      "minimum": 0
    },
    "legs_done": {
      "type": "integer",
      "minimum": 0
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "isSchema": true
}