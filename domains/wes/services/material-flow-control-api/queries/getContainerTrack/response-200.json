{
  "type": "object",
  "required": [
    "container_id",
    "position",
    "updated_at",
    "history"
  ],
  "properties": {
    "container_id": {
      "type": "string"
    },
    "position": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "IN_ASRS",
            "AT_PORT",
            "ON_ROBOT",
            "AT_STATION",
            "AT_HANDOFF",
            "AT_CLARIFICATION",
            "UNKNOWN"
          ]
        },
        "code": {
          "type": "string",
          "description": "The location code or station id; for ON_ROBOT the fleet id."
        }
      }
    },
    "active_transport_request_id": {
      "type": "string"
    },
    "clarification": {
      "type": "object",
      "required": [
        "reason",
        "detected_at_location",
        "since"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "NO_READ",
            "MISMATCH",
            "CONTAINER_NOT_AT_SOURCE",
            "CONTAINER_NOT_AT_PORT",
            "STORAGE_MAP_MISMATCH",
            "CONTAINER_ON_FAILED_ROBOT"
          ]
        },
        "detected_at_location": {
          "type": "string",
          "description": "The location code or station id where the problem was detected; for a container on a failed robot, the place the failed leg started from."
        },
        "scanned_container_id": {
          "type": "string"
        },
        "since": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "history": {
      "type": "array",
      "maxItems": 20,
      "description": "The last 20 moves.",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "at"
        ],
        "properties": {
          "from": "[Circular]",
          "to": "[Circular]",
          "transport_request_id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "isSchema": true
}