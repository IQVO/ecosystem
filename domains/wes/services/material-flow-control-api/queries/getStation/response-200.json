{
  "type": "object",
  "required": [
    "station_id",
    "buffer_limit",
    "occupied",
    "occupants",
    "waiting"
  ],
  "properties": {
    "station_id": {
      "type": "string"
    },
    "buffer_limit": {
      "type": "integer",
      "minimum": 1
    },
    "occupied": {
      "type": "integer",
      "minimum": 0
    },
    "occupants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "container_id",
          "transport_request_id",
          "position",
          "admitted_at"
        ],
        "properties": {
          "container_id": {
            "type": "string"
          },
          "transport_request_id": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based position among the occupants."
          },
          "admitted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "waiting": {
      "type": "array",
      "description": "In admission order.",
      "items": {
        "type": "object",
        "required": [
          "container_id",
          "transport_request_id",
          "priority",
          "due_by",
          "ready_at"
        ],
        "properties": {
          "container_id": {
            "type": "string"
          },
          "transport_request_id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "NORMAL",
              "URGENT"
            ]
          },
          "due_by": {
            "type": "string",
            "format": "date-time"
          },
          "ready_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "isSchema": true
}