        "title",
        "status",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "code": {
          "type": "string",
          "description": "Stable fleet error code.",
          "examples": [
            "transport-request-conflict"
          ]
        },
        "detail": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "reason",
        "transport_request_id"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "UNKNOWN_CONTAINER",
            "CONTAINER_BUSY",
            "DESTINATION_UNREACHABLE",
            "SUBSYSTEM_UNAVAILABLE"
          ]
        },
        "transport_request_id": {
          "type": "string"
        }
      }
    }
  ],
  "isSchema": true
}