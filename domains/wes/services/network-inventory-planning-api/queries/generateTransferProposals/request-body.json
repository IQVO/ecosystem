{
  "type": "object",
  "required": [
    "asOf",
    "positions",
    "policies",
    "lanes"
  ],
  "properties": {
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Site",
          "SKU",
          "Available",
          "AsOf"
        ],
        "properties": {
          "Site": {
            "type": "string",
            "minLength": 1,
            "description": "Facility-layout Site code identifying one warehouse."
          },
          "SKU": {
            "type": "string",
            "minLength": 1
          },
          "Available": {
            "type": "integer",
            "minimum": 0
          },
          "CustomerReservations": {
            "type": "integer",
            "minimum": 0
          },
          "ConfirmedInbound": {
            "type": "integer",
            "minimum": 0
          },
          "CommittedOutbound": {
            "type": "integer",
            "minimum": 0
          },
          "AsOf": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Version",
          "Site",
          "SKU"
        ],
        "properties": {
          "Version": {
            "type": "string"
          },
          "Site": "[Circular]",
          "SKU": "[Circular]",
          "SafetyStock": {
            "type": "integer",
            "minimum": 0
          },
          "TargetStock": {
            "type": "integer",
            "minimum": 0
          },
          "UnitPriority": {
            "type": "integer"
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Origin",
          "Destination",
          "Enabled"
        ],
        "properties": {
          "Origin": "[Circular]",
          "Destination": "[Circular]",
          "LeadTime": {
            "type": "integer",
            "description": "Lead time in nanoseconds (Go time.Duration wire shape)."
          },
          "UnitHandlingCost": {
            "type": "integer"
          },
          "Enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}