{
  "allOf": [
    {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "description": "The effective inclusive start."
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "description": "The effective exclusive end."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "days"
      ],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "day",
              "runs",
              "proposals",
              "rejected",
              "rejection_rate",
              "stale_facts"
            ],
            "properties": {
              "day": {
                "type": "string",
                "format": "date",
                "example": "2026-10-05"
              },
              "runs": {
                "type": "integer",
                "minimum": 1,
                "example": 2
              },
              "proposals": {
                "type": "integer",
                "minimum": 0,
                "description": "Proposals the planner produced, summed over the day's runs.",
                "example": 14
              },
              "rejected": {
                "type": "integer",
                "minimum": 0,
                "description": "Proposals the runs' own safety checks refused (never an operator rejection).",
                "example": 2
              },
              "rejection_rate": {
                "type": "number",
                "format": "double",
                "minimum": 0,
                "maximum": 1,
                "description": "rejected / proposals; 0 when there were no proposals.",
                "example": 0.142857
              },
              "stale_facts": {
                "type": "integer",
                "minimum": 0,
                "example": 1
              }
            }
          }
        }
      }
    }
  ],
  "isSchema": true
}