{
  "allOf": [
    {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "description": "The effective inclusive start."
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "description": "The effective exclusive end."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "days",
        "latest"
      ],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "day",
              "state",
              "detections",
              "transfers"
            ],
            "properties": {
              "day": {
                "type": "string",
                "format": "date",
                "example": "2026-10-05"
              },
              "state": {
                "type": "string",
                "example": "ALLOCATING"
              },
              "detections": {
                "type": "integer",
                "minimum": 1,
                "description": "TransferStuckDetected occurrences (a stuck transfer is re-detected every pass).",
                "example": 2
              },
              "transfers": {
                "type": "integer",
                "minimum": 1,
                "description": "Distinct transfers detected.",
                "example": 1
              }
            }
          }
        },
        "latest": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "transfer_id",
              "state",
              "age_seconds",
              "threshold_seconds",
              "detected_at"
            ],
            "properties": {
              "transfer_id": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "age_seconds": {
                "type": "integer",
                "format": "int64",
                "description": "Seconds since the transfer's last transition when it was detected."
              },
              "threshold_seconds": {
                "type": "integer",
                "format": "int64",
                "description": "The per-state threshold that was exceeded."
              },
              "detected_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ],
  "isSchema": true
}