{
  "allOf": [
    {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "description": "The effective inclusive start."
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "description": "The effective exclusive end."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "days"
      ],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "day",
              "state",
              "transfers"
            ],
            "properties": {
              "day": {
                "type": "string",
                "format": "date",
                "description": "UTC calendar day of the transition.",
                "example": "2026-10-05"
              },
              "state": {
                "type": "string",
                "description": "The saga state reached (TransferStateAdvanced `to`).",
                "example": "APPROVED"
              },
              "transfers": {
                "type": "integer",
                "minimum": 1,
                "description": "Distinct transfers that reached the state that day.",
                "example": 5
              }
            }
          }
        }
      }
    }
  ],
  "isSchema": true
}