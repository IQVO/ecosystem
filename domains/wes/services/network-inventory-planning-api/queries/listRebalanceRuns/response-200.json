{
  "type": "object",
  "required": [
    "runs"
  ],
  "properties": {
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "startedAt",
          "proposalCount",
          "rejectedCount",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "snapshotAsOf": {
            "type": "string",
            "format": "date-time",
            "description": "The planning-facts watermark the pass planned from; absent on a FAILED run that never reached a watermark."
          },
          "proposalCount": {
            "type": "integer"
          },
          "rejectedCount": {
            "type": "integer"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "FAILED"
            ]
          },
          "failClosedReason": {
            "type": "string",
            "description": "The fail-closed snapshot refusal; present only when outcome is FAILED."
          }
        }
      }
    }
  },
  "isSchema": true
}