{
  "type": "object",
  "required": [
    "items",
    "total",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "sku",
          "quantity",
          "originSiteId",
          "destinationSiteId",
          "policyVersion",
          "expiresAt",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The transfer (saga aggregate) id."
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PROPOSED",
              "APPROVED",
              "ALLOCATING",
              "ALLOCATED",
              "PICKED",
              "IN_TRANSIT",
              "ARRIVED",
              "RECEIVED",
              "UNFULFILLABLE",
              "CANCELLED"
            ],
            "description": "Saga lifecycle state. RECEIVED, UNFULFILLABLE and CANCELLED are\nterminal; every other state is waiting for a next step.\n"
          },
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "description": "Units planned to move."
          },
          "pickedQuantity": {
            "type": "integer",
            "description": "Units the origin pick actually picked; present from PICKED onwards (may be short of quantity)."
          },
          "originSiteId": {
            "type": "string",
            "minLength": 1,
            "description": "Facility-layout Site code identifying one warehouse."
          },
          "destinationSiteId": "[Circular]",
          "policyVersion": {
            "type": "string"
          },
          "reservationId": {
            "type": "string",
            "description": "inventory-storage's reservation id, present once ALLOCATED."
          },
          "rejectionReason": {
            "type": "string",
            "enum": [
              "ORIGIN_SITE_UNKNOWN",
              "INSUFFICIENT_USABLE",
              "IDEMPOTENCY_CONFLICT"
            ],
            "description": "The closed rejection reason, present once UNFULFILLABLE."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the last state transition; a non-terminal transfer whose updatedAt is old is stuck."
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Optimistic-concurrency version (the number of persisted state transitions)."
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "description": "Number of transfers matching the filter before paging."
    },
    "limit": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    }
  },
  "isSchema": true
}