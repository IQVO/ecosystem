{
  "type": "object",
  "required": [
    "policy",
    "revision",
    "updatedAt"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "required": [
        "Version",
        "Site",
        "SKU"
      ],
      "properties": {
        "Version": {
          "type": "string"
        },
        "Site": {
          "type": "string",
          "minLength": 1,
          "description": "Facility-layout Site code identifying one warehouse."
        },
        "SKU": {
          "type": "string",
          "minLength": 1
        },
        "SafetyStock": {
          "type": "integer",
          "minimum": 0
        },
        "TargetStock": {
          "type": "integer",
          "minimum": 0
        },
        "UnitPriority": {
          "type": "integer"
        }
      }
    },
    "revision": {
      "type": "integer",
      "format": "int64",
      "minimum": 1,
      "description": "Optimistic-concurrency token (also the ETag); 1 on creation, +1 per change."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "CREATED",
        "UPDATED",
        "UNCHANGED"
      ],
      "description": "What a catalogue PUT did (UNCHANGED = idempotent replay, nothing written)."
    }
  },
  "isSchema": true
}