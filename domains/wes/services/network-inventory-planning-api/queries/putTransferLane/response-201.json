{
  "type": "object",
  "required": [
    "lane",
    "revision",
    "updatedAt"
  ],
  "properties": {
    "lane": {
      "type": "object",
      "required": [
        "Origin",
        "Destination",
        "Enabled"
      ],
      "properties": {
        "Origin": {
          "type": "string",
          "minLength": 1,
          "description": "Facility-layout Site code identifying one warehouse."
        },
        "Destination": "[Circular]",
        "LeadTime": {
          "type": "integer",
          "description": "Lead time in nanoseconds (Go time.Duration wire shape)."
        },
        "UnitHandlingCost": {
          "type": "integer"
        },
        "Enabled": {
          "type": "boolean"
        }
      }
    },
    "revision": {
      "type": "integer",
      "format": "int64",
      "minimum": 1,
      "description": "Optimistic-concurrency token (also the ETag); 1 on creation, +1 per change."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "CREATED",
        "UPDATED",
        "UNCHANGED"
      ],
      "description": "What a catalogue PUT did (UNCHANGED = idempotent replay, nothing written)."
    }
  },
  "isSchema": true
}