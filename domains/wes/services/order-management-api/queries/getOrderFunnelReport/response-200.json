{
  "type": "object",
  "required": [
    "rows"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "description": "One row per (pathId, hour bucket). Always present; empty for a window with no data.",
      "items": {
        "type": "object",
        "required": [
          "pathId",
          "hourBucket",
          "ordersReceived",
          "ordersAllocated",
          "ordersPartiallyAllocated",
          "ordersAllocationFailed",
          "ordersReleased",
          "ordersCancelled",
          "linesAllocated",
          "linesBackordered",
          "linesReleased",
          "promiseBasisCapability",
          "promiseBasisLeadTime",
          "promiseBasisNetwork",
          "ordersRepromised",
          "ordersSplitShipment",
          "promiseToCutoffGapSeconds"
        ],
        "properties": {
          "pathId": {
            "type": "string",
            "description": "Process path of the row. The empty string holds counters that have no path (ordersRepromised).\n",
            "example": "pick"
          },
          "hourBucket": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the UTC hour this row aggregates.",
            "example": "2026-06-01T14:00:00Z"
          },
          "ordersReceived": {
            "type": "integer",
            "format": "int32",
            "description": "OrderReceived events. Funnel entry.",
            "example": 5
          },
          "ordersAllocated": {
            "type": "integer",
            "format": "int32",
            "description": "OrderAllocated events (every line allocated).",
            "example": 4
          },
          "ordersPartiallyAllocated": {
            "type": "integer",
            "format": "int32",
            "description": "OrderPartiallyAllocated events (some lines backordered).",
            "example": 0
          },
          "ordersAllocationFailed": {
            "type": "integer",
            "format": "int32",
            "description": "OrderAllocationPartiallyFailed events (hard, non-business allocation failure). Leakage.",
            "example": 0
          },
          "ordersReleased": {
            "type": "integer",
            "format": "int32",
            "description": "OrderReleased events (every line released; ADR 0034). Funnel exit.",
            "example": 3
          },
          "ordersCancelled": {
            "type": "integer",
            "format": "int32",
            "description": "OrderCancelled events. Leakage.",
            "example": 1
          },
          "linesAllocated": {
            "type": "integer",
            "format": "int32",
            "description": "OrderLineAllocated events.",
            "example": 8
          },
          "linesBackordered": {
            "type": "integer",
            "format": "int32",
            "description": "OrderLineBackordered events (inventory-storage answered 409). Leakage.",
            "example": 2
          },
          "linesReleased": {
            "type": "integer",
            "format": "int32",
            "description": "OrderLineReleased events (ADR 0034).",
            "example": 6
          },
          "promiseBasisCapability": {
            "type": "integer",
            "format": "int32",
            "description": "Allocations whose promise basis was Capability (ADR 0019).",
            "example": 3
          },
          "promiseBasisLeadTime": {
            "type": "integer",
            "format": "int32",
            "description": "Allocations whose promise basis was the LeadTime fallback (ADR 0019).",
            "example": 1
          },
          "promiseBasisNetwork": {
            "type": "integer",
            "format": "int32",
            "description": "Allocations whose promise date was dictated by an external deadline (Network basis, ADR 0020).",
            "example": 0
          },
          "ordersRepromised": {
            "type": "integer",
            "format": "int32",
            "description": "OrderRepromised events (ADR 0018). Only non-zero on the row whose pathId is \"\".",
            "example": 0
          },
          "ordersSplitShipment": {
            "type": "integer",
            "format": "int32",
            "description": "Allocations whose order had more than one promise group (ADR 0017).",
            "example": 0
          },
          "promiseToCutoffGapSeconds": {
            "type": "number",
            "format": "double",
            "description": "Mean of (cutoff - allocation time) in seconds over Capability-basis promises in the bucket; 0 when there are none.\n",
            "example": 5400
          }
        }
      }
    }
  },
  "isSchema": true
}