{
  "type": "object",
  "required": [
    "site",
    "windows"
  ],
  "properties": {
    "site": {
      "type": "string",
      "example": "SIM1"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "planId",
          "warehouseId",
          "location",
          "windowStart",
          "windowEnd",
          "assignedDemand",
          "capacityOverWindow",
          "shortage",
          "status",
          "asOf"
        ],
        "properties": {
          "planId": {
            "type": "string",
            "example": "0b7a4c1e-5d52-4f0e-9a39-6c1f2f3a8b10"
          },
          "warehouseId": {
            "type": "string",
            "description": "warehouse-planning's own warehouse label (informational).",
            "example": "WH-1"
          },
          "location": {
            "type": "string",
            "description": "The ProcessCapacity location the plan evaluates; a site code for a plan that never carried a `siteId`. `GET /planned-capacity` lists by this field.",
            "example": "SIM1"
          },
          "siteId": {
            "type": "string",
            "description": "The plan's canonical site (warehouse-planning's `site_id`), when it carries one; omitted otherwise. An order is annotated by a plan whose `siteId` equals the order's site, else, for a plan without one, whose `location` does (ADR 0031 amendment). A write without a site id never erases a stored one.",
            "example": "SIM1"
          },
          "pathId": {
            "type": "string",
            "description": "warehouse-planning's own path label (informational; not an order-management process path id).",
            "example": "pick-rebin-pack"
          },
          "windowStart": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-05T08:00:00Z"
          },
          "windowEnd": {
            "type": "string",
            "format": "date-time",
            "description": "Exclusive.",
            "example": "2026-10-05T16:00:00Z"
          },
          "assignedDemand": {
            "type": "number",
            "format": "double",
            "example": 12000
          },
          "capacityOverWindow": {
            "type": "number",
            "format": "double",
            "example": 8000
          },
          "shortage": {
            "type": "number",
            "format": "double",
            "example": 4000
          },
          "bottleneckStep": {
            "type": "string",
            "example": "REBIN"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "SUPERSEDED"
            ],
            "description": "Only PUBLISHED plans with a shortage annotate orders. SUPERSEDED (ADR 0052) is terminal: a newer plan of the same window replaced this one, and it never annotates an order again.",
            "example": "PUBLISHED"
          },
          "supersededBy": {
            "type": "string",
            "description": "The id of the newer plan that replaced this one. Present only when `status` is SUPERSEDED (ADR 0052).",
            "example": "7e2f9a1c-3b4d-4e5f-8a6b-9c0d1e2f3a4b"
          },
          "asOf": {
            "type": "string",
            "format": "date-time",
            "description": "The CloudEvents `time` of the event that last wrote this row (last writer wins per plan id).",
            "example": "2026-10-04T21:45:10Z"
          }
        }
      }
    }
  },
  "isSchema": true
}