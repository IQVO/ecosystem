{
  "type": "object",
  "required": [
    "site",
    "windows"
  ],
  "properties": {
    "site": {
      "type": "string",
      "example": "SIM1"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "planId",
          "warehouseId",
          "location",
          "windowStart",
          "windowEnd",
          "assignedDemand",
          "capacityOverWindow",
          "shortage",
          "status",
          "asOf"
        ],
        "properties": {
          "planId": {
            "type": "string",
            "example": "0b7a4c1e-5d52-4f0e-9a39-6c1f2f3a8b10"
          },
          "warehouseId": {
            "type": "string",
            "description": "warehouse-planning's own warehouse label (informational).",
            "example": "WH-1"
          },
          "location": {
            "type": "string",
            "description": "Site/building code.",
            "example": "SIM1"
          },
          "pathId": {
            "type": "string",
            "description": "warehouse-planning's own path label (informational; not an order-management process path id).",
            "example": "pick-rebin-pack"
          },
          "windowStart": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-05T08:00:00Z"
          },
          "windowEnd": {
            "type": "string",
            "format": "date-time",
            "description": "Exclusive.",
            "example": "2026-10-05T16:00:00Z"
          },
          "assignedDemand": {
            "type": "number",
            "format": "double",
            "example": 12000
          },
          "capacityOverWindow": {
            "type": "number",
            "format": "double",
            "example": 8000
          },
          "shortage": {
            "type": "number",
            "format": "double",
            "example": 4000
          },
          "bottleneckStep": {
            "type": "string",
            "example": "REBIN"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED"
            ],
            "description": "Only PUBLISHED plans with a shortage annotate orders.",
            "example": "PUBLISHED"
          },
          "asOf": {
            "type": "string",
            "format": "date-time",
            "description": "The CloudEvents `time` of the event that last wrote this row (last writer wins per plan id).",
            "example": "2026-10-04T21:45:10Z"
          }
        }
      }
    }
  },
  "isSchema": true
}