{
  "type": "object",
  "required": [
    "rows"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "description": "One row per UTC day bucket. Always present; empty for a window with no data.",
      "items": {
        "type": "object",
        "required": [
          "dayBucket",
          "pathsDefined",
          "pathsRevised",
          "pathsDeactivated"
        ],
        "properties": {
          "dayBucket": {
            "type": "string",
            "format": "date-time",
            "description": "Start (midnight UTC) of the day this row aggregates.",
            "example": "2026-09-01T00:00:00Z"
          },
          "pathsDefined": {
            "type": "integer",
            "format": "int32",
            "description": "ProcessPathCreated events in the day.",
            "example": 2
          },
          "pathsRevised": {
            "type": "integer",
            "format": "int32",
            "description": "ProcessPathUpdated events in the day.",
            "example": 1
          },
          "pathsDeactivated": {
            "type": "integer",
            "format": "int32",
            "description": "ProcessPathDeactivated events in the day.",
            "example": 0
          }
        }
      }
    }
  },
  "isSchema": true
}