{
  "type": "object",
  "required": [
    "items"
  ],
  "description": "One keyset page of process flows (REST guideline section 3.3), ordered by flowId (the unique key).",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flowId",
          "name",
          "stages",
          "status",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "flowId": {
            "type": "string",
            "example": "single-unit-outbound"
          },
          "name": {
            "type": "string",
            "example": "Single-unit outbound"
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pathId",
                "processType"
              ],
              "properties": {
                "pathId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An ACTIVE process path of this service's own catalogue.",
                  "example": "PICK"
                },
                "processType": {
                  "type": "string",
                  "enum": [
                    "PICK",
                    "REBIN",
                    "PACK",
                    "SLAM",
                    "DISPATCH",
                    "ARRIVAL",
                    "RELOCATE",
                    "REPLENISH"
                  ],
                  "description": "The kind of work the stage performs (the task types fulfillment-execution publishes).",
                  "example": "PICK"
                }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RETIRED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Starts at 1 and grows by one per accepted change (a revision that changes something, or the retirement). The same number the flow's events carry.",
            "example": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor of the next page, to be passed back unchanged as `cursor`. Absent on the last page.",
      "example": "eyJzIj...SyJ9"
    }
  },
  "isSchema": true
}