{
  "type": "object",
  "required": [
    "name",
    "stages"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "example": "Single-unit outbound"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "description": "The ordered stages; a pathId appears at most once.",
      "items": {
        "type": "object",
        "required": [
          "pathId",
          "processType"
        ],
        "properties": {
          "pathId": {
            "type": "string",
            "minLength": 1,
            "description": "An ACTIVE process path of this service's own catalogue.",
            "example": "PICK"
          },
          "processType": {
            "type": "string",
            "enum": [
              "PICK",
              "REBIN",
              "PACK",
              "SLAM",
              "DISPATCH",
              "ARRIVAL",
              "RELOCATE",
              "REPLENISH"
            ],
            "description": "The kind of work the stage performs (the task types fulfillment-execution publishes).",
            "example": "PICK"
          }
        }
      }
    }
  }
}