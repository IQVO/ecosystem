{
  "type": "object",
  "required": [
    "siteId",
    "maxDetourM",
    "maxCandidates",
    "hintTtlSeconds",
    "eligibleTaskTypes",
    "verticalWeight",
    "version",
    "declaredAt"
  ],
  "properties": {
    "siteId": {
      "type": "string",
      "example": "SITE-1"
    },
    "maxDetourM": {
      "type": "number",
      "format": "double"
    },
    "maxCandidates": {
      "type": "integer",
      "format": "int32"
    },
    "hintTtlSeconds": {
      "type": "integer",
      "format": "int32"
    },
    "eligibleTaskTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "A task type an interleaving hint may point at.",
        "enum": [
          "PICK",
          "PACK",
          "REBIN",
          "SLAM",
          "RELOCATE",
          "REPLENISH"
        ]
      }
    },
    "verticalWeight": {
      "type": "number",
      "format": "double"
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "description": "Starts at 1, +1 per declaration."
    },
    "declaredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "isSchema": true
}