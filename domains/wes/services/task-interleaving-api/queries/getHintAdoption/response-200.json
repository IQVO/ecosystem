{
  "type": "object",
  "required": [
    "from",
    "to",
    "granularity",
    "days"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range start (inclusive)."
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range end (exclusive)."
    },
    "site_id": {
      "type": "string",
      "description": "The site scope; omitted when the report covers every site."
    },
    "granularity": {
      "type": "string",
      "enum": [
        "day"
      ]
    },
    "days": {
      "type": "array",
      "description": "One dense row per UTC calendar day intersecting the range, zeros included.",
      "items": {
        "type": "object",
        "required": [
          "day",
          "hints_issued",
          "hints_consumed",
          "hints_expired",
          "adoption_rate",
          "consumed_first_rank",
          "mean_detour_m",
          "time_to_consume"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "description": "The UTC calendar day."
          },
          "hints_issued": {
            "type": "integer",
            "minimum": 0,
            "description": "InterleavingHintIssued events that fell in the day's window."
          },
          "hints_consumed": {
            "type": "integer",
            "minimum": 0,
            "description": "InterleavingHintConsumed events that fell in the day's window."
          },
          "hints_expired": {
            "type": "integer",
            "minimum": 0,
            "description": "InterleavingHintExpired events that fell in the day's window."
          },
          "adoption_rate": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": 0,
            "maximum": 1,
            "description": "consumed / (consumed + expired) in the window; null while no hint ended."
          },
          "consumed_first_rank": {
            "type": "integer",
            "minimum": 0,
            "description": "Consumed hints whose candidate was rank 1."
          },
          "mean_detour_m": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "minimum": 0,
            "description": "Mean detour in metres of the consumed candidates; null when none."
          },
          "time_to_consume": {
            "type": "object",
            "required": [
              "count",
              "p50_seconds",
              "p95_seconds"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "description": "Hints consumed in the window whose issue the projection also saw."
              },
              "p50_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "description": "Median seconds from issue to consumption; null when count is 0."
              },
              "p95_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "description": "95th percentile seconds from issue to consumption; null when count is 0."
              }
            }
          }
        }
      }
    }
  },
  "isSchema": true
}