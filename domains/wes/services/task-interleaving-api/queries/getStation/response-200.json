{
  "type": "object",
  "required": [
    "stationId",
    "siteId",
    "position",
    "lastCompletedTaskId",
    "lastCompletedAt",
    "version"
  ],
  "properties": {
    "stationId": {
      "type": "string"
    },
    "siteId": {
      "type": "string"
    },
    "position": {
      "type": "object",
      "description": "Where a station is, as the end location of the last task it completed.",
      "required": [
        "location"
      ],
      "properties": {
        "location": {
          "type": "string",
          "description": "The facility-layout location code."
        },
        "point": {
          "type": "object",
          "description": "A position in the site's local coordinate frame, in metres (facility-layout geometry).",
          "required": [
            "xM",
            "yM",
            "zM"
          ],
          "properties": {
            "xM": {
              "type": "number",
              "format": "double"
            },
            "yM": {
              "type": "number",
              "format": "double"
            },
            "zM": {
              "type": "number",
              "format": "double",
              "description": "Height above floor level."
            }
          }
        }
      }
    },
    "lastCompletedTaskId": {
      "type": "string"
    },
    "lastCompletedAt": {
      "type": "string",
      "format": "date-time"
    },
    "activeHint": {
      "type": "object",
      "description": "The Active hint of a station.",
      "required": [
        "hintId",
        "state",
        "issuedAt",
        "expiresAt",
        "policyVersion",
        "candidates"
      ],
      "properties": {
        "hintId": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "Lifecycle state of a hint. `Active` moves to exactly one terminal state:\n`Consumed` (a candidate was claimed by the hinted station), `Expired`\n(`expiresAt` passed) or `Superseded` (a newer completion at the station\nissued a newer hint, or cleared it).\n",
          "enum": [
            "Active",
            "Consumed",
            "Expired",
            "Superseded"
          ]
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "policyVersion": {
          "type": "integer",
          "format": "int64"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rank",
              "taskId",
              "taskType",
              "location",
              "detourM"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "format": "int32",
                "minimum": 1,
                "description": "1 is the closest; ranked by detourM, then taskId."
              },
              "taskId": {
                "type": "string"
              },
              "taskType": {
                "type": "string",
                "description": "A task type an interleaving hint may point at.",
                "enum": [
                  "PICK",
                  "PACK",
                  "REBIN",
                  "SLAM",
                  "RELOCATE",
                  "REPLENISH"
                ]
              },
              "location": {
                "type": "string",
                "description": "The location the operator must go to first."
              },
              "detourM": {
                "type": "number",
                "format": "double",
                "minimum": 0,
                "description": "Rectilinear detour in metres, rounded to 0.1 m."
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "description": "Starts at 1, +1 per accepted change."
    }
  },
  "isSchema": true
}