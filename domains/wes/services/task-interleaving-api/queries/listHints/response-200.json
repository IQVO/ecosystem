{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hintId",
          "stationId",
          "siteId",
          "state",
          "afterTaskId",
          "originLocation",
          "issuedAt",
          "expiresAt",
          "policyVersion",
          "candidates",
          "version"
        ],
        "properties": {
          "hintId": {
            "type": "string",
            "example": "hint-3b0e8d2a-7c41-4f6a-9d15-2a8b6c4e1f07"
          },
          "stationId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "description": "Lifecycle state of a hint. `Active` moves to exactly one terminal state:\n`Consumed` (a candidate was claimed by the hinted station), `Expired`\n(`expiresAt` passed) or `Superseded` (a newer completion at the station\nissued a newer hint, or cleared it).\n",
            "enum": [
              "Active",
              "Consumed",
              "Expired",
              "Superseded"
            ]
          },
          "afterTaskId": {
            "type": "string",
            "description": "The completed task this hint follows."
          },
          "originLocation": {
            "type": "string",
            "description": "Where the station stood when the hint was issued."
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "issuedAt + the policy's hintTtlSeconds."
          },
          "policyVersion": {
            "type": "integer",
            "format": "int64",
            "description": "The policy version the hint was computed with."
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "description": "In rank order.",
            "items": {
              "type": "object",
              "required": [
                "rank",
                "taskId",
                "taskType",
                "location",
                "detourM"
              ],
              "properties": {
                "rank": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1,
                  "description": "1 is the closest; ranked by detourM, then taskId."
                },
                "taskId": {
                  "type": "string"
                },
                "taskType": {
                  "type": "string",
                  "description": "A task type an interleaving hint may point at.",
                  "enum": [
                    "PICK",
                    "PACK",
                    "REBIN",
                    "SLAM",
                    "RELOCATE",
                    "REPLENISH"
                  ]
                },
                "location": {
                  "type": "string",
                  "description": "The location the operator must go to first."
                },
                "detourM": {
                  "type": "number",
                  "format": "double",
                  "minimum": 0,
                  "description": "Rectilinear detour in metres, rounded to 0.1 m."
                }
              }
            }
          },
          "consumedTaskId": {
            "type": "string",
            "description": "The candidate that was claimed; present only when Consumed."
          },
          "consumedAt": {
            "type": "string",
            "format": "date-time"
          },
          "supersededAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Starts at 1, +1 per accepted transition."
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor for the next page; absent on the last page."
    }
  },
  "isSchema": true
}