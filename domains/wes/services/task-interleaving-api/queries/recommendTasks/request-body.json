{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stationId"
  ],
  "properties": {
    "stationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S",
      "description": "The station to simulate for."
    },
    "fromLocation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S",
      "description": "A what-if origin location code; defaults to the station's recorded position."
    }
  }
}