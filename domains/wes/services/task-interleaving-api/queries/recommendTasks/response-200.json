{
  "type": "object",
  "required": [
    "stationId",
    "siteId",
    "originLocation",
    "policyVersion",
    "candidates"
  ],
  "properties": {
    "stationId": {
      "type": "string"
    },
    "siteId": {
      "type": "string"
    },
    "originLocation": {
      "type": "string"
    },
    "policyVersion": {
      "type": "integer",
      "format": "int64"
    },
    "candidates": {
      "type": "array",
      "description": "In rank order; empty when no hint would be issued.",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "taskId",
          "taskType",
          "location",
          "detourM"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "1 is the closest; ranked by detourM, then taskId."
          },
          "taskId": {
            "type": "string"
          },
          "taskType": {
            "type": "string",
            "description": "A task type an interleaving hint may point at.",
            "enum": [
              "PICK",
              "PACK",
              "REBIN",
              "SLAM",
              "RELOCATE",
              "REPLENISH"
            ]
          },
          "location": {
            "type": "string",
            "description": "The location the operator must go to first."
          },
          "detourM": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Rectilinear detour in metres, rounded to 0.1 m."
          }
        }
      }
    }
  },
  "isSchema": true
}