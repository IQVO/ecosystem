{
  "type": "object",
  "required": [
    "from",
    "to",
    "rows"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time",
      "description": "The effective inclusive start."
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "description": "The effective exclusive end."
    },
    "rows": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "warehouse_id",
              "location"
            ],
            "properties": {
              "warehouse_id": {
                "type": "string",
                "example": "WH-1"
              },
              "location": {
                "type": "string",
                "description": "The planning location (site code).",
                "example": "SIM1"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "bottleneck_step",
              "binding_constraint",
              "plans",
              "share"
            ],
            "properties": {
              "bottleneck_step": {
                "type": "string",
                "example": "REBIN"
              },
              "binding_constraint": {
                "type": "string",
                "description": "The constraint type binding the step (LABOR, STATION, ...); empty when unknown.",
                "example": "LABOR"
              },
              "plans": {
                "type": "integer",
                "minimum": 1,
                "example": 3
              },
              "share": {
                "type": "number",
                "format": "double",
                "minimum": 0,
                "maximum": 1,
                "description": "plans / all published plans of this site in the range.",
                "example": 0.75
              }
            }
          }
        ]
      }
    }
  },
  "isSchema": true
}