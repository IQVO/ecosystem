{
  "type": "object",
  "required": [
    "location",
    "window_start",
    "window_end",
    "orders",
    "released_lines",
    "source",
    "as_of"
  ],
  "properties": {
    "location": {
      "type": "string",
      "example": "SIM1"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "orders": {
      "type": "integer",
      "minimum": 0,
      "description": "Distinct orders whose promise cutoff is in [window_start, window_end).",
      "example": 3
    },
    "released_lines": {
      "type": "integer",
      "minimum": 0,
      "description": "Lines released by those orders' latest allocation pass. NOT units.",
      "example": 6
    },
    "source": {
      "type": "string",
      "enum": [
        "order-management"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "nullable": true,
      "description": "CloudEvents time of the newest order event the site's model reflects (whole site, not only the window); null when none."
    }
  },
  "isSchema": true
}