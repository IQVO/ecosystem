{
  "type": "object",
  "required": [
    "from",
    "to",
    "days",
    "latency"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "type": "string",
      "format": "date-time"
    },
    "days": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "warehouse_id",
              "location"
            ],
            "properties": {
              "warehouse_id": {
                "type": "string",
                "example": "WH-1"
              },
              "location": {
                "type": "string",
                "description": "The planning location (site code).",
                "example": "SIM1"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "day",
              "plans_created",
              "plans_published"
            ],
            "properties": {
              "day": {
                "type": "string",
                "format": "date",
                "example": "2026-10-05"
              },
              "plans_created": {
                "type": "integer",
                "minimum": 0,
                "example": 5
              },
              "plans_published": {
                "type": "integer",
                "minimum": 0,
                "example": 4
              }
            }
          }
        ]
      }
    },
    "latency": {
      "type": "array",
      "items": {
        "allOf": [
          "[Circular]",
          {
            "type": "object",
            "required": [
              "plans",
              "median_seconds",
              "p95_seconds"
            ],
            "properties": {
              "plans": {
                "type": "integer",
                "minimum": 1,
                "description": "Published plans in the range whose creation was also observed.",
                "example": 4
              },
              "median_seconds": {
                "type": "number",
                "format": "double",
                "example": 390
              },
              "p95_seconds": {
                "type": "number",
                "format": "double",
                "example": 1620
              }
            }
          }
        ]
      }
    }
  },
  "isSchema": true
}