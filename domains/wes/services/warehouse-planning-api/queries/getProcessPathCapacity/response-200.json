{
  "type": "object",
  "required": [
    "source",
    "normalized_rate",
    "normalized_unit",
    "bottleneck_step",
    "step_breakdown",
    "warnings"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "flow",
        "local"
      ],
      "readOnly": true,
      "description": "Additive, read-only (docs/adr/0025). Where the path came from: `flow` is a process flow consumed from process-path-management. Since stage 3 retired the local declaration it is the only value that occurs; `local` stays in the enum for readers written against stage 1.\n",
      "example": "flow"
    },
    "normalized_rate": {
      "type": "number",
      "format": "double",
      "example": 1000
    },
    "normalized_unit": {
      "type": "string",
      "example": "ORDER"
    },
    "bottleneck_step": {
      "type": "string",
      "example": "REBIN"
    },
    "step_breakdown": {
      "type": "array",
      "description": "Additive. Each step's composed capacity in path order.",
      "items": {
        "type": "object",
        "required": [
          "step",
          "normalized_rate",
          "binding_constraint"
        ],
        "properties": {
          "step": {
            "type": "string",
            "example": "PACK"
          },
          "normalized_rate": {
            "type": "number",
            "format": "double",
            "description": "The step's effective rate, ORDER per HOUR.",
            "example": 1800
          },
          "binding_constraint": {
            "type": "string",
            "enum": [
              "LABOR",
              "LOCATION",
              "EQUIPMENT",
              "STATION",
              "CONVEYOR",
              "BUFFER",
              "REPLENISHMENT"
            ],
            "example": "STATION"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "description": "Additive. Composition warnings (never null), e.g. stations tallied but no station standard declared.",
      "items": {
        "type": "string"
      }
    }
  },
  "isSchema": true
}