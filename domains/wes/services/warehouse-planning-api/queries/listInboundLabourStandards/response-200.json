{
  "type": "object",
  "description": "One keyset page of inbound labour standards, ordered by location then path id.",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "location",
          "path_id",
          "minutes_per_appointment",
          "minutes_per_asn"
        ],
        "properties": {
          "location": {
            "type": "string",
            "example": "SIM1"
          },
          "path_id": {
            "type": "string",
            "example": "receive"
          },
          "minutes_per_appointment": {
            "type": "number",
            "format": "double",
            "example": 45
          },
          "minutes_per_asn": {
            "type": "number",
            "format": "double",
            "example": 5
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor for the next page; absent on the last page."
    }
  },
  "isSchema": true
}