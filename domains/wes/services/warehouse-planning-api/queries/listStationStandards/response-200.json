{
  "type": "object",
  "description": "One keyset page of station standards, ordered by location then process type.",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "location",
          "process_type",
          "quantity",
          "unit",
          "period_seconds"
        ],
        "properties": {
          "location": {
            "type": "string",
            "example": "SIM1"
          },
          "process_type": {
            "type": "string",
            "example": "PACK"
          },
          "quantity": {
            "type": "number",
            "format": "double",
            "example": 180
          },
          "unit": {
            "type": "string",
            "example": "PACKAGE"
          },
          "period_seconds": {
            "type": "number",
            "format": "double",
            "example": 3600
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor for the next page; absent on the last page."
    }
  },
  "isSchema": true
}