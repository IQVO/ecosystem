{
  "type": "object",
  "required": [
    "rows"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "description": "One row per (pathId, hour bucket). Always present; empty for a window with no data.",
      "items": {
        "type": "object",
        "required": [
          "pathId",
          "hourBucket",
          "workReleased",
          "workUnitCompleted",
          "backlogThresholdBreached",
          "pathThrottled",
          "rateDeviationDetected"
        ],
        "properties": {
          "pathId": {
            "type": "string",
            "description": "Process path of the row.",
            "example": "pick-a"
          },
          "hourBucket": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the UTC hour this row aggregates.",
            "example": "2026-06-01T14:00:00Z"
          },
          "workReleased": {
            "type": "integer",
            "format": "int32",
            "description": "WorkReleased events. Work admitted into the path.",
            "example": 42
          },
          "workUnitCompleted": {
            "type": "integer",
            "format": "int32",
            "description": "WorkUnitCompleted events. Released work finished.",
            "example": 39
          },
          "backlogThresholdBreached": {
            "type": "integer",
            "format": "int32",
            "description": "BacklogThresholdBreached events. The backlog crossed its alarm threshold.",
            "example": 1
          },
          "pathThrottled": {
            "type": "integer",
            "format": "int32",
            "description": "PathThrottled events. Flow balancing throttled upstream release.",
            "example": 0
          },
          "rateDeviationDetected": {
            "type": "integer",
            "format": "int32",
            "description": "RateDeviationDetected events. Reserved: the event is declared but never raised today, so this is always 0.\n",
            "example": 0
          }
        }
      }
    }
  },
  "isSchema": true
}