{
  "type": "object",
  "properties": {
    "pathId": {
      "type": "string",
      "example": "pick-a"
    },
    "totalQuantity": {
      "type": "integer",
      "format": "int64",
      "description": "Sum of all bucket quantities.",
      "example": 6000
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "An exact CPT (Critical Pull Time) and the quantity due at it.",
        "properties": {
          "cpt": {
            "type": "string",
            "format": "date-time",
            "description": "The last moment a parcel in this bucket can be manifested and still make its truck.",
            "example": "2026-08-21T12:00:00Z"
          },
          "quantity": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Units due by this CPT. int64, not int32: the impl and its JSONB store accept quantities across the full 64-bit range.\n",
            "example": 4200
          }
        },
        "required": [
          "cpt",
          "quantity"
        ]
      }
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this forecast was recorded (server clock).",
      "example": "2026-08-21T08:00:00Z"
    }
  },
  "required": [
    "pathId",
    "totalQuantity",
    "buckets",
    "receivedAt"
  ],
  "isSchema": true
}