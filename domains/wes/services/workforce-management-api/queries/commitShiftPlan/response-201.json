{
  "type": "object",
  "required": [
    "siteCode",
    "buildingId",
    "shiftId",
    "lines"
  ],
  "properties": {
    "siteCode": {
      "type": "string",
      "description": "The canonical Site code the plan is keyed by (ADR 0035). The same value as the deprecated buildingId.",
      "example": "WH1"
    },
    "buildingId": {
      "type": "string",
      "deprecated": true,
      "description": "DEPRECATED -- use siteCode. The legacy name of the plan key, kept with the SAME value as siteCode (same stored column) so existing consumers do not break. Removed only by a later, announced breaking ADR.",
      "example": "WH1"
    },
    "shiftId": {
      "type": "string",
      "example": "shift-1"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pathId",
          "plannedHeads",
          "plannedRate",
          "plannedHours"
        ],
        "properties": {
          "pathId": {
            "type": "string",
            "example": "pack"
          },
          "plannedHeads": {
            "type": "integer",
            "example": 3
          },
          "plannedRate": {
            "type": "number",
            "format": "double",
            "example": 30
          },
          "plannedHours": {
            "type": "number",
            "format": "double",
            "example": 24
          }
        }
      }
    }
  },
  "isSchema": true
}