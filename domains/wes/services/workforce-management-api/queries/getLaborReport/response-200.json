{
  "type": "object",
  "required": [
    "rows"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "description": "One row per (pathId, hour bucket). Always present; empty for a window with no data.",
      "items": {
        "type": "object",
        "required": [
          "pathId",
          "hourBucket",
          "shiftsStarted",
          "shiftsEnded",
          "breaks",
          "avgBreakSeconds",
          "certifications",
          "laborAssigned",
          "laborReassigned",
          "understaffingEvents"
        ],
        "properties": {
          "pathId": {
            "type": "string",
            "description": "Process path of the row. The empty string is the building-wide bucket that holds the associate-scoped counters.\n",
            "example": "pack"
          },
          "hourBucket": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the UTC hour this row aggregates.",
            "example": "2026-06-01T14:00:00Z"
          },
          "shiftsStarted": {
            "type": "integer",
            "format": "int32",
            "description": "AssociateShiftStarted events (empty pathId only).",
            "example": 3
          },
          "shiftsEnded": {
            "type": "integer",
            "format": "int32",
            "description": "AssociateShiftEnded events (empty pathId only).",
            "example": 0
          },
          "breaks": {
            "type": "integer",
            "format": "int32",
            "description": "AssociateBreakStarted events (empty pathId only).",
            "example": 2
          },
          "avgBreakSeconds": {
            "type": "number",
            "format": "double",
            "description": "Mean seconds from a break's start to its end, over breaks whose paired end was observed; 0 when none was.\n",
            "example": 300
          },
          "certifications": {
            "type": "integer",
            "format": "int32",
            "description": "AssociateCertified events (empty pathId only).",
            "example": 1
          },
          "laborAssigned": {
            "type": "integer",
            "format": "int32",
            "description": "LaborAssigned events to this path.",
            "example": 12
          },
          "laborReassigned": {
            "type": "integer",
            "format": "int32",
            "description": "LaborReassigned events into this path.",
            "example": 3
          },
          "understaffingEvents": {
            "type": "integer",
            "format": "int32",
            "description": "PathUnderstaffed events for this path.",
            "example": 1
          }
        }
      }
    }
  },
  "isSchema": true
}