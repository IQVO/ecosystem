{
  "type": "object",
  "required": [
    "direction",
    "doorCode",
    "carrier",
    "windowStart",
    "windowEnd"
  ],
  "additionalProperties": false,
  "properties": {
    "direction": {
      "type": "string",
      "enum": [
        "INBOUND",
        "OUTBOUND"
      ]
    },
    "doorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "carrier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "carrierScac": {
      "type": "string",
      "nullable": true,
      "pattern": "^[A-Z]{2,4}$"
    },
    "windowStart": {
      "type": "string",
      "format": "date-time"
    },
    "windowEnd": {
      "type": "string",
      "format": "date-time"
    },
    "asnNumbers": {
      "type": "array",
      "description": "INBOUND only; at least one, distinct.",
      "items": {
        "type": "string"
      }
    },
    "cptId": {
      "type": "string",
      "nullable": true,
      "description": "OUTBOUND only; a cutoff id of the site's CPT schedule."
    },
    "shipmentRefs": {
      "type": "array",
      "description": "OUTBOUND only.",
      "items": {
        "type": "string"
      }
    },
    "expectedSealNumber": {
      "type": "string",
      "nullable": true,
      "description": "The seal the carrier declares when booking."
    }
  }
}