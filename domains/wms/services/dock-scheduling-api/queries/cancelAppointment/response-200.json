{
  "type": "object",
  "required": [
    "appointmentId",
    "siteId",
    "direction",
    "doorCode",
    "carrier",
    "windowStart",
    "windowEnd",
    "state",
    "provenance",
    "version",
    "atRisk"
  ],
  "properties": {
    "appointmentId": {
      "type": "string"
    },
    "siteId": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "INBOUND",
        "OUTBOUND"
      ]
    },
    "doorCode": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "carrierScac": {
      "type": "string",
      "nullable": true
    },
    "windowStart": {
      "type": "string",
      "format": "date-time"
    },
    "windowEnd": {
      "type": "string",
      "format": "date-time"
    },
    "asnNumbers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cptId": {
      "type": "string",
      "nullable": true
    },
    "shipmentRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedSealNumber": {
      "type": "string",
      "nullable": true
    },
    "provenance": {
      "type": "string",
      "enum": [
        "native",
        "legacy-import"
      ]
    },
    "state": {
      "type": "string",
      "description": "`BOOKED -> CHECKED_IN -> COMPLETED`, `BOOKED/CHECKED_IN -> CANCELLED`, `BOOKED -> NO_SHOW`; the last three are terminal.",
      "enum": [
        "BOOKED",
        "CHECKED_IN",
        "COMPLETED",
        "CANCELLED",
        "NO_SHOW"
      ]
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    },
    "eta": {
      "type": "object",
      "nullable": true,
      "allOf": [
        {
          "type": "object",
          "required": [
            "etaAt",
            "reportedAt",
            "source"
          ],
          "properties": {
            "etaAt": {
              "type": "string",
              "format": "date-time"
            },
            "reportedAt": {
              "type": "string",
              "format": "date-time"
            },
            "source": {
              "type": "string"
            }
          }
        }
      ]
    },
    "arrival": {
      "type": "object",
      "nullable": true,
      "allOf": [
        {
          "type": "object",
          "required": [
            "checkedInAt",
            "status",
            "implicit"
          ],
          "properties": {
            "checkedInAt": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "status": {
              "type": "string",
              "enum": [
                "EARLY",
                "ON_TIME",
                "LATE"
              ]
            },
            "visitId": {
              "type": "string",
              "nullable": true
            },
            "implicit": {
              "type": "boolean",
              "description": "True when the arrival is implied by a door release that came before any gate fact."
            }
          }
        }
      ]
    },
    "atRisk": {
      "type": "boolean",
      "description": "True after a late ETA or a door reassignment that overlaps this window; cleared by an on-time ETA or a reschedule."
    },
    "atRiskCause": {
      "type": "string",
      "nullable": true,
      "enum": [
        "LATE_ETA",
        "DOOR_REASSIGNED_OVERLAP"
      ]
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "cancellationReason": {
      "type": "string",
      "nullable": true,
      "enum": [
        "CARRIER_REQUEST",
        "SITE_REQUEST",
        "ASN_CANCELLED",
        "TURNED_AWAY"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "example": {
    "appointmentId": "appt-123e4567-e89b-12d3-a456-426614174000",
    "siteId": "WH1",
    "direction": "INBOUND",
    "doorCode": "WH1-DOCK-IN-01",
    "carrier": "ACME Freight",
    "carrierScac": "ACMF",
    "windowStart": "2026-11-06T08:00:00Z",
    "windowEnd": "2026-11-06T10:00:00Z",
    "asnNumbers": [
      "ASN-1001"
    ],
    "cptId": null,
    "shipmentRefs": [],
    "expectedSealNumber": "SEAL-77120",
    "provenance": "native",
    "state": "BOOKED",
    "version": 1,
    "atRisk": false,
    "completedAt": null,
    "createdAt": "2026-11-05T12:00:00Z",
    "updatedAt": "2026-11-05T12:00:00Z"
  },
  "isSchema": true
}