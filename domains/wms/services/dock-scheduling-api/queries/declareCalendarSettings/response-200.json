{
  "type": "object",
  "required": [
    "siteId",
    "version",
    "settings",
    "operatingHours",
    "closures"
  ],
  "properties": {
    "siteId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
    },
    "settings": {
      "type": "object",
      "required": [
        "maxWindowMinutes",
        "slotGranularityMinutes",
        "arrivalToleranceMinutes",
        "noShowGraceMinutes"
      ],
      "additionalProperties": false,
      "properties": {
        "maxWindowMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "slotGranularityMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "arrivalToleranceMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "noShowGraceMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        }
      }
    },
    "operatingHours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "weekday",
          "opensAt",
          "closesAt",
          "timezone"
        ],
        "additionalProperties": false,
        "properties": {
          "doorCode": {
            "type": "string",
            "nullable": true,
            "description": "The door the row applies to; null is the site default."
          },
          "weekday": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ]
          },
          "opensAt": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "closesAt": {
            "type": "string",
            "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
          },
          "timezone": {
            "type": "string",
            "description": "IANA zone, e.g. America/Sao_Paulo."
          }
        }
      }
    },
    "closures": {
      "type": "array",
      "description": "Scheduled (not lifted) closures.",
      "items": {
        "type": "object",
        "required": [
          "closureId",
          "siteId",
          "doorCode",
          "from",
          "to",
          "reason",
          "lifted"
        ],
        "properties": {
          "closureId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "doorCode": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          },
          "lifted": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "isSchema": true
}