{
  "type": "object",
  "required": [
    "operatingHours"
  ],
  "additionalProperties": false,
  "properties": {
    "operatingHours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "weekday",
          "opensAt",
          "closesAt",
          "timezone"
        ],
        "additionalProperties": false,
        "properties": {
          "doorCode": {
            "type": "string",
            "nullable": true,
            "description": "The door the row applies to; null is the site default."
          },
          "weekday": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ]
          },
          "opensAt": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "closesAt": {
            "type": "string",
            "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
          },
          "timezone": {
            "type": "string",
            "description": "IANA zone, e.g. America/Sao_Paulo."
          }
        }
      }
    }
  }
}