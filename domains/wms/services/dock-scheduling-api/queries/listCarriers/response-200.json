{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scac",
          "name",
          "usdot",
          "mc",
          "status",
          "suspensionReason",
          "suspendedAt",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "scac": {
            "type": "string",
            "pattern": "^[A-Z]{2,4}$",
            "description": "Standard Carrier Alpha Code assigned by NMFTA; the key of the carrier."
          },
          "name": {
            "type": "string"
          },
          "usdot": {
            "type": "string",
            "nullable": true,
            "description": "US Department of Transportation number (up to 8 digits), the safety regulator's registration."
          },
          "mc": {
            "type": "string",
            "nullable": true,
            "description": "Operating authority docket number, `MC<digits>` or `MX<digits>`."
          },
          "status": {
            "type": "string",
            "description": "`ACTIVE <-> SUSPENDED`. Only a SUSPENDED carrier is refused when it books; an unregistered SCAC is accepted.",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "suspensionReason": {
            "type": "string",
            "nullable": true
          },
          "suspendedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "example": {
          "scac": "ACMF",
          "name": "ACME Freight",
          "usdot": "1234567",
          "mc": "MC654321",
          "status": "SUSPENDED",
          "suspensionReason": "insurance lapsed",
          "suspendedAt": "2026-11-10T15:30:00Z",
          "version": 2,
          "createdAt": "2026-11-10T14:00:00Z",
          "updatedAt": "2026-11-10T15:30:00Z"
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "nullable": true
    }
  },
  "isSchema": true
}