{
  "type": "object",
  "description": "A physical corridor scoped to a Zone.",
  "required": [
    "aisleId",
    "zoneId",
    "aisleCode",
    "sequenceHint",
    "direction",
    "status"
  ],
  "properties": {
    "aisleId": {
      "type": "string",
      "description": "`SITE-AREA-ZONE-AISLE` — the first four LocationCode segments.",
      "example": "WH1-STOR-AMB-A07"
    },
    "zoneId": {
      "type": "string",
      "description": "The Zone this aisle is scoped to.",
      "example": "WH1-STOR-AMB"
    },
    "aisleCode": {
      "type": "string",
      "description": "The aisle segment.",
      "example": "A07"
    },
    "sequenceHint": {
      "type": "integer",
      "format": "int64",
      "minimum": 0,
      "description": "Walk-order position. Lower comes earlier on the route.",
      "example": 7
    },
    "direction": {
      "type": "string",
      "description": "Whether an aisle may be traversed in one direction only or both.",
      "enum": [
        "OneWay",
        "TwoWay"
      ],
      "example": "TwoWay"
    },
    "status": {
      "type": "string",
      "description": "The lifecycle state shared by every structural aggregate. Decommission is one-way in v1. UnderMaintenance is a legal persisted state that the read models render; no v1 use case sets it.\n",
      "enum": [
        "Active",
        "UnderMaintenance",
        "Decommissioned"
      ],
      "example": "Active"
    },
    "centreline": {
      "allOf": [
        {
          "type": "object",
          "description": "A straight-line travel centreline between two distinct points (ADR-0017).",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "object",
              "description": "A position in the site's local coordinate frame, in metres (ADR-0017). Z must be non-negative (height above floor level).\n",
              "required": [
                "xM",
                "yM",
                "zM"
              ],
              "properties": {
                "xM": {
                  "type": "number",
                  "format": "double",
                  "example": 12.5
                },
                "yM": {
                  "type": "number",
                  "format": "double",
                  "example": 7.25
                },
                "zM": {
                  "type": "number",
                  "format": "double",
                  "minimum": 0,
                  "example": 0
                }
              }
            },
            "end": "[Circular]"
          }
        }
      ],
      "description": "The aisle's travel centreline, when set (ADR-0017). Absent until SetAisleGeometry is called."
    }
  },
  "isSchema": true
}