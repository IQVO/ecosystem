{
  "type": "object",
  "required": [
    "rows"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "description": "One row per (scope, day bucket), ordered by day bucket then scope. Always present; empty for a window with no data.\n",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "dayBucket",
          "sitesRegistered",
          "zonesRegistered",
          "aislesRegistered",
          "locationTypesRegistered",
          "placementRulesDefined",
          "slotsRegistered",
          "slotsDecommissioned",
          "bulkImports",
          "importRowsSubmitted",
          "importRowsImported",
          "importRowsRejected"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "description": "Site code, zone id, or the empty string for catalog-wide definitions.\n",
            "example": "WH1"
          },
          "dayBucket": {
            "type": "string",
            "format": "date-time",
            "description": "Start (midnight UTC) of the day this row aggregates.",
            "example": "2026-03-01T00:00:00Z"
          },
          "sitesRegistered": {
            "type": "integer",
            "minimum": 0,
            "description": "SiteRegistered events in this bucket.",
            "example": 1
          },
          "zonesRegistered": {
            "type": "integer",
            "minimum": 0,
            "description": "ZoneRegistered events in this bucket.",
            "example": 2
          },
          "aislesRegistered": {
            "type": "integer",
            "minimum": 0,
            "description": "AisleRegistered events in this bucket.",
            "example": 4
          },
          "locationTypesRegistered": {
            "type": "integer",
            "minimum": 0,
            "description": "LocationTypeRegistered events in this bucket.",
            "example": 0
          },
          "placementRulesDefined": {
            "type": "integer",
            "minimum": 0,
            "description": "PlacementRuleDefined events in this bucket.",
            "example": 0
          },
          "slotsRegistered": {
            "type": "integer",
            "minimum": 0,
            "description": "LocationSlotRegistered events in this bucket.",
            "example": 120
          },
          "slotsDecommissioned": {
            "type": "integer",
            "minimum": 0,
            "description": "LocationSlotDecommissioned events in this bucket.",
            "example": 3
          },
          "bulkImports": {
            "type": "integer",
            "minimum": 0,
            "description": "FacilityLayoutImported events in this bucket.",
            "example": 0
          },
          "importRowsSubmitted": {
            "type": "integer",
            "minimum": 0,
            "description": "Rows submitted across this bucket's bulk imports.",
            "example": 0
          },
          "importRowsImported": {
            "type": "integer",
            "minimum": 0,
            "description": "Rows imported across this bucket's bulk imports.",
            "example": 0
          },
          "importRowsRejected": {
            "type": "integer",
            "minimum": 0,
            "description": "Rows rejected across this bucket's bulk imports.",
            "example": 0
          }
        }
      }
    }
  },
  "isSchema": true
}