{
  "type": "object",
  "description": "One Zone's full travel graph (ADR-0017): every waypoint and every directed edge between them, built fresh from its aisles, registered slots, and active cross-aisles.\n",
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One aisle/bay waypoint on the travel graph (ADR-0017).",
        "required": [
          "aisleId",
          "bay"
        ],
        "properties": {
          "aisleId": {
            "type": "string",
            "example": "WH1-STOR-AMB-A07"
          },
          "bay": {
            "type": "string",
            "example": "02"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One directed, weighted connection between two waypoints on the travel graph.",
        "required": [
          "from",
          "to",
          "metresM",
          "estimated"
        ],
        "properties": {
          "from": "[Circular]",
          "to": "[Circular]",
          "metresM": {
            "type": "number",
            "format": "double",
            "description": "The edge's length in metres.",
            "example": 1.2
          },
          "estimated": {
            "type": "boolean",
            "description": "True when this length came from a zone's bay pitch rather than real aisle centreline geometry.",
            "example": false
          }
        }
      }
    }
  },
  "isSchema": true
}