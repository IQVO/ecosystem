{
  "type": "array",
  "items": {
    "type": "object",
    "description": "A site-scoped physical obstacle drawn on the warehouse map — not a location; nothing can be stowed at it (ADR-0017).",
    "required": [
      "id",
      "siteCode",
      "kind",
      "origin",
      "size",
      "label"
    ],
    "properties": {
      "id": {
        "type": "string",
        "example": "STR-1"
      },
      "siteCode": {
        "type": "string",
        "example": "WH1"
      },
      "kind": {
        "type": "string",
        "description": "What kind of physical obstacle a FixedStructure represents (ADR-0017).",
        "enum": [
          "Wall",
          "Column",
          "Office",
          "Conveyor",
          "Other"
        ]
      },
      "origin": {
        "type": "object",
        "description": "A position in the site's local coordinate frame, in metres (ADR-0017). Z must be non-negative (height above floor level).\n",
        "required": [
          "xM",
          "yM",
          "zM"
        ],
        "properties": {
          "xM": {
            "type": "number",
            "format": "double",
            "example": 12.5
          },
          "yM": {
            "type": "number",
            "format": "double",
            "example": 7.25
          },
          "zM": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "example": 0
          }
        }
      },
      "size": {
        "type": "object",
        "description": "A rectangular footprint's extent, in metres (ADR-0017). All three must be strictly positive.",
        "required": [
          "widthM",
          "depthM",
          "heightM"
        ],
        "properties": {
          "widthM": {
            "type": "number",
            "format": "double",
            "exclusiveMinimum": true,
            "minimum": 0,
            "example": 1.2
          },
          "depthM": {
            "type": "number",
            "format": "double",
            "exclusiveMinimum": true,
            "minimum": 0,
            "example": 0.9
          },
          "heightM": {
            "type": "number",
            "format": "double",
            "exclusiveMinimum": true,
            "minimum": 0,
            "example": 2.4
          }
        }
      },
      "label": {
        "type": "string",
        "example": "North wall"
      }
    }
  },
  "isSchema": true
}