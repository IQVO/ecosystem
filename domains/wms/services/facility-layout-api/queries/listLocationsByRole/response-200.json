{
  "type": "object",
  "description": "One keyset page of LocationSlot (REST API guideline 3).",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "The coded leaf location. Its identity IS its LocationCode. It owns whether the code exists, is active, and is legal for a given kind of storage unit — never what is stored in it.\n",
        "required": [
          "locationCode",
          "zoneId",
          "aisleId",
          "coordinates",
          "locationType",
          "role",
          "capacity",
          "status"
        ],
        "properties": {
          "locationCode": {
            "type": "string",
            "description": "The canonical seven-segment code.",
            "example": "WH1-STOR-AMB-A07-03-02-B"
          },
          "zoneId": {
            "type": "string",
            "description": "The Zone the code resolves to.",
            "example": "WH1-STOR-AMB"
          },
          "aisleId": {
            "type": "string",
            "description": "The Aisle the code resolves to.",
            "example": "WH1-STOR-AMB-A07"
          },
          "coordinates": {
            "type": "object",
            "description": "A LocationCode exploded into its seven typed segments, so a renderer can position a slot without re-parsing the code.\n",
            "required": [
              "site",
              "area",
              "zone",
              "aisle",
              "bay",
              "level",
              "position"
            ],
            "properties": {
              "site": {
                "type": "string",
                "description": "The physical facility.",
                "example": "WH1"
              },
              "area": {
                "type": "string",
                "description": "Coarse functional area (STOR, RCV, PACK, STAGE).",
                "example": "STOR"
              },
              "zone": {
                "type": "string",
                "description": "Behavioral class within the area (AMB, CHL, FRZ, HAZ, FWD, RSV, CPK). CPK = case-pick faces whose capacity slotting plans in cases (a convention on this free-form string, not validated here; ADR 0042).",
                "example": "AMB"
              },
              "aisle": {
                "type": "string",
                "description": "Physical corridor.",
                "example": "A07"
              },
              "bay": {
                "type": "string",
                "description": "Bay/section along the aisle.",
                "example": "03"
              },
              "level": {
                "type": "string",
                "description": "Vertical level/shelf.",
                "example": "02"
              },
              "position": {
                "type": "string",
                "description": "Left-to-right slot on that level.",
                "example": "B"
              }
            }
          },
          "locationType": {
            "type": "string",
            "description": "The slot's LocationType.",
            "example": "PalletRack"
          },
          "role": {
            "type": "string",
            "description": "What a location on the map is FOR (ADR-0016). Storage is the default and only role that existed before this ADR; the rest cover non-storage functional locations that previously had no place on the map at all.\n",
            "enum": [
              "Storage",
              "Dock",
              "Yard",
              "WorkCenter",
              "Drop",
              "Staging",
              "QC",
              "Consolidation",
              "Shipping"
            ],
            "example": "Storage"
          },
          "dockFlow": {
            "type": "string",
            "enum": [
              "Inbound",
              "Outbound",
              "Both"
            ],
            "description": "Set only when role is Dock (ADR-0016).",
            "example": "Outbound"
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Pack",
                "Sort",
                "QC",
                "VAS",
                "Deconsolidate",
                "Receive",
                "Kit"
              ]
            },
            "description": "Set only when role is WorkCenter (ADR-0016).",
            "example": [
              "Pack",
              "VAS"
            ]
          },
          "capacity": {
            "type": "object",
            "description": "A capacity envelope as it appears on a READ model. Identical to Capacity except that both dimensions may be 0: a LocationType (and a slot of that type) whose role does not require capacity — Dock, Yard, WorkCenter, QC, Shipping — legitimately reports 0/0, the service's way of saying \"this location holds nothing by design\". Requests still use Capacity, whose dimensions are strictly positive wherever a capacity is supplied at all.\n",
            "required": [
              "maxWeightKg",
              "maxVolumeM3"
            ],
            "properties": {
              "maxWeightKg": {
                "type": "number",
                "format": "double",
                "minimum": 0,
                "description": "Maximum weight in kilograms.",
                "example": 1200
              },
              "maxVolumeM3": {
                "type": "number",
                "format": "double",
                "minimum": 0,
                "description": "Maximum volume in cubic metres.",
                "example": 2.4
              }
            }
          },
          "status": {
            "type": "string",
            "description": "The lifecycle state shared by every structural aggregate. Decommission is one-way in v1. UnderMaintenance is a legal persisted state that the read models render; no v1 use case sets it.\n",
            "enum": [
              "Active",
              "UnderMaintenance",
              "Decommissioned"
            ],
            "example": "Active"
          },
          "position": {
            "allOf": [
              {
                "type": "object",
                "description": "A position in the site's local coordinate frame, in metres (ADR-0017). Z must be non-negative (height above floor level).\n",
                "required": [
                  "xM",
                  "yM",
                  "zM"
                ],
                "properties": {
                  "xM": {
                    "type": "number",
                    "format": "double",
                    "example": 12.5
                  },
                  "yM": {
                    "type": "number",
                    "format": "double",
                    "example": 7.25
                  },
                  "zM": {
                    "type": "number",
                    "format": "double",
                    "minimum": 0,
                    "example": 0
                  }
                }
              }
            ],
            "description": "The slot's physical position, when set (ADR-0017). Absent until SetLocationGeometry is called."
          },
          "dimensions": {
            "allOf": [
              {
                "type": "object",
                "description": "A rectangular footprint's extent, in metres (ADR-0017). All three must be strictly positive.",
                "required": [
                  "widthM",
                  "depthM",
                  "heightM"
                ],
                "properties": {
                  "widthM": {
                    "type": "number",
                    "format": "double",
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "example": 1.2
                  },
                  "depthM": {
                    "type": "number",
                    "format": "double",
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "example": 0.9
                  },
                  "heightM": {
                    "type": "number",
                    "format": "double",
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "example": 2.4
                  }
                }
              }
            ],
            "description": "The slot's physical footprint, when set (ADR-0017). Absent until SetLocationGeometry is called."
          },
          "pickSequence": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Explicit pick-path override, when set (ADR-0017).",
            "example": 42
          },
          "handlingUnit": {
            "type": "string",
            "enum": [
              "EACH",
              "CASE",
              "PALLET"
            ],
            "description": "The unit of handling a slot accepts (ADR-0040). Absent on a slot means none was recorded.\n",
            "example": "CASE"
          },
          "gln": {
            "type": "string",
            "pattern": "^[0-9]{13}$",
            "description": "A GS1 Global Location Number (ADR-0045): 13 digits whose last digit is the GS1 mod-10 check digit of the first twelve (weights 3 and 1, alternating from the right). The pattern only checks the shape; the check digit is verified by the service (422 `invalid-gln`). A GLN identifies exactly one site, zone or slot (409 `gln-already-assigned`). Optional everywhere; omitted when none was recorded.\n",
            "example": "4006381333931"
          },
          "spotKind": {
            "type": "string",
            "enum": [
              "PARKING",
              "HOLDING",
              "REEFER_PLUG",
              "HAZMAT",
              "STAGING_LANE"
            ],
            "description": "What a yard spot is for (ADR-0045). Only meaningful on a slot whose role is `Yard`; omitted when none was recorded.\n",
            "example": "REEFER_PLUG"
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor of the next page; absent on the last page."
    }
  },
  "isSchema": true
}