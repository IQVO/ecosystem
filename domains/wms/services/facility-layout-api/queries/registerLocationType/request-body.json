{
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The type's name.",
      "example": "PalletRack"
    },
    "role": {
      "allOf": [
        {
          "type": "string",
          "description": "What a location on the map is FOR (ADR-0016). Storage is the default and only role that existed before this ADR; the rest cover non-storage functional locations that previously had no place on the map at all.\n",
          "enum": [
            "Storage",
            "Dock",
            "Yard",
            "WorkCenter",
            "Drop",
            "Staging",
            "QC",
            "Consolidation",
            "Shipping"
          ],
          "example": "Storage"
        }
      ],
      "description": "Defaults to Storage when omitted."
    },
    "defaultCapacity": {
      "allOf": [
        {
          "type": "object",
          "description": "A slot's physical envelope. Both dimensions must be strictly positive.",
          "required": [
            "maxWeightKg",
            "maxVolumeM3"
          ],
          "properties": {
            "maxWeightKg": {
              "type": "number",
              "format": "double",
              "minimum": 0,
              "exclusiveMinimum": true,
              "description": "Maximum weight in kilograms.",
              "example": 1200
            },
            "maxVolumeM3": {
              "type": "number",
              "format": "double",
              "minimum": 0,
              "exclusiveMinimum": true,
              "description": "Maximum volume in cubic metres.",
              "example": 2.4
            }
          }
        }
      ],
      "description": "Required for a role whose RequiresCapacity() is true. Omit for Dock, Yard, WorkCenter, QC, or Shipping.\n"
    }
  }
}