{
  "type": "object",
  "required": [
    "centreline"
  ],
  "properties": {
    "centreline": {
      "type": "object",
      "description": "A straight-line travel centreline between two distinct points (ADR-0017).",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "object",
          "description": "A position in the site's local coordinate frame, in metres (ADR-0017). Z must be non-negative (height above floor level).\n",
          "required": [
            "xM",
            "yM",
            "zM"
          ],
          "properties": {
            "xM": {
              "type": "number",
              "format": "double",
              "example": 12.5
            },
            "yM": {
              "type": "number",
              "format": "double",
              "example": 7.25
            },
            "zM": {
              "type": "number",
              "format": "double",
              "minimum": 0,
              "example": 0
            }
          }
        },
        "end": "[Circular]"
      }
    }
  }
}