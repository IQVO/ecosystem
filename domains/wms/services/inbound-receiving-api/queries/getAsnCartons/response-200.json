{
  "type": "object",
  "required": [
    "asnNumber",
    "cartons"
  ],
  "properties": {
    "asnNumber": {
      "type": "string"
    },
    "ownerRef": {
      "type": "string",
      "description": "Opaque tenant tag; omitted for fleet-owned stock."
    },
    "cartons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sscc",
          "kind",
          "contents",
          "status"
        ],
        "properties": {
          "sscc": {
            "type": "string"
          },
          "parentSscc": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "`HOMOGENEOUS_CASE` = one SKU in a case pack; `MIXED` = several SKUs, a\nlogistic unit only (no pack GTIN).\n",
            "enum": [
              "HOMOGENEOUS_CASE",
              "MIXED"
            ]
          },
          "contents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lineNo",
                "sku",
                "gtin",
                "qty"
              ],
              "properties": {
                "lineNo": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1
                },
                "sku": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "gtin": {
                  "type": "string",
                  "description": "GTIN of the content, 8, 12, 13 or 14 digits with a valid GS1 check digit; returned zero-padded to 14."
                },
                "qty": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 1,
                  "description": "Eaches."
                },
                "lot": {
                  "type": "string",
                  "maxLength": 20,
                  "description": "GS1 AI 10."
                },
                "expiry": {
                  "type": "string",
                  "description": "Expiry date, `YYYY-MM-DD`."
                }
              }
            }
          },
          "grossWeightG": {
            "type": "integer",
            "format": "int64"
          },
          "dims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lengthMm",
              "widthMm",
              "heightMm"
            ],
            "properties": {
              "lengthMm": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              },
              "widthMm": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              },
              "heightMm": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "Expected",
              "Accepted",
              "Missing"
            ]
          }
        }
      }
    }
  },
  "isSchema": true
}