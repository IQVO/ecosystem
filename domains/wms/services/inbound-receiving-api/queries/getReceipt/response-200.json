{
  "type": "object",
  "required": [
    "receiptId",
    "asnNumber",
    "state",
    "lines",
    "openedAt",
    "discrepancies",
    "version"
  ],
  "properties": {
    "receiptId": {
      "type": "string",
      "example": "rcpt-223e4567-e89b-12d3-a456-426614174000"
    },
    "asnNumber": {
      "type": "string"
    },
    "appointmentId": {
      "type": "string",
      "description": "Omitted for a walk-in delivery."
    },
    "doorCode": {
      "type": "string",
      "description": "Omitted when the receipt has no appointment."
    },
    "state": {
      "type": "string",
      "enum": [
        "Open",
        "Closed"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lineNo",
          "sku",
          "expectedQty",
          "receivedGood",
          "receivedDamaged"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "format": "int32"
          },
          "sku": {
            "type": "string"
          },
          "expectedQty": {
            "type": "integer",
            "format": "int64"
          },
          "receivedGood": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "receivedDamaged": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      }
    },
    "openedAt": {
      "type": "string",
      "format": "date-time"
    },
    "closedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Present once the receipt is `Closed`."
    },
    "discrepancies": {
      "type": "array",
      "description": "Per line, in line order, one entry per kind (`Short`, `Over`, `Damaged`); empty when everything matches.",
      "items": {
        "type": "object",
        "required": [
          "lineNo",
          "sku",
          "kind",
          "expectedQty",
          "receivedQty",
          "damagedQty"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "format": "int32"
          },
          "sku": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "`Short` = received below expected, `Over` = received above expected,\n`Damaged` = at least one damaged unit.\n",
            "enum": [
              "Short",
              "Over",
              "Damaged"
            ]
          },
          "expectedQty": {
            "type": "integer",
            "format": "int64"
          },
          "receivedQty": {
            "type": "integer",
            "format": "int64",
            "description": "Good plus damaged."
          },
          "damagedQty": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "format": "int64"
    }
  },
  "isSchema": true
}