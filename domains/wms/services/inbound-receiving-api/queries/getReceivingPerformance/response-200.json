{
  "type": "object",
  "required": [
    "from",
    "to",
    "days",
    "current"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range start (inclusive, UTC)."
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range end (exclusive, UTC)."
    },
    "days": {
      "type": "array",
      "description": "One row per UTC day intersecting the range, in day order, zeros included.",
      "items": {
        "type": "object",
        "required": [
          "day",
          "receipts_closed",
          "lines_received",
          "units_good",
          "units_damaged",
          "discrepancies",
          "receipt_cycle",
          "appointments",
          "dock_dwell"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "description": "The UTC calendar day."
          },
          "receipts_closed": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Receipts whose close fell in the day's window."
          },
          "lines_received": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Receiving actions against a line (`ReceiptLineReceived`) in the window."
          },
          "units_good": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Units received in `Good` condition in the window."
          },
          "units_damaged": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Units received in `Damaged` condition in the window."
          },
          "discrepancies": {
            "type": "object",
            "description": "Discrepancies of the receipts closed in the window, by kind.",
            "required": [
              "short",
              "over",
              "damaged"
            ],
            "properties": {
              "short": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "over": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "damaged": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              }
            }
          },
          "receipt_cycle": {
            "type": "object",
            "description": "A duration summary in seconds: how many durations there were and their\nlinear-interpolated median and 95th percentile. The percentiles are\nnull when `count` is 0.\n",
            "required": [
              "count",
              "p50_seconds",
              "p95_seconds"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "p50_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0
              },
              "p95_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0
              }
            }
          },
          "appointments": {
            "type": "object",
            "description": "Appointment milestones that fell in the window.",
            "required": [
              "booked",
              "checked_in",
              "cancelled",
              "completed"
            ],
            "properties": {
              "booked": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "checked_in": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "cancelled": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "completed": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              }
            }
          },
          "dock_dwell": "[Circular]"
        }
      }
    },
    "current": {
      "type": "object",
      "description": "The state right now (not range-bound).",
      "required": [
        "open_receipts",
        "expected_today",
        "expected_today_started"
      ],
      "properties": {
        "open_receipts": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "Receipts opened and not yet closed."
        },
        "expected_today": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "ASNs not cancelled whose expected arrival falls in today's UTC day."
        },
        "expected_today_started": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "Of those, the ASNs that already have a receipt opened."
        }
      }
    }
  },
  "isSchema": true
}