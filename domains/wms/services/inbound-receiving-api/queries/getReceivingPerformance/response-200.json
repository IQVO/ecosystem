{
  "type": "object",
  "required": [
    "from",
    "to",
    "dock_to_stock_target_seconds",
    "days",
    "current"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range start (inclusive, UTC)."
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range end (exclusive, UTC)."
    },
    "dock_to_stock_target_seconds": {
      "type": "integer",
      "format": "int32",
      "description": "The dock-to-stock target the days' `share_under_target` is measured against, 11160 s (3.1 h, WERC best-in-class; ADR 0021)."
    },
    "days": {
      "type": "array",
      "description": "One row per UTC day intersecting the range, in day order, zeros included.",
      "items": {
        "type": "object",
        "required": [
          "day",
          "receipts_closed",
          "lines_received",
          "units_good",
          "units_damaged",
          "discrepancies",
          "receipt_cycle",
          "appointments",
          "dock_dwell",
          "dock_to_stock",
          "advice",
          "asn_timeliness"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "description": "The UTC calendar day."
          },
          "receipts_closed": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Receipts whose close fell in the day's window."
          },
          "lines_received": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Receiving actions against a line (`ReceiptLineReceived`) in the window."
          },
          "units_good": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Units received in `Good` condition in the window."
          },
          "units_damaged": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Units received in `Damaged` condition in the window."
          },
          "discrepancies": {
            "type": "object",
            "description": "Discrepancies of the receipts closed in the window, by kind.",
            "required": [
              "short",
              "over",
              "damaged"
            ],
            "properties": {
              "short": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "over": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "damaged": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              }
            }
          },
          "receipt_cycle": {
            "type": "object",
            "description": "A duration summary in seconds: how many durations there were and their\nlinear-interpolated median and 95th percentile. The percentiles are\nnull when `count` is 0.\n",
            "required": [
              "count",
              "p50_seconds",
              "p95_seconds"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "p50_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0
              },
              "p95_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0
              }
            }
          },
          "appointments": {
            "type": "object",
            "description": "Appointment milestones that fell in the window.",
            "required": [
              "booked",
              "checked_in",
              "cancelled",
              "completed"
            ],
            "properties": {
              "booked": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "checked_in": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "cancelled": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "completed": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              }
            }
          },
          "dock_dwell": "[Circular]",
          "dock_to_stock": {
            "type": "object",
            "description": "The dock-to-stock facts (ADR 0021) of the receipts whose last Good\ncarton was stowed in the window: gate arrival to last stow, in\nseconds, never negative.\n",
            "required": [
              "count",
              "p50_seconds",
              "p90_seconds",
              "under_target",
              "share_under_target"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "p50_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "description": "Median; null when count is 0."
              },
              "p90_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "description": "90th percentile; null when count is 0."
              },
              "under_target": {
                "type": "integer",
                "format": "int32",
                "minimum": 0,
                "description": "Facts at or under dock_to_stock_target_seconds."
              },
              "share_under_target": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "maximum": 1,
                "description": "under_target / count; null when count is 0."
              }
            }
          },
          "advice": {
            "type": "object",
            "description": "The receiving advices (ADR 0023) issued in the window: how many, and how\nmany inside the committed window after the last unit received\n(`RECEIVING_ADVICE_SLA`, default 24 h). The KPI \"% receipts with advice\ninside the SLA\" is `share_within_sla`.\n",
            "required": [
              "count",
              "within_sla",
              "share_within_sla"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "format": "int32",
                "minimum": 0,
                "description": "Advices issued (`ReceivingAdviceIssued`) in the window, by the UTC day of their `issued_at`."
              },
              "within_sla": {
                "type": "integer",
                "format": "int32",
                "minimum": 0,
                "description": "Of those, how many had `within_sla` true."
              },
              "share_within_sla": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "maximum": 1,
                "description": "within_sla / count; null when count is 0."
              }
            }
          },
          "asn_timeliness": {
            "type": "array",
            "description": "The day's per-supplier ASN timeliness (ADR 0025), biggest\n`registered` first, ties by `supplier_ref` ascending, at most the\ntop ten suppliers of the day; `[]` when none registered.\n",
            "items": {
              "type": "object",
              "description": "One supplier's ASN timeliness of a day (ADR 0025): how many of the\nday's ASNs were registered for it (counted in the UTC day of the ASN's\n`registered_at`) and how many of those were registered after the visit\nthey were received under had arrived (`AsnLateForArrival`). The KPI\n\"% ASNs received before arrival\" is `share_on_time`.\n",
              "required": [
                "supplier_ref",
                "registered",
                "late",
                "share_on_time"
              ],
              "properties": {
                "supplier_ref": {
                  "type": "string",
                  "description": "The supplier the ASNs were registered for."
                },
                "registered": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0,
                  "description": "ASNs of this supplier registered in the day (by `registered_at`)."
                },
                "late": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0,
                  "description": "Of those, how many were late for their visit's arrival."
                },
                "share_on_time": {
                  "type": "number",
                  "format": "double",
                  "nullable": true,
                  "minimum": 0,
                  "maximum": 1,
                  "description": "1 - late / registered; null when registered is 0."
                }
              }
            }
          }
        }
      }
    },
    "current": {
      "type": "object",
      "description": "The state right now (not range-bound).",
      "required": [
        "open_receipts",
        "expected_today",
        "expected_today_started"
      ],
      "properties": {
        "open_receipts": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "Receipts opened and not yet closed."
        },
        "expected_today": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "ASNs not cancelled whose expected arrival falls in today's UTC day."
        },
        "expected_today_started": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "Of those, the ASNs that already have a receipt opened."
        }
      }
    }
  },
  "isSchema": true
}