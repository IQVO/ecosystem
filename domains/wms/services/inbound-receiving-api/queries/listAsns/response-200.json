{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asnNumber",
          "supplierRef",
          "state",
          "lines",
          "version"
        ],
        "properties": {
          "asnNumber": {
            "type": "string",
            "example": "ASN-1001"
          },
          "supplierRef": {
            "type": "string"
          },
          "expectedArrival": {
            "type": "string",
            "format": "date-time",
            "description": "Omitted when the supplier gave none."
          },
          "state": {
            "type": "string",
            "description": "ASN lifecycle. `Cancelled` and `Closed` are terminal.",
            "enum": [
              "Registered",
              "Receiving",
              "Closed",
              "Cancelled"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lineNo",
                "sku",
                "expectedQty"
              ],
              "properties": {
                "lineNo": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1,
                  "description": "1-based; lines are numbered exactly 1..n in order."
                },
                "sku": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "1 to 64 characters without whitespace, control characters or `/`."
                },
                "expectedQty": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            }
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Starts at 1, +1 per accepted change."
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor for the next page; absent on the last page."
    }
  },
  "isSchema": true
}