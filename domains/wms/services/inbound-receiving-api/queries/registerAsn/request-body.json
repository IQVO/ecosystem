{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asnNumber",
    "supplierRef",
    "lines"
  ],
  "properties": {
    "asnNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "supplierRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Non-blank supplier reference."
    },
    "expectedArrival": {
      "type": "string",
      "format": "date-time",
      "description": "Optional announced arrival."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineNo",
          "sku",
          "expectedQty"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "1-based; lines are numbered exactly 1..n in order."
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "1 to 64 characters without whitespace, control characters or `/`."
          },
          "expectedQty": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      }
    }
  }
}