{
  "type": "object",
  "required": [
    "asnNumber",
    "supplierRef",
    "state",
    "lines",
    "version"
  ],
  "properties": {
    "asnNumber": {
      "type": "string",
      "example": "ASN-1001"
    },
    "supplierRef": {
      "type": "string"
    },
    "expectedArrival": {
      "type": "string",
      "format": "date-time",
      "description": "Omitted when the supplier gave none."
    },
    "state": {
      "type": "string",
      "description": "ASN lifecycle. `Cancelled` and `Closed` are terminal.",
      "enum": [
        "Registered",
        "Receiving",
        "Closed",
        "Cancelled"
      ]
    },
    "ownerRef": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineNo",
          "sku",
          "expectedQty"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "1-based; lines are numbered exactly 1..n in order."
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "1 to 64 characters without whitespace, control characters or `/`."
          },
          "expectedQty": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      }
    },
    "cartons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sscc",
          "kind",
          "contents"
        ],
        "properties": {
          "sscc": {
            "type": "string",
            "pattern": "^[0-9]{18}$",
            "description": "SSCC-18 with a valid GS1 check digit; unique per site."
          },
          "parentSscc": {
            "type": "string",
            "pattern": "^[0-9]{18}$",
            "description": "The pallet SSCC, when the carton is on one."
          },
          "kind": {
            "type": "string",
            "description": "`HOMOGENEOUS_CASE` = one SKU in a case pack; `MIXED` = several SKUs, a\nlogistic unit only (no pack GTIN).\n",
            "enum": [
              "HOMOGENEOUS_CASE",
              "MIXED"
            ]
          },
          "contents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lineNo",
                "sku",
                "gtin",
                "qty"
              ],
              "properties": {
                "lineNo": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1
                },
                "sku": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "gtin": {
                  "type": "string",
                  "description": "GTIN of the content, 8, 12, 13 or 14 digits with a valid GS1 check digit; returned zero-padded to 14."
                },
                "qty": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 1,
                  "description": "Eaches."
                },
                "lot": {
                  "type": "string",
                  "maxLength": 20,
                  "description": "GS1 AI 10."
                },
                "expiry": {
                  "type": "string",
                  "description": "Expiry date, `YYYY-MM-DD`."
                }
              }
            }
          },
          "grossWeightG": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Declared gross weight in grams."
          },
          "dims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lengthMm",
              "widthMm",
              "heightMm"
            ],
            "properties": {
              "lengthMm": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              },
              "widthMm": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              },
              "heightMm": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "description": "Starts at 1, +1 per accepted change."
    }
  },
  "isSchema": true
}