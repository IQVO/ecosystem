{
  "type": "object",
  "description": "The Inventory Flow & Accuracy report for a window.",
  "required": [
    "rows"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One (SKU, bin, hour) bucket of flow and accuracy counters.\n",
        "properties": {
          "sku": {
            "type": "string",
            "example": "SKU-1"
          },
          "binId": {
            "type": "string",
            "example": "A-1-1"
          },
          "hourBucket": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the UTC hour this row aggregates, RFC 3339.",
            "example": "2026-10-01T14:00:00Z"
          },
          "receivedQuantity": {
            "type": "integer",
            "description": "Units received (StockReceived) in the bucket.",
            "example": 10
          },
          "stowedCount": {
            "type": "integer",
            "description": "Stow operations (StockStowed) in the bucket.",
            "example": 1
          },
          "pickedQuantity": {
            "type": "integer",
            "description": "Units picked (StockPicked) in the bucket.",
            "example": 4
          },
          "reservationsCreated": {
            "type": "integer",
            "example": 1
          },
          "reservationsExpired": {
            "type": "integer",
            "example": 0
          },
          "reservationsRevoked": {
            "type": "integer",
            "example": 0
          },
          "cycleCountsCompleted": {
            "type": "integer",
            "example": 0
          },
          "discrepanciesDetected": {
            "type": "integer",
            "example": 0
          },
          "unlocatedCount": {
            "type": "integer",
            "example": 0
          }
        }
      }
    }
  },
  "isSchema": true
}