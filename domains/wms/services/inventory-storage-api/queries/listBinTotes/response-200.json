{
  "type": "object",
  "required": [
    "items"
  ],
  "description": "One keyset page of totes (REST guideline section 3.3), ordered by LPN.\n",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lpn"
        ],
        "description": "A tote in a bin listing (no contents).",
        "properties": {
          "lpn": {
            "type": "string",
            "example": "TOTE-000123"
          },
          "siteId": {
            "type": "string",
            "example": "WH1"
          },
          "binId": {
            "type": "string",
            "example": "WH1-AUTO-ASRS-ASRS1-00-00-S"
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor of the next page, to be passed back unchanged as `cursor`. Absent on the last page.\n"
    }
  },
  "isSchema": true
}