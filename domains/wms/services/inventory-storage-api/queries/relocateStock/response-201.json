{
  "type": "object",
  "description": "An applied intra-site relocation (ADR 0039). Immutable.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Relocation id, formatted `rel-<uuid>`.",
      "example": "rel-0b7e2a54-3c1d-4f0e-9a8b-7c6d5e4f3a21"
    },
    "siteCode": {
      "type": "string",
      "example": "WH1"
    },
    "sku": {
      "type": "string",
      "example": "SKU-1"
    },
    "fromBin": {
      "type": "string",
      "example": "WH1-STOR-AMB-A07-03-02-B"
    },
    "toBin": {
      "type": "string",
      "example": "WH1-STOR-AMB-A01-01-01-A"
    },
    "quantity": {
      "type": "integer",
      "format": "int32",
      "example": 12
    },
    "reason": {
      "type": "string",
      "enum": [
        "SLOTTING",
        "CONSOLIDATION",
        "MANUAL"
      ],
      "example": "SLOTTING"
    },
    "sourceRef": {
      "type": "string",
      "description": "The caller's correlation; empty when none was given.",
      "example": "plan-7/move-2"
    },
    "destinationStockUnitId": {
      "type": "string",
      "description": "The StockUnit created in toBin (site custody = siteCode).",
      "example": "su-9a1e0f3c-2b4d-4c6e-8f00-112233445566"
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One source StockUnit's contribution to the move.",
        "properties": {
          "stockUnitId": {
            "type": "string",
            "example": "su-164710cb-5e14-400b-849c-ed94d8256c6b"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "example": 12
          }
        }
      }
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "example": "2026-10-13T12:00:00Z"
    }
  },
  "isSchema": true
}