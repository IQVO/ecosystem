{
  "type": "object",
  "description": "RFC 7807 problem for a QUARANTINED destination scan (ADR 0031): the standard members plus an `exception` extension object carrying the inventory_exceptions row's coordinates. The scan raised no stock; a human resolves the exception.",
  "properties": {
    "type": {
      "type": "string",
      "example": "https://errors.inventory-storage.warehouse-systems.dev/transfer-scan-quarantined"
    },
    "title": {
      "type": "string",
      "example": "Destination scan quarantined"
    },
    "status": {
      "type": "integer",
      "example": 422
    },
    "detail": {
      "type": "string",
      "description": "The explicit problem (why the scan could not be matched).",
      "example": "transfer line was never allocated by this service"
    },
    "instance": {
      "type": "string",
      "example": "/transfers/tl-ghost/receipt"
    },
    "exception": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "UNKNOWN_TRANSFER",
            "UNRECOGNIZED_TRANSFER"
          ],
          "example": "UNKNOWN_TRANSFER"
        },
        "transferId": {
          "type": "string",
          "example": "tr-ghost"
        },
        "transferLineId": {
          "type": "string",
          "example": "tl-ghost"
        },
        "destinationSiteId": {
          "type": "string",
          "example": "SITE-DEST"
        },
        "sku": {
          "type": "string",
          "example": "SKU-T1"
        },
        "receivedQuantity": {
          "type": "integer",
          "format": "int32",
          "example": 5
        }
      }
    }
  },
  "isSchema": true
}