{
  "type": "object",
  "description": "A quantity of a SKU at a specific bin.",
  "properties": {
    "id": {
      "type": "string",
      "description": "StockUnit id, formatted `su-<uuid>`.",
      "example": "su-164710cb-5e14-400b-849c-ed94d8256c6b"
    },
    "sku": {
      "type": "string",
      "example": "SKU-1"
    },
    "binId": {
      "type": "string",
      "example": "A-1-1"
    },
    "quantity": {
      "type": "integer",
      "format": "int32",
      "description": "Total on-hand quantity at this bin.",
      "example": 10
    },
    "reserved": {
      "type": "integer",
      "format": "int32",
      "description": "Portion of quantity currently bound to a Reservation.",
      "example": 0
    },
    "state": {
      "type": "string",
      "description": "Lifecycle state of the unit.",
      "enum": [
        "AVAILABLE",
        "RESERVED",
        "PICKED",
        "REMOVED",
        "UNLOCATED"
      ],
      "example": "AVAILABLE"
    }
  },
  "isSchema": true
}