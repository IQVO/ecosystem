{
  "type": "object",
  "required": [
    "bins"
  ],
  "description": "The destination placements for a STAGED transfer receipt (ADR 0031). The quantities must sum exactly to the receipt's receivedQuantity; every bin must belong to the receipt's destination site.",
  "properties": {
    "bins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "binId",
          "quantity"
        ],
        "properties": {
          "binId": {
            "type": "string",
            "minLength": 1,
            "example": "BIN-DEST-1"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "example": 3
          }
        }
      }
    }
  }
}