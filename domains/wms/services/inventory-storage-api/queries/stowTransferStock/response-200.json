{
  "type": "object",
  "description": "The STOWED receipt plus the destination StockUnits the stow created.",
  "allOf": [
    {
      "type": "object",
      "description": "The destination-side custody record for one transfer line (ADR 0031), keyed DB-unique on transferLineId. STAGED means counted but not yet placed (no usable stock); STOWED means placed — the destination site's usable rose exactly once.",
      "properties": {
        "transferId": {
          "type": "string",
          "example": "tr-77"
        },
        "transferLineId": {
          "type": "string",
          "example": "tr-77:1"
        },
        "destinationSiteId": {
          "type": "string",
          "example": "SITE-DEST"
        },
        "sku": {
          "type": "string",
          "example": "SKU-T1"
        },
        "expectedQuantity": {
          "type": "integer",
          "format": "int32",
          "description": "What the transfer_allocations ledger promised (its requested_quantity).",
          "example": 6
        },
        "receivedQuantity": {
          "type": "integer",
          "format": "int32",
          "description": "What was physically counted at the dock.",
          "example": 5
        },
        "variance": {
          "type": "integer",
          "format": "int32",
          "description": "SIGNED received - expected. Positive = over-receipt, negative = short-receipt, 0 = exact. Explicit, never silently absorbed.",
          "example": -1
        },
        "state": {
          "type": "string",
          "enum": [
            "STAGED",
            "STOWED"
          ],
          "example": "STAGED"
        },
        "stagedAt": {
          "type": "string",
          "format": "date-time",
          "example": "2026-10-06T12:00:00Z"
        },
        "stowedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Present only once STOWED.",
          "example": "2026-10-06T12:05:00Z"
        },
        "replay": {
          "type": "boolean",
          "description": "True when this response is the ORIGINAL outcome of an idempotent replay, with nothing new written or published.",
          "example": false
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "stowedQuantity": {
          "type": "integer",
          "format": "int32",
          "description": "Total quantity placed (equals receivedQuantity).",
          "example": 5
        },
        "allocations": {
          "type": "array",
          "description": "One entry per destination StockUnit created, with its bin.",
          "items": {
            "type": "object",
            "properties": {
              "stockUnitId": {
                "type": "string",
                "example": "su-dest-1"
              },
              "binId": {
                "type": "string",
                "example": "BIN-DEST-1"
              },
              "quantity": {
                "type": "integer",
                "format": "int32",
                "example": 3
              }
            }
          }
        }
      }
    }
  ],
  "isSchema": true
}