{
  "type": "object",
  "properties": {
    "short_ships": {
      "type": "array",
      "description": "Packages deliberately left off the load, each with a reason; recorded on the load.",
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "reason"
        ],
        "properties": {
          "package_id": {
            "type": "string",
            "minLength": 1,
            "examples": [
              "pkg-1029"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why the package is not going (e.g. `DIVERTED`, `DAMAGED`, `NO-STOCK`).",
            "examples": [
              "DIVERTED"
            ]
          }
        }
      }
    }
  }
}