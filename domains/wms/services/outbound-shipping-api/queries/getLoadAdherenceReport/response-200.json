{
  "type": "object",
  "required": [
    "rows"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "site_id",
          "cpt_id",
          "operating_date",
          "loads_closed",
          "loads_total",
          "packages_missed",
          "adherence"
        ],
        "properties": {
          "site_id": {
            "type": "string",
            "minLength": 1,
            "examples": [
              "SITE-1"
            ]
          },
          "cpt_id": {
            "type": "string",
            "minLength": 1,
            "description": "The cutoff (CPT) id from the local CPT schedule copy.",
            "examples": [
              "cpt-1600"
            ]
          },
          "operating_date": {
            "type": "string",
            "format": "date"
          },
          "loads_closed": {
            "type": "integer",
            "minimum": 0,
            "description": "Loads closed at or before their cutoff."
          },
          "loads_total": {
            "type": "integer",
            "minimum": 0
          },
          "packages_missed": {
            "type": "integer",
            "minimum": 0,
            "description": "Distinct packages that raised PackageMissedLoad."
          },
          "adherence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "loads_closed / loads_total (0 when loads_total is 0)."
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "isSchema": true
}