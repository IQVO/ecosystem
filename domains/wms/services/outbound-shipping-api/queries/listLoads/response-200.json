{
  "type": "object",
  "required": [
    "items",
    "nextCursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "site_id",
          "cpt_id",
          "operating_date",
          "ship_method",
          "cutoff",
          "state",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "examples": [
              "load-7f3a"
            ]
          },
          "site_id": {
            "type": "string",
            "minLength": 1,
            "examples": [
              "SITE-1"
            ]
          },
          "cpt_id": {
            "type": "string",
            "minLength": 1,
            "description": "The cutoff (CPT) id from the local CPT schedule copy.",
            "examples": [
              "cpt-1600"
            ]
          },
          "operating_date": {
            "type": "string",
            "format": "date"
          },
          "ship_method": {
            "type": "string",
            "minLength": 1,
            "description": "Carrier ship method (carrier + service level).",
            "examples": [
              "STDOUT-2DAY"
            ]
          },
          "cutoff": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string",
            "enum": [
              "PLANNED",
              "LOADING",
              "CLOSED",
              "SHIP_CONFIRMED",
              "CANCELLED"
            ]
          },
          "door_code": {
            "type": "string",
            "description": "Assigned door, once an outbound appointment named the cpt."
          },
          "trailer_id": {
            "type": "string",
            "description": "The docked trailer attached to the load."
          },
          "appointment_id": {
            "type": "string"
          },
          "short_ships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "package_id",
                "reason"
              ],
              "properties": {
                "package_id": {
                  "type": "string",
                  "minLength": 1,
                  "examples": [
                    "pkg-1029"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Why the package is not going (e.g. `DIVERTED`, `DAMAGED`, `NO-STOCK`).",
                  "examples": [
                    "DIVERTED"
                  ]
                }
              }
            }
          },
          "package_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Loaded packages at close."
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Aggregate version after the last change."
          }
        }
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "description": "Cursor of the next page (R7); null after the last."
    }
  },
  "isSchema": true
}