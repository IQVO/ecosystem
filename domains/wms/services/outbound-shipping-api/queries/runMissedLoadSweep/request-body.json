{
  "type": "object",
  "required": [
    "site_id"
  ],
  "properties": {
    "site_id": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "SITE-1"
      ]
    },
    "cutoff": {
      "type": "string",
      "format": "date-time",
      "description": "Sweep everything at or before this cutoff; defaults to now."
    }
  }
}