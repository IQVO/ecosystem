{
  "type": "object",
  "required": [
    "id",
    "site_id",
    "state",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "pkg-1029"
      ]
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "SITE-1"
      ]
    },
    "source_order_id": {
      "type": "string",
      "description": "order-management OrderId from PackageManifested (ADR 0003); omitted when the producer did not know it."
    },
    "work_unit_ref": {
      "type": "string",
      "description": "The manifested order_ref, stored verbatim and never parsed."
    },
    "load_id": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "load-7f3a"
      ]
    },
    "staging_location": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "EXPECTED",
        "STAGED",
        "LOADED",
        "SHIPPED",
        "SHORT_SHIPPED"
      ]
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    }
  },
  "isSchema": true
}