{
  "type": "object",
  "required": [
    "bol_number",
    "load_id",
    "site_id",
    "carrier",
    "seal_number",
    "package_count",
    "state",
    "version"
  ],
  "properties": {
    "bol_number": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "BOL-2026-11-06-0042"
      ]
    },
    "load_id": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "load-7f3a"
      ]
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "SITE-1"
      ]
    },
    "carrier": {
      "type": "string"
    },
    "carrier_scac": {
      "type": "string",
      "description": "Nullable on the source appointment; omitted when null."
    },
    "trailer_id": {
      "type": "string"
    },
    "seal_number": {
      "type": "string",
      "description": "The seal yard-management recorded on departure (ErrSealMissing without it)."
    },
    "package_count": {
      "type": "integer",
      "minimum": 1
    },
    "total_weight_g": {
      "type": "number",
      "description": "Sum of the shipped packages' weight_g, when known."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time"
    },
    "void_reason": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "ISSUED",
        "VOIDED"
      ]
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    }
  },
  "isSchema": true
}