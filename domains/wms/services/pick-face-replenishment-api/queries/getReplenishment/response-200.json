{
  "type": "object",
  "required": [
    "requestId",
    "siteId",
    "sku",
    "forwardBin",
    "sourceBin",
    "quantity",
    "priority",
    "state",
    "policyMin",
    "policyMax",
    "requestedAt",
    "version"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "example": "repl-3b0e8d2a-7c41-4f6a-9d15-2a8b6c4e1f07"
    },
    "siteId": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "forwardBin": {
      "type": "string",
      "description": "The pick face to fill."
    },
    "sourceBin": {
      "type": "string",
      "description": "The reserve bin the stock comes from."
    },
    "quantity": {
      "type": "integer",
      "format": "int64",
      "minimum": 1,
      "description": "Units planned to move."
    },
    "movedQuantity": {
      "type": "integer",
      "format": "int64",
      "minimum": 1,
      "description": "Units the relocation moved; present once Completed."
    },
    "priority": {
      "type": "string",
      "description": "`URGENT` when the pick face had nothing available (`onHand - reserved <= 0`) at detection, else `NORMAL`.",
      "enum": [
        "NORMAL",
        "URGENT"
      ]
    },
    "state": {
      "type": "string",
      "description": "Lifecycle state of a request. `Completed` and `Cancelled` are final.",
      "enum": [
        "Requested",
        "Completed",
        "Cancelled"
      ]
    },
    "policyMin": {
      "type": "integer",
      "format": "int64",
      "minimum": 0,
      "description": "The policy minimum at detection."
    },
    "policyMax": {
      "type": "integer",
      "format": "int64",
      "minimum": 1,
      "description": "The policy maximum at detection."
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time"
    },
    "cancelReason": {
      "type": "string",
      "description": "`OPERATOR`: cancelled through this API. `ASSIGNMENT_CHANGED`: a newer\napproved slot plan no longer assigns the SKU to the forward bin.\n`POLICY_REMOVED`: the policy was removed.\n",
      "enum": [
        "OPERATOR",
        "ASSIGNMENT_CHANGED",
        "POLICY_REMOVED"
      ]
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "minimum": 1,
      "description": "Starts at 1, +1 per accepted transition."
    }
  },
  "isSchema": true
}