{
  "type": "object",
  "required": [
    "from",
    "to",
    "granularity",
    "days"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range start (inclusive)."
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range end (exclusive)."
    },
    "site_id": {
      "type": "string",
      "description": "The site scope; omitted when the report covers every site."
    },
    "granularity": {
      "type": "string",
      "enum": [
        "day"
      ]
    },
    "days": {
      "type": "array",
      "description": "One dense row per UTC calendar day intersecting the range, zeros included.",
      "items": {
        "type": "object",
        "required": [
          "day",
          "requests_raised",
          "units_requested",
          "requests_completed",
          "units_replenished",
          "requests_cancelled",
          "completion_latency",
          "policies_declared"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "description": "The UTC calendar day."
          },
          "requests_raised": {
            "type": "integer",
            "minimum": 0,
            "description": "ReplenishmentRequested events that fell in the day's window."
          },
          "units_requested": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Total quantity of those requests."
          },
          "requests_completed": {
            "type": "integer",
            "minimum": 0,
            "description": "ReplenishmentCompleted events that fell in the day's window."
          },
          "units_replenished": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Total quantity moved by those completions."
          },
          "requests_cancelled": {
            "type": "integer",
            "minimum": 0,
            "description": "ReplenishmentCancelled events that fell in the day's window."
          },
          "completion_latency": {
            "type": "object",
            "description": "The requested-to-completed durations of one day's completed requests (linear-interpolated percentiles).",
            "required": [
              "count",
              "p50_seconds",
              "p95_seconds"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "p50_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "description": "Null when count is 0."
              },
              "p95_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "description": "Null when count is 0."
              }
            }
          },
          "policies_declared": {
            "type": "integer",
            "minimum": 0,
            "description": "Policy versions declared (ReplenishmentPolicyDeclared) in the day's window."
          }
        }
      }
    }
  },
  "isSchema": true
}