{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handlingTags"
  ],
  "properties": {
    "handlingTags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Closed set of handling tags.",
        "enum": [
          "Hazmat",
          "Fragile",
          "TemperatureSensitive",
          "Oversized",
          "HighValue"
        ]
      }
    },
    "temperatureClass": {
      "type": "string",
      "description": "Storage temperature band required by a TemperatureSensitive product.",
      "enum": [
        "Ambient",
        "Chilled",
        "Frozen"
      ]
    },
    "dotHazardClass": {
      "type": "integer",
      "format": "int32",
      "minimum": 1,
      "maximum": 9,
      "nullable": true,
      "description": "Optional top-level US DOT hazard class; only allowed with Hazmat."
    }
  }
}