{
  "type": "object",
  "required": [
    "from",
    "to",
    "days",
    "coverage"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range start (inclusive, UTC)."
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range end (exclusive, UTC)."
    },
    "days": {
      "type": "array",
      "description": "One row per UTC day intersecting the range, in day order, zeros included.",
      "items": {
        "type": "object",
        "required": [
          "day",
          "registered",
          "classified",
          "dimensions_declared",
          "measured",
          "open_discrepancies"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "description": "The UTC calendar day."
          },
          "registered": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Products registered in the day's window."
          },
          "classified": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Products whose first classification fell in the window."
          },
          "dimensions_declared": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Products whose first declared dimensions fell in the window."
          },
          "measured": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Products whose first measurement fell in the window."
          },
          "open_discrepancies": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Products whose latest physical profile at the window's end has a declared-vs-measured discrepancy."
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "The current state of every product the projection knows (not range-bound).",
      "required": [
        "products",
        "classified",
        "dimensions_declared",
        "measured",
        "open_discrepancies",
        "classified_ratio",
        "dimensions_declared_ratio",
        "measured_ratio",
        "discrepancy_ratio"
      ],
      "properties": {
        "products": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "Distinct SKUs seen in any product event."
        },
        "classified": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "dimensions_declared": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "Products whose current physical profile has declared dimensions."
        },
        "measured": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "description": "Products whose current physical profile has a measurement."
        },
        "open_discrepancies": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "classified_ratio": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1,
          "description": "classified / products (0 when there are none)."
        },
        "dimensions_declared_ratio": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1,
          "description": "dimensions_declared / products."
        },
        "measured_ratio": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1,
          "description": "measured / products."
        },
        "discrepancy_ratio": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1,
          "description": "open_discrepancies / measured."
        }
      }
    }
  },
  "isSchema": true
}