{
  "type": "object",
  "required": [
    "effectiveSource",
    "discrepancy"
  ],
  "properties": {
    "declared": {
      "type": "object",
      "required": [
        "lengthMm",
        "widthMm",
        "heightMm",
        "weightG",
        "volumeMm3"
      ],
      "properties": {
        "lengthMm": {
          "type": "integer",
          "format": "int64"
        },
        "widthMm": {
          "type": "integer",
          "format": "int64"
        },
        "heightMm": {
          "type": "integer",
          "format": "int64"
        },
        "weightG": {
          "type": "integer",
          "format": "int64"
        },
        "volumeMm3": {
          "type": "integer",
          "format": "int64",
          "description": "length x width x height."
        }
      }
    },
    "measured": {
      "allOf": [
        "[Circular]",
        {
          "type": "object",
          "required": [
            "measuredAt"
          ],
          "properties": {
            "measuredAt": {
              "type": "string",
              "format": "date-time"
            },
            "deviceId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "effective": "[Circular]",
    "effectiveSource": {
      "type": "string",
      "description": "Which part of the physical profile the effective values come from.",
      "enum": [
        "measured",
        "declared",
        "none"
      ]
    },
    "discrepancy": {
      "type": "boolean",
      "description": "True when declared and measured both exist and volume or weight differ by more than 10 % of the declared value."
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "description": "The product version after this read or change (present on write responses)."
    }
  },
  "isSchema": true
}