{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sku",
          "description",
          "version",
          "physicalProfile"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "example": "SKU-1"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Starts at 1, +1 per accepted change."
          },
          "classification": {
            "type": "object",
            "required": [
              "handlingTags",
              "classificationSource"
            ],
            "properties": {
              "handlingTags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Closed set of handling tags.",
                  "enum": [
                    "Hazmat",
                    "Fragile",
                    "TemperatureSensitive",
                    "Oversized",
                    "HighValue"
                  ]
                }
              },
              "temperatureClass": {
                "type": "string",
                "description": "Storage temperature band required by a TemperatureSensitive product.",
                "enum": [
                  "Ambient",
                  "Chilled",
                  "Frozen"
                ]
              },
              "dotHazardClass": {
                "type": "integer",
                "format": "int32",
                "minimum": 1,
                "maximum": 9,
                "nullable": true
              },
              "classificationSource": {
                "type": "string",
                "description": "`native` = authored in product-master; `legacy-import` = imported from inventory-storage during the migration (ADR 0003).",
                "enum": [
                  "native",
                  "legacy-import"
                ]
              }
            }
          },
          "physicalProfile": {
            "type": "object",
            "required": [
              "effectiveSource",
              "discrepancy"
            ],
            "properties": {
              "declared": {
                "type": "object",
                "required": [
                  "lengthMm",
                  "widthMm",
                  "heightMm",
                  "weightG",
                  "volumeMm3"
                ],
                "properties": {
                  "lengthMm": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "widthMm": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "heightMm": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "weightG": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "volumeMm3": {
                    "type": "integer",
                    "format": "int64",
                    "description": "length x width x height."
                  }
                }
              },
              "measured": {
                "allOf": [
                  "[Circular]",
                  {
                    "type": "object",
                    "required": [
                      "measuredAt"
                    ],
                    "properties": {
                      "measuredAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "deviceId": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "effective": "[Circular]",
              "effectiveSource": {
                "type": "string",
                "description": "Which part of the physical profile the effective values come from.",
                "enum": [
                  "measured",
                  "declared",
                  "none"
                ]
              },
              "discrepancy": {
                "type": "boolean",
                "description": "True when declared and measured both exist and volume or weight differ by more than 10 % of the declared value."
              },
              "version": {
                "type": "integer",
                "format": "int64",
                "description": "The product version after this read or change (present on write responses)."
              }
            }
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "description": "Opaque cursor for the next page; absent on the last page."
    }
  },
  "isSchema": true
}