{
  "type": "object",
  "required": [
    "gtin",
    "sku",
    "level",
    "unitsPerPack",
    "active",
    "effectiveFrom"
  ],
  "properties": {
    "gtin": {
      "type": "string",
      "pattern": "^[0-9]{14}$",
      "description": "A GTIN, always the 14-digit zero-left-padded string with a valid mod-10 check digit.",
      "example": "24006381333935"
    },
    "sku": {
      "type": "string",
      "example": "SKU-1"
    },
    "level": {
      "type": "string",
      "description": "A packaging level, lowest first. Receiving and picking flows of consumers implement EACH and CASE in v1.",
      "enum": [
        "EACH",
        "INNER",
        "CASE",
        "PALLET"
      ]
    },
    "unitsPerPack": {
      "type": "integer",
      "format": "int32",
      "description": "Eaches in one pack of this level."
    },
    "childGtin": "[Circular]",
    "active": {
      "type": "boolean"
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time"
    },
    "effectiveTo": {
      "type": "string",
      "format": "date-time"
    }
  },
  "isSchema": true
}