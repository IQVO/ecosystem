{
  "allOf": [
    {
      "type": "object",
      "required": [
        "sku",
        "version"
      ],
      "properties": {
        "sku": {
          "type": "string",
          "example": "SKU-1"
        },
        "version": {
          "type": "integer",
          "format": "int64",
          "description": "The product version after this call."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "level",
        "gtin",
        "unitsPerPack",
        "isOrderable",
        "isDespatchUnit",
        "active",
        "effectiveFrom"
      ],
      "properties": {
        "level": {
          "type": "string",
          "description": "A packaging level, lowest first. Receiving and picking flows of consumers implement EACH and CASE in v1.",
          "enum": [
            "EACH",
            "INNER",
            "CASE",
            "PALLET"
          ]
        },
        "gtin": {
          "type": "string",
          "pattern": "^[0-9]{14}$",
          "description": "A GTIN, always the 14-digit zero-left-padded string with a valid mod-10 check digit.",
          "example": "24006381333935"
        },
        "childGtin": "[Circular]",
        "qtyOfChild": {
          "type": "integer",
          "format": "int32",
          "description": "Absent for EACH."
        },
        "unitsPerPack": {
          "type": "integer",
          "format": "int32",
          "description": "The direct factor to eaches (1 for EACH)."
        },
        "dims": {
          "type": "object",
          "required": [
            "lengthMm",
            "widthMm",
            "heightMm",
            "weightG",
            "volumeMm3"
          ],
          "properties": {
            "lengthMm": {
              "type": "integer",
              "format": "int64"
            },
            "widthMm": {
              "type": "integer",
              "format": "int64"
            },
            "heightMm": {
              "type": "integer",
              "format": "int64"
            },
            "weightG": {
              "type": "integer",
              "format": "int64"
            },
            "volumeMm3": {
              "type": "integer",
              "format": "int64",
              "description": "length x width x height."
            }
          }
        },
        "measured": {
          "allOf": [
            "[Circular]",
            {
              "type": "object",
              "required": [
                "measuredAt"
              ],
              "properties": {
                "measuredAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "deviceId": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "isOrderable": {
          "type": "boolean"
        },
        "isDespatchUnit": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean",
          "description": "False once the level is end-dated."
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date-time"
        },
        "effectiveTo": {
          "type": "string",
          "format": "date-time",
          "description": "Present once the level is end-dated."
        }
      }
    }
  ],
  "isSchema": true
}