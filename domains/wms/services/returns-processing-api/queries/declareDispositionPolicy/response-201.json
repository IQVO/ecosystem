{
  "type": "object",
  "required": [
    "version",
    "returnWindowDays",
    "maxUnitsPerLine",
    "rules",
    "declaredAt"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "format": "int64",
      "minimum": 1,
      "description": "Starts at 1, +1 per declared version; versions are append-only."
    },
    "returnWindowDays": {
      "type": "integer",
      "format": "int32",
      "minimum": 0
    },
    "maxUnitsPerLine": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    },
    "vetoOutcome": {
      "type": "string",
      "description": "The disposition outcome. Only RESTOCK has a downstream effect\n(`ReturnLineStaged`); the others are recorded for audit.\n",
      "enum": [
        "RESTOCK",
        "REFURBISH",
        "LIQUIDATE",
        "DISPOSE",
        "RTV"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grade",
          "productClass",
          "outcome"
        ],
        "properties": {
          "grade": {
            "type": "string",
            "description": "The inspection grade of a return line.",
            "enum": [
              "A",
              "B",
              "C",
              "SCRAP"
            ]
          },
          "productClass": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "The product classification this rule keys on, or \"*\" for the per-grade default."
          },
          "outcome": "[Circular]"
        }
      }
    },
    "declaredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "isSchema": true
}