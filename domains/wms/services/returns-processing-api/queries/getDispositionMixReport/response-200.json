{
  "type": "object",
  "required": [
    "from",
    "to",
    "rows"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "type": "string",
      "format": "date-time"
    },
    "site_id": {
      "type": "string",
      "description": "Present when the report was filtered to one site."
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "policy_version",
          "outcome",
          "lines",
          "units"
        ],
        "properties": {
          "policy_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "outcome": {
            "type": "string",
            "description": "The disposition outcome. Only RESTOCK has a downstream effect\n(`ReturnLineStaged`); the others are recorded for audit.\n",
            "enum": [
              "RESTOCK",
              "REFURBISH",
              "LIQUIDATE",
              "DISPOSE",
              "RTV"
            ]
          },
          "lines": {
            "type": "integer"
          },
          "units": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  },
  "isSchema": true
}