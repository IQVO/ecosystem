{
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rmaId",
          "orderId",
          "lineNo",
          "sku",
          "quantity",
          "siteId",
          "status",
          "version"
        ],
        "properties": {
          "rmaId": {
            "type": "string",
            "example": "rma-4d5e6f7a-8b9c-4d0e-a1f2-3b4c5d6e7f80"
          },
          "orderId": {
            "type": "string"
          },
          "lineNo": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "siteId": {
            "type": "string"
          },
          "reasonCode": {
            "type": "string",
            "description": "The return reason of an AUTHORIZED RMA."
          },
          "rejectionCode": {
            "type": "string",
            "description": "Why a REQUESTED RMA was rejected: LINE_NOT_MANIFESTED, RETURN_WINDOW_EXPIRED, OPEN_RMA_EXISTS or QUANTITY_EXCEEDS_POLICY."
          },
          "status": {
            "type": "string",
            "description": "Lifecycle state of an RMA. `REJECTED` and `CLOSED` are terminal:\nnothing leaves them.\n",
            "enum": [
              "REQUESTED",
              "AUTHORIZED",
              "REJECTED",
              "RECEIVED",
              "CLOSED"
            ]
          },
          "windowEndsAt": {
            "type": "string",
            "format": "date-time",
            "description": "The last instant goods may arrive; present once AUTHORIZED."
          },
          "authorizedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rejectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the first receipt moved the RMA to RECEIVED."
          },
          "closedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Starts at 1, +1 per accepted transition; guards every write (409 on a lost update)."
          }
        }
      }
    }
  },
  "isSchema": true
}