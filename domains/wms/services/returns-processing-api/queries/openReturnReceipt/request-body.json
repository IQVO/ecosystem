{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "siteId",
    "lines"
  ],
  "properties": {
    "siteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S",
      "description": "The site the parcel arrived at."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "description": "Every line of the parcel; each is MATCHED or UNEXPECTED, never anything else.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineNo",
          "sku",
          "quantity",
          "kind"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "quantity": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "description": "How a received line relates to an RMA. `MATCHED` lines carry the rmaId\nthey match; `UNEXPECTED` lines have none and raise\n`UnexpectedReturnReceived`. There is no third state.\n",
            "enum": [
              "MATCHED",
              "UNEXPECTED"
            ]
          },
          "rmaId": {
            "type": "string",
            "description": "Required when kind is MATCHED; must be absent (or null) when kind is UNEXPECTED."
          }
        }
      }
    }
  }
}