{
  "type": "object",
  "required": [
    "receiptId",
    "siteId",
    "openedAt",
    "lines",
    "version"
  ],
  "properties": {
    "receiptId": {
      "type": "string",
      "example": "rcpt-8a9b0c1d-2e3f-4a5b-8c6d-7e8f9a0b1c2d"
    },
    "rmaId": {
      "type": "string",
      "nullable": true,
      "description": "The RMA the parcel was opened against; null when the whole parcel was unexpected."
    },
    "siteId": {
      "type": "string"
    },
    "openedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lineNo",
          "sku",
          "quantity",
          "kind",
          "inspected"
        ],
        "properties": {
          "lineNo": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "The received quantity."
          },
          "kind": {
            "type": "string",
            "description": "How a received line relates to an RMA. `MATCHED` lines carry the rmaId\nthey match; `UNEXPECTED` lines have none and raise\n`UnexpectedReturnReceived`. There is no third state.\n",
            "enum": [
              "MATCHED",
              "UNEXPECTED"
            ]
          },
          "rmaId": {
            "type": "string",
            "description": "The RMA this line matched; absent on an UNEXPECTED line."
          },
          "inspected": {
            "type": "boolean",
            "description": "Whether the line already has a grade."
          },
          "inspectedQuantity": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Present once inspected; never above quantity."
          },
          "grade": {
            "type": "string",
            "description": "The inspection grade of a return line.",
            "enum": [
              "A",
              "B",
              "C",
              "SCRAP"
            ]
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Why the grade; present once inspected."
          },
          "inspectedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    }
  },
  "isSchema": true
}