{
  "type": "object",
  "required": [
    "from",
    "to",
    "granularity",
    "days"
  ],
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range start (inclusive)."
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "description": "The effective range end (exclusive)."
    },
    "site_id": {
      "type": "string",
      "description": "The site scope; omitted when the report covers every site."
    },
    "granularity": {
      "type": "string",
      "enum": [
        "day"
      ]
    },
    "days": {
      "type": "array",
      "description": "One dense row per UTC calendar day intersecting the range, zeros included.",
      "items": {
        "type": "object",
        "required": [
          "day",
          "plans_generated",
          "plans_approved",
          "plans_rejected",
          "approval_latency",
          "supersessions"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "description": "The UTC calendar day."
          },
          "plans_generated": {
            "type": "integer",
            "minimum": 0,
            "description": "SlotPlanGenerated events that fell in the day's window."
          },
          "plans_approved": {
            "type": "integer",
            "minimum": 0,
            "description": "SlotPlanApproved events that fell in the day's window."
          },
          "plans_rejected": {
            "type": "integer",
            "minimum": 0,
            "description": "SlotPlanRejected events that fell in the day's window."
          },
          "approval_latency": {
            "type": "object",
            "description": "The generated-to-approved durations of one day's approved plans (linear-interpolated percentiles).",
            "required": [
              "count",
              "p50_seconds",
              "p95_seconds"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "p50_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "description": "Null when count is 0."
              },
              "p95_seconds": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "minimum": 0,
                "description": "Null when count is 0."
              }
            }
          },
          "supersessions": {
            "type": "integer",
            "minimum": 0,
            "description": "Plans a later approval superseded in the day's window."
          }
        }
      }
    }
  },
  "isSchema": true
}