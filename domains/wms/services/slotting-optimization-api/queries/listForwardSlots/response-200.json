{
  "type": "object",
  "required": [
    "siteId",
    "assignments"
  ],
  "properties": {
    "siteId": {
      "type": "string"
    },
    "planId": {
      "type": "string",
      "description": "The Approved plan the map comes from; absent when the site has none"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sku",
          "slot",
          "abcClass"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "abcClass": {
            "type": "string",
            "description": "Velocity class by cumulative pick share (A up to 80 %, B up to 95 %, else C).",
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "pickUnit": {
            "type": "string",
            "enum": [
              "EACH",
              "CASE"
            ],
            "description": "The unit the SKU is picked in from this face. CASE only for a SKU with an active CASE pack level and a case-pick zone face; absent or EACH otherwise."
          },
          "casesCapacity": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Whole cases the CASE-pick face holds; omitted for EACH."
          }
        }
      }
    }
  },
  "isSchema": true
}