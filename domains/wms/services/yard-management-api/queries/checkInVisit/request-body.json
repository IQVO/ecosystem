{
  "type": "object",
  "properties": {
    "siteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "carrier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "carrierScac": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$"
    },
    "tractorPlate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "driverRef": {
      "type": "string",
      "maxLength": 64,
      "description": "Opaque reference, never a name or licence number."
    },
    "purpose": {
      "type": "string",
      "enum": [
        "DROP",
        "LIVE_UNLOAD",
        "LIVE_LOAD",
        "PICKUP",
        "BOBTAIL"
      ]
    },
    "appointmentId": {
      "type": "string",
      "maxLength": 64
    },
    "trailers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unitNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "carrierScac": {
            "type": "string",
            "pattern": "^[A-Z]{2,4}$",
            "description": "Defaults to the visit's carrierScac."
          },
          "kind": {
            "type": "string",
            "enum": [
              "DRY_VAN",
              "REEFER",
              "FLATBED",
              "CONTAINER"
            ]
          },
          "loadState": {
            "type": "string",
            "enum": [
              "EMPTY",
              "LOADED",
              "PARTIAL"
            ]
          },
          "sealNumber": {
            "type": "string",
            "maxLength": 64,
            "description": "The seal found at the gate; compared with the appointment's expected seal."
          }
        },
        "required": [
          "unitNumber",
          "kind",
          "loadState"
        ]
      },
      "description": "Trailers brought in. BOBTAIL and PICKUP bring none; a visit that names an appointment brings exactly one."
    }
  },
  "required": [
    "siteId",
    "carrier",
    "tractorPlate",
    "purpose"
  ]
}