{
  "type": "object",
  "properties": {
    "visit": {
      "type": "object",
      "properties": {
        "visitId": {
          "type": "string"
        },
        "siteId": {
          "type": "string"
        },
        "carrier": {
          "type": "string"
        },
        "carrierScac": {
          "type": "string",
          "nullable": true
        },
        "tractorPlate": {
          "type": "string"
        },
        "driverRef": {
          "type": "string",
          "nullable": true
        },
        "purpose": {
          "type": "string",
          "enum": [
            "DROP",
            "LIVE_UNLOAD",
            "LIVE_LOAD",
            "PICKUP",
            "BOBTAIL"
          ]
        },
        "appointmentId": {
          "type": "string",
          "nullable": true
        },
        "state": {
          "type": "string",
          "enum": [
            "CHECKED_IN",
            "CHECKED_OUT",
            "REJECTED"
          ]
        },
        "rejectionReason": {
          "type": "string",
          "enum": [
            "APPOINTMENT_REQUIRED",
            "UNKNOWN_APPOINTMENT",
            "SEAL_MISMATCH",
            "TRAILER_ALREADY_ON_SITE",
            "SITE_REQUEST",
            null
          ],
          "nullable": true
        },
        "trailersIn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trailersOut": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "arrivedAt": {
          "type": "string",
          "format": "date-time"
        },
        "departedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "visitId",
        "siteId",
        "carrier",
        "tractorPlate",
        "purpose",
        "state",
        "trailersIn",
        "trailersOut",
        "arrivedAt",
        "version"
      ]
    },
    "trailers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trailerId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "unitNumber": {
            "type": "string"
          },
          "carrierScac": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "DRY_VAN",
              "REEFER",
              "FLATBED",
              "CONTAINER"
            ]
          },
          "loadState": {
            "type": "string",
            "enum": [
              "EMPTY",
              "LOADED",
              "PARTIAL"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "PARKED",
              "IN_MOVE",
              "DOCKED",
              "DEPARTED"
            ]
          },
          "location": {
            "type": "object",
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "SPOT",
                      "DOOR"
                    ]
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "description": "A facility-layout locationCode."
                  }
                },
                "required": [
                  "kind",
                  "code"
                ]
              }
            ],
            "nullable": true
          },
          "doorWork": {
            "type": "string",
            "enum": [
              "WAITING",
              "IN_PROGRESS",
              "DONE",
              null
            ],
            "nullable": true
          },
          "seal": {
            "type": "object",
            "properties": {
              "number": {
                "type": "string",
                "nullable": true
              },
              "state": {
                "type": "string",
                "enum": [
                  "NONE",
                  "INTACT",
                  "BROKEN"
                ]
              }
            },
            "required": [
              "number",
              "state"
            ]
          },
          "hold": {
            "type": "string",
            "enum": [
              "DAMAGED",
              "SEAL_BROKEN",
              "NOT_FOUND",
              "QUALITY",
              "SECURITY",
              null
            ],
            "nullable": true
          },
          "asnNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outboundRef": {
            "type": "string",
            "nullable": true
          },
          "visitId": {
            "type": "string",
            "nullable": true
          },
          "appointmentId": {
            "type": "string",
            "nullable": true
          },
          "arrivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "departedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "openMoveId": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "trailerId",
          "siteId",
          "unitNumber",
          "kind",
          "loadState",
          "state",
          "seal",
          "asnNumbers",
          "arrivedAt",
          "version"
        ]
      }
    },
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "moveId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "trailerId": {
            "type": "string"
          },
          "appointmentId": {
            "type": "string",
            "nullable": true
          },
          "performer": {
            "type": "string",
            "enum": [
              "HOSTLER",
              "VISITING_DRIVER"
            ]
          },
          "from": {
            "type": "object",
            "allOf": [
              "[Circular]"
            ],
            "nullable": true
          },
          "to": "[Circular]",
          "reason": {
            "type": "string",
            "enum": [
              "TO_DOOR",
              "FROM_DOOR",
              "TO_SPOT",
              "RELOCATE",
              "TO_HOLDING"
            ]
          },
          "priority": {
            "type": "object",
            "properties": {
              "band": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9,
                "description": "1 is the most urgent."
              },
              "dueBy": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            },
            "required": [
              "band"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "CLAIMED",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "hostlerRef": {
            "type": "string",
            "nullable": true
          },
          "leaseExpiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "actualLocation": {
            "type": "object",
            "allOf": [
              "[Circular]"
            ],
            "nullable": true
          },
          "claimedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "moveId",
          "siteId",
          "trailerId",
          "performer",
          "to",
          "reason",
          "priority",
          "state",
          "requestedAt",
          "version"
        ]
      }
