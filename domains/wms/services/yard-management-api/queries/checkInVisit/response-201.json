  },
  "required": [
    "visit",
    "trailers",
    "moves"
  ],
  "description": "The visit, the trailers it brought and the moves DirectOnCheckIn created (one per trailer, created CLAIMED by the VISITING_DRIVER). A seal mismatch under the REJECT policy answers 201 with a REJECTED visit, no trailers and no moves.",
  "isSchema": true
}