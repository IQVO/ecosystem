{
  "type": "object",
  "properties": {
    "hostlerRef": {
      "type": "string",
      "description": "The lease holder; omitted when a gate clerk or dock operator completes a VISITING_DRIVER move."
    },
    "actualLocation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "SPOT",
            "DOOR"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "A facility-layout locationCode."
        }
      },
      "required": [
        "kind",
        "code"
      ]
    },
    "deviationNote": {
      "type": "string",
      "description": "Required when actualLocation is not the destination."
    }
  }
}