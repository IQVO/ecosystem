{
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "type": "string",
      "format": "date-time"
    },
    "siteId": {
      "type": "string",
      "nullable": true
    },
    "thresholdMinutes": {
      "type": "integer",
      "description": "The threshold the report was computed with (the request's, or 120)."
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "DRY_VAN",
              "REEFER",
              "FLATBED",
              "CONTAINER"
            ]
          },
          "trailers": {
            "type": "integer",
            "description": "Trailers of this kind that departed in the window."
          },
          "exceeding": {
            "type": "integer",
            "description": "Of those, the ones whose dwell exceeded thresholdMinutes."
          },
          "share": {
            "type": "number",
            "nullable": true,
            "description": "exceeding / trailers, 0..1; null when there were no trailers."
          },
          "excessMinutes": {
            "type": "integer",
            "description": "Sum of (dwell - thresholdMinutes) over the exceeding trailers. Exposure, not a billed amount."
          }
        },
        "required": [
          "kind",
          "trailers",
          "exceeding",
          "share",
          "excessMinutes"
        ]
      }
    }
  },
  "required": [
    "from",
    "to",
    "siteId",
    "thresholdMinutes",
    "rows"
  ],
  "isSchema": true
}