{
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "type": "string",
      "format": "date-time"
    },
    "siteId": {
      "type": "string",
      "nullable": true
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string"
          },
          "visitsCheckedIn": {
            "type": "integer"
          },
          "visitsRejected": {
            "type": "integer"
          },
          "rejectionRate": {
            "type": "number",
            "nullable": true,
            "description": "visitsRejected / (visitsCheckedIn + visitsRejected), 0..1; null when both are zero."
          },
          "sealExceptions": {
            "type": "integer"
          },
          "sealExceptionRate": {
            "type": "number",
            "nullable": true,
            "description": "sealExceptions per check-in; null when no visit checked in. Not capped at 1."
          },
          "holdsByReason": {
            "type": "object",
            "description": "Holds placed in the window; every reason is listed, zero included.",
            "properties": {
              "DAMAGED": {
                "type": "integer"
              },
              "SEAL_BROKEN": {
                "type": "integer"
              },
              "NOT_FOUND": {
                "type": "integer"
              },
              "QUALITY": {
                "type": "integer"
              },
              "SECURITY": {
                "type": "integer"
              }
            },
            "required": [
              "DAMAGED",
              "SEAL_BROKEN",
              "NOT_FOUND",
              "QUALITY",
              "SECURITY"
            ]
          },
          "yardChecksClosed": {
            "type": "integer"
          },
          "discrepancies": {
            "type": "integer",
            "description": "Total discrepancies (the length of YardCheckClosed.discrepancies) over the yard checks closed."
          }
        },
        "required": [
          "siteId",
          "visitsCheckedIn",
          "visitsRejected",
          "rejectionRate",
          "sealExceptions",
          "sealExceptionRate",
          "holdsByReason",
          "yardChecksClosed",
          "discrepancies"
        ]
      }
    }
  },
  "required": [
    "from",
    "to",
    "siteId",
    "rows"
  ],
  "isSchema": true
}