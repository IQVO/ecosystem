{
  "type": "object",
  "properties": {
    "siteId": {
      "type": "string"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "spots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "SPOT",
              "DOOR"
            ]
          },
          "dockFlow": {
            "type": "string",
            "enum": [
              "Inbound",
              "Outbound",
              "Both",
              null
            ],
            "nullable": true
          },
          "closed": {
            "type": "boolean"
          },
          "trailer": {
            "type": "object",
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "trailerId": {
                    "type": "string"
                  },
                  "siteId": {
                    "type": "string"
                  },
                  "unitNumber": {
                    "type": "string"
                  },
                  "unitNumberScheme": {
                    "type": "string",
                    "enum": [
                      "ISO6346",
                      null
                    ],
                    "nullable": true,
                    "description": "ISO6346 when the unit number was validated as an ISO 6346 container number; null for a free-form number (and for a trailer stored before ADR 0012)."
                  },
                  "carrierScac": {
                    "type": "string",
                    "nullable": true
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "DRY_VAN",
                      "REEFER",
                      "FLATBED",
                      "CONTAINER"
                    ]
                  },
                  "loadState": {
                    "type": "string",
                    "enum": [
                      "EMPTY",
                      "LOADED",
                      "PARTIAL"
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "PARKED",
                      "IN_MOVE",
                      "DOCKED",
                      "DEPARTED"
                    ]
                  },
                  "location": {
                    "type": "object",
                    "allOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "SPOT",
                              "DOOR"
                            ]
                          },
                          "code": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "description": "A facility-layout locationCode."
                          }
                        },
                        "required": [
                          "kind",
                          "code"
                        ]
                      }
                    ],
                    "nullable": true
                  },
                  "doorWork": {
                    "type": "string",
                    "enum": [
                      "WAITING",
                      "IN_PROGRESS",
                      "DONE",
                      null
                    ],
                    "nullable": true
                  },
                  "securedAt": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true,
                    "description": "When the DOCKED trailer was secured (ADR 0013); null while it is not secured, and for every trailer stored before the interlock."
                  },
                  "securedBy": {
                    "type": "string",
                    "enum": [
                      "RESTRAINT",
                      "WHEEL_CHOCKS",
                      null
                    ],
                    "nullable": true,
                    "description": "How the trailer is secured, a vehicle restraint engaged or the wheels chocked (OSHA 29 CFR 1910.178(k)(1), ANSI MH30.3); null while it is not secured."
                  },
                  "securerRef": {
                    "type": "string",
                    "nullable": true,
                    "description": "The optional reference of the person who secured the trailer."
                  },
                  "hazmatClass": {
                    "type": "string",
                    "enum": [
                      "1",
                      "1.1",
                      "1.2",
                      "1.3",
                      "1.4",
                      "1.5",
                      "1.6",
                      "2",
                      "2.1",
                      "2.2",
                      "2.3",
                      "3",
                      "4",
                      "4.1",
                      "4.2",
                      "4.3",
                      "5",
                      "5.1",
                      "5.2",
                      "6",
                      "6.1",
                      "6.2",
                      "7",
                      "8",
                      "9",
                      null
                    ],
                    "nullable": true,
                    "description": "The US DOT hazard class or division the trailer carries (ADR 0014); null when none was declared, and for every trailer stored before it."
                  },
                  "unNumber": {
                    "type": "string",
                    "nullable": true,
                    "pattern": "^UN[0-9]{4}$",
                    "description": "The UN number of the material; null when none was declared."
                  },
                  "requiresTemperatureControl": {
                    "type": "boolean",
                    "description": "True for a load that needs a refrigeration plug; false when not declared."
                  },
                  "seal": {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "string",
                        "nullable": true
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "NONE",
                          "INTACT",
                          "BROKEN",
                          "APPLIED",
                          "VERIFIED",
                          "MISMATCH"
                        ],
                        "description": "INTACT: present and unbroken, not yet verified (what existing flows produce). APPLIED: recorded as applied at the origin or dock. VERIFIED: checked at the gate against the expected number and equal. MISMATCH: checked and different (SealExceptionRaised was raised). BROKEN: found broken. NONE: no seal."
                      },
                      "class": {
                        "type": "string",
                        "enum": [
                          "I",
                          "S",
                          "H",
                          null
                        ],
                        "nullable": true,
                        "description": "The ISO 17712 class of the seal; null when none was declared."
                      }
                    },
                    "required": [
                      "number",
                      "state"
                    ]
                  },
                  "hold": {
                    "type": "string",
                    "enum": [
                      "DAMAGED",
                      "SEAL_BROKEN",
                      "NOT_FOUND",
                      "QUALITY",
                      "SECURITY",
                      null
                    ],
                    "nullable": true
                  },
                  "asnNumbers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "outboundRef": {
                    "type": "string",
                    "nullable": true
                  },
                  "visitId": {
                    "type": "string",
                    "nullable": true
                  },
                  "appointmentId": {
                    "type": "string",
                    "nullable": true
                  },
                  "arrivedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "departedAt": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "openMoveId": {
                    "type": "string",
                    "nullable": true
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "trailerId",
                  "siteId",
                  "unitNumber",
                  "kind",
                  "loadState",
                  "state",
                  "seal",
                  "asnNumbers",
                  "arrivedAt",
                  "version"
                ]
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "code",
          "kind",
          "closed"
        ]
      }
    },
    "doors": {
      "type": "array",
      "items": "[Circular]"
    },
    "inMove": {
      "type": "array",
      "items": "[Circular]"
    },
    "openMoves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "moveId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "trailerId": {
            "type": "string"
          },
          "appointmentId": {
            "type": "string",
            "nullable": true
          },
          "performer": {
            "type": "string",
            "enum": [
              "HOSTLER",
              "VISITING_DRIVER"
            ]
          },
          "from": {
            "type": "object",
            "allOf": [
              "[Circular]"
            ],
            "nullable": true
          },
          "to": "[Circular]",
          "reason": {
            "type": "string",
            "enum": [
              "TO_DOOR",
              "FROM_DOOR",
              "TO_SPOT",
              "RELOCATE",
              "TO_HOLDING"
            ]
          },
          "priority": {
            "type": "object",
            "properties": {
              "band": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9,
                "description": "1 is the most urgent."
              },
              "dueBy": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            },
            "required": [
              "band"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "CLAIMED",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "hostlerRef": {
            "type": "string",
            "nullable": true
          },
          "leaseExpiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "actualLocation": {
            "type": "object",
            "allOf": [
              "[Circular]"
            ],
            "nullable": true
          },
          "claimedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "moveId",
          "siteId",
          "trailerId",
          "performer",
          "to",
          "reason",
          "priority",
          "state",
          "requestedAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "siteId",
    "asOf",
    "spots",
    "doors",
    "inMove",
    "openMoves"
  ],
  "isSchema": true
}