{
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "latestVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "The highest published version of the same template id."
          },
          "title": {
            "type": "string"
          },
          "builtIn": {
            "type": "boolean",
            "description": "A built-in template ships with the service, is read-only, and has no `publishedAt`."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "itemCode": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "text": {
                  "type": "string",
                  "maxLength": 300
                },
                "required": {
                  "type": "boolean"
                },
                "allowNotApplicable": {
                  "type": "boolean",
                  "description": "Whether NOT_APPLICABLE may be recorded on the item. Left out = false."
                },
                "holdReason": {
                  "type": "string",
                  "enum": [
                    "DAMAGED",
                    "SEAL_BROKEN",
                    "NOT_FOUND",
                    "QUALITY",
                    "SECURITY"
                  ],
                  "description": "The hold a failed REQUIRED item places; left out when publishing = QUALITY."
                }
              },
              "required": [
                "itemCode",
                "text",
                "required"
              ]
            }
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "templateId",
          "version",
          "latestVersion",
          "title",
          "builtIn",
          "items",
          "publishedAt"
        ]
      }
    },
    "nextCursor": {
      "type": "string",
      "nullable": true,
      "description": "Absent on the last page."
    }
  },
  "required": [
    "items"
  ],
  "isSchema": true
}