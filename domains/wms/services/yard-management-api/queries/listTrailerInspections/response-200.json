{
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "inspectionId": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "trailerId": {
            "type": "string"
          },
          "visitId": {
            "type": "string",
            "nullable": true
          },
          "templateId": {
            "type": "string"
          },
          "templateVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "The version the inspection was opened from; the items below are that version's snapshot."
          },
          "gate": {
            "type": "string",
            "enum": [
              "PRE_DOCK",
              "PRE_LOAD",
              "PRE_DEPARTURE",
              "ON_DEMAND"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "PASSED",
              "FAILED"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "itemCode": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "allowNotApplicable": {
                  "type": "boolean"
                },
                "holdReason": {
                  "type": "string",
                  "enum": [
                    "DAMAGED",
                    "SEAL_BROKEN",
                    "NOT_FOUND",
                    "QUALITY",
                    "SECURITY"
                  ]
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_APPLICABLE",
                    null
                  ],
                  "nullable": true,
                  "description": "null while the item is pending."
                },
                "note": {
                  "type": "string",
                  "nullable": true
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "itemCode",
                "text",
                "required",
                "allowNotApplicable",
                "holdReason",
                "result",
                "note",
                "evidenceRefs"
              ]
            }
          },
          "performerRef": {
            "type": "string",
            "nullable": true
          },
          "conditionGrade": {
            "type": "string",
            "enum": [
              "CLEAN",
              "DIRTY",
              "ODOUR",
              "DAMAGED",
              null
            ],
            "nullable": true
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "inspectionId",
          "siteId",
          "trailerId",
          "visitId",
          "templateId",
          "templateVersion",
          "gate",
          "status",
          "items",
          "performerRef",
          "conditionGrade",
          "openedAt",
          "completedAt",
          "version"
        ]
      }
    },
    "nextCursor": {
      "type": "string",
      "nullable": true,
      "description": "Absent on the last page."
    }
  },
  "required": [
    "items"
  ],
  "isSchema": true
}