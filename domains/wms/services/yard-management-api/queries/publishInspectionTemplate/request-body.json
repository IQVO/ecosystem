{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "itemCode": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "text": {
            "type": "string",
            "maxLength": 300
          },
          "required": {
            "type": "boolean"
          },
          "allowNotApplicable": {
            "type": "boolean",
            "description": "Whether NOT_APPLICABLE may be recorded on the item. Left out = false."
          },
          "holdReason": {
            "type": "string",
            "enum": [
              "DAMAGED",
              "SEAL_BROKEN",
              "NOT_FOUND",
              "QUALITY",
              "SECURITY"
            ],
            "description": "The hold a failed REQUIRED item places; left out when publishing = QUALITY."
          }
        },
        "required": [
          "itemCode",
          "text",
          "required"
        ]
      }
    }
  },
  "required": [
    "title",
    "items"
  ]
}