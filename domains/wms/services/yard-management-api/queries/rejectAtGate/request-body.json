{
  "type": "object",
  "properties": {
    "siteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "carrier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "carrierScac": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$"
    },
    "tractorPlate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "appointmentId": {
      "type": "string",
      "maxLength": 64
    },
    "reason": {
      "type": "string",
      "enum": [
        "APPOINTMENT_REQUIRED",
        "UNKNOWN_APPOINTMENT",
        "SEAL_MISMATCH",
        "TRAILER_ALREADY_ON_SITE",
        "SITE_REQUEST"
      ]
    }
  },
  "required": [
    "siteId",
    "carrier",
    "tractorPlate",
    "reason"
  ]
}