{
  "type": "object",
  "properties": {
    "visitId": {
      "type": "string"
    },
    "siteId": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "carrierScac": {
      "type": "string",
      "nullable": true
    },
    "tractorPlate": {
      "type": "string"
    },
    "driverRef": {
      "type": "string",
      "nullable": true
    },
    "purpose": {
      "type": "string",
      "enum": [
        "DROP",
        "LIVE_UNLOAD",
        "LIVE_LOAD",
        "PICKUP",
        "BOBTAIL"
      ]
    },
    "appointmentId": {
      "type": "string",
      "nullable": true
    },
    "state": {
      "type": "string",
      "enum": [
        "CHECKED_IN",
        "CHECKED_OUT",
        "REJECTED"
      ]
    },
    "rejectionReason": {
      "type": "string",
      "enum": [
        "APPOINTMENT_REQUIRED",
        "UNKNOWN_APPOINTMENT",
        "SEAL_MISMATCH",
        "TRAILER_ALREADY_ON_SITE",
        "SITE_REQUEST",
        "CARRIER_SUSPENDED",
        null
      ],
      "nullable": true
    },
    "carrierFlag": {
      "type": "string",
      "enum": [
        "SUSPENDED",
        null
      ],
      "nullable": true,
      "description": "SUSPENDED when the gate admitted the visit of a suspended carrier because the yard policy action is FLAG (ADR 0016); null otherwise."
    },
    "trailersIn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trailersOut": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "arrivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "departedAt": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "visitId",
    "siteId",
    "carrier",
    "tractorPlate",
    "purpose",
    "state",
    "trailersIn",
    "trailersOut",
    "arrivedAt",
    "version"
  ],
  "isSchema": true
}