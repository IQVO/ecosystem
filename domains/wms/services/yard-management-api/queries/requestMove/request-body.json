{
  "type": "object",
  "properties": {
    "trailerId": {
      "type": "string"
    },
    "to": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "SPOT",
            "DOOR"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "A facility-layout locationCode."
        }
      },
      "required": [
        "kind",
        "code"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "TO_DOOR",
        "FROM_DOOR",
        "TO_SPOT",
        "RELOCATE",
        "TO_HOLDING"
      ]
    },
    "priorityBand": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9,
      "default": 5
    },
    "dueBy": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "trailerId",
    "to"
  ]
}